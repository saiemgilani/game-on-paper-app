---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Scripts from "../components/Scripts.astro";
import { breadcrumbListJsonLd, jsonLdScript } from "../utils/seo";
import "bootstrap-icons/font/bootstrap-icons.css";

export interface PageBreadcrumb { title: string, url?: string, active: boolean }

interface Props {
    title: string
    subtitle: string
    slug: string
    breadcrumbs: PageBreadcrumb[]
    /** meta description; defaults to subtitle. Pages that rank need a real one. */
    description?: string
    /** extra schema.org objects; BreadcrumbList is emitted automatically. */
    jsonLd?: (object | null)[]
}

const { title, subtitle, slug, breadcrumbs, description, jsonLd } = Astro.props;
const metaDescription = description || subtitle;
const structuredData = jsonLdScript([
    breadcrumbListJsonLd(breadcrumbs.map((b) => ({ title: b.title, url: b.url }))),
    ...(jsonLd ?? []),
]);

// Was `https://gameonpaper.com/cfb/${slug}`, but slug already carries its own
// leading slash, so every canonical and og:url rendered with a doubled slash
// under a /cfb/ prefix (".../cfb//charts/trends"). Both that and the served
// path resolve, so it was advertising a duplicate of every page as canonical.
// Derive it from the actual request path instead.
const canonicalUrl = new URL(Astro.url.pathname, "https://gameonpaper.com").href

function generateBreadcrumbHtml(b: PageBreadcrumb): string {
    let anchorContent = b.url ? `<a href="${b.url}">${b.title}</a>` : b.title;
    if (b.active) {
        anchorContent = b.title;
    }
    return `<li class="breadcrumb-item ${b.active ? 'active' : ''}" aria-current="page">${anchorContent}</li>`;
}

function generateBreadcrumbsListHtml(): string {
    if (breadcrumbs.length == 0) {
        return ""
    }

    const breadcrumbsComposite = breadcrumbs.map(generateBreadcrumbHtml).join("")
    return `
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
            ${breadcrumbsComposite}
            </ol>
        </nav>
    </div>
    `;
}


---
<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico">
        <link href="/assets/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
        <link href="/assets/css/base.css" rel="stylesheet">
        <link href="/assets/css/nav-header.css" rel="stylesheet">
        <link href="/assets/css/dark-game.css" rel="stylesheet">
        <meta http-equiv="content-type" content="text/html; charset=UTF-8">
        <meta http-equiv="x-ua-compatible" content="IE=edge,chrome=1">
        <meta name="viewport" content="initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <meta name="referrer" content="origin-when-cross-origin">
        <link rel="canonical" href={canonicalUrl}>
        <title>{title}</title>
        <meta name="description" content={metaDescription}>
        <meta property="og:site_name" content="GameOnPaper.com">
        <meta property="og:url" content={canonicalUrl}>
        <meta property="og:title" content={title}>
        <meta property="og:description" content={metaDescription}>
        <meta property="og:image" content="https://gameonpaper.com/assets/img/social-card.png">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:type" content="website">
        <meta name="twitter:site" content="@gameonpaper">
        <meta name="twitter:url" content={canonicalUrl}>
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={metaDescription}>
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:image" content="https://gameonpaper.com/assets/img/social-card.png">
        <meta name="title" content={title}>
        <meta name="medium" content="website">
        {structuredData && <script type="application/ld+json" set:html={structuredData} />}
        <script is:inline defer crossorigin="anonymous" data-domain="gameonpaper.com" src="https://plausible.io/js/script.js"></script>
    </head>
    <body>
        <Header />
        <Fragment set:html={generateBreadcrumbsListHtml()} />
        <slot />
        <Footer />
        <Scripts />
    </body>
</html>
