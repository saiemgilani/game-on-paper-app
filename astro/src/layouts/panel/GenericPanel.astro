---
interface Props {
    id: string
    title: string
    show: boolean
    /** extra classes for the panel wrapper, e.g. spacing utilities */
    class?: string
}

// `class` is a reserved word and cannot be a binding name, so it aliases to
// `className` -- the Astro convention. `class:list` drops it when undefined.
const { id, title, show, class: className } = Astro.props;
// a control beside the title (title left, control right, as the team profile's
// season picker); a panel without one renders exactly as before
const controls = Astro.slots.has('panel-controls');
---

<div class:list={["panel-group", className]} id={`${id}-panel`}>
    <div class="panel panel-default">
        <div class:list={["panel-heading", controls && "row"]}>
            <div class:list={["panel-title", controls && "col-lg-6 col-12"]}>
                <h2 class="d-inline">
                    {title}
                    <span class="d-inline text-small h6 ms-1">
                        <a class="toggle-link" data-bs-toggle="collapse"
                            href={`#${id}`}
                            style="text-decoration: none;"
                            role="button"
                            aria-expanded={show}>[show/hide]</a>
                    </span>
                </h2>
                <slot name="panel-subtitle" />
            </div>
            {controls && <div class="ms-auto col-lg-3 col-12"><slot name="panel-controls" /></div>}
        </div>
        <div id={id} class={`collapse ${show ? 'show' : 'hide'}`}>
            <div class="panel-body">
                <slot name="panel-body" />
            </div>
        </div>
    </div>
</div>
