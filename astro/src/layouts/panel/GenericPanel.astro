---
interface Props {
    id: string
    title: string
    show: boolean
}

const { id, title, show } = Astro.props;
---

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="panel-title">
                <h2 class="d-inline">
                    {title}
                    <span class="d-inline text-small h6 ms-1">
                        <a class="toggle-link" data-bs-toggle="collapse"
                            href={`#${id}`}
                            style="text-decoration: none;"
                            role="button"
                            aria-expanded={show}>[show/hide]</a>
                    </span>
                </h2>
                <slot name="panel-subtitle" />
            </div>
        </div>
        <div id={id} class={`collapse ${show ? 'show' : 'hide'}`}>
            <div class="panel-body">
                <slot name="panel-body" />
            </div>
        </div>
    </div>
</div>
