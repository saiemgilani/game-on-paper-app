---
/**
 * Wraps a player's name in a link to his page -- and ONLY when the viewer's
 * 'player-pages' flag admits him. A public link into a gated namespace is a
 * link to the site's 404, which is worse than no link, so the check lives here
 * rather than in each of the seven call sites.
 *
 * Call sites: the season leaderboard rows (`leaderboards/PlayerLeaderboardTable`),
 * every name in the game page's usage/tackles/special-teams box
 * (`game/metrics/UsageBoxScore`), and the advanced box score
 * (`game/metrics/PlayerBoxScore`), whose rows carry no id of their own and take
 * one from the usage sections of the same box. The CLASSIC game-page twin gets
 * no link: it has neither the usage box nor ids on its advanced box rows.
 *
 * `id` is normally an ESPN athlete id -- the id the pages, the game boxes and
 * the Data API all key on. The NFL season leaderboard rows carry an nflverse
 * gsis id instead, which the route resolves through the crosswalk and 301s to
 * the canonical ESPN-id URL, so that shape is linkable too. Anything else -- a
 * null, a name, a float-ish id -- renders the children unlinked rather than
 * minting a URL that would 404. `playerHref` owns that whole decision, flag
 * included, so a caller that needs to know whether a link exists (to lay a row
 * out around it) asks the same function this does.
 */
import { playerHref } from '../../utils/players';

interface Props {
    id?: string | number | null
    /** the season to open the page on; omitted opens the player's latest */
    season?: number | null
}
const { id, season } = Astro.props;
const href = playerHref(id, Astro.locals, season);
---
{href ? <a href={href}><slot /></a> : <slot />}
