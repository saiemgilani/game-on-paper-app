---
/**
 * The player's game log for one season: schedule context, the box stat line,
 * and the per-game EPA the Data API aggregates from the plays that carry him.
 *
 * Mirrors the game page's `metrics/PlayerBoxScore.astro`: a text stat line on
 * the left and one number per numeric cell after it (Plays, EPA/play, EPA, SR).
 * Rows link to the game page, which is the whole point of `game_id` riding on
 * every row.
 */
import { cleanField, roundNumber } from '../../utils/misc';
import { espnLogoLeague, leaguePath } from '../../utils/league';
import { espnGameId, gameStatLine, numberOrNull, type PlayerGameRow } from '../../utils/players';
import { badgeText, type LiveQaBadge } from '../../utils/liveQa';
import DarkModeLogos from '../DarkModeLogos.astro';

interface Props {
    games: PlayerGameRow[]
    /** nflverse game id -> ESPN event id; the NFL log keys on the former, every GOP game page on the latter */
    espnGameIds?: Record<string, string>
    /** ESPN event id -> the served source and QA verdict, for the games in progress RIGHT NOW */
    live?: Record<string, LiveQaBadge>
}
const { games, espnGameIds = {}, live = {} } = Astro.props;
const league = Astro.locals.league ?? 'cfb';
// the gate's rule list is admin detail, exactly as `AdminGameTools.astro` (#263)
// shows it: a public reader gets the verdict, not the report
const admin = Astro.locals.adminAuthed === true;

/** The link to a row's game page, or null when the schedule has no crosswalk for it. */
function gameHref(row: PlayerGameRow): string | null {
    const espn = espnGameId(row, espnGameIds);
    return espn ? leaguePath(league, `/game/${espn}`) : null;
}

/** The live badge for a row, or undefined -- a row whose payload we could not read renders unchanged. */
function liveOf(row: PlayerGameRow): LiveQaBadge | undefined {
    const espn = espnGameId(row, espnGameIds);
    return espn ? live[espn] : undefined;
}

const day = (d: unknown): string => (d ? String(d).slice(0, 10) : '—');
const num = (v: unknown, fixed: number): string => {
    const x = numberOrNull(v);
    return x === null ? '—' : roundNumber(x, 2, fixed);
};
const opponentIds = [...new Set(games.map((g: PlayerGameRow) => g.opponent_id).filter(Boolean))] as (string | number)[];
---
{games.length > 0 && (
<Fragment>
<DarkModeLogos teamIds={opponentIds} />
<div class="table-responsive" id="player-game-log">
    <table class="table table-sm">
        <thead>
            <tr>
                <th class="text-left" colspan="1">Date</th>
                <th class="text-center" colspan="1">Wk</th>
                <th class="text-left" colspan="1">Opponent</th>
                <th class="text-center" colspan="1">Result</th>
                <th class="text-left" colspan="1">Stat line</th>
                <th class="text-center" colspan="1">Plays</th>
                <th class="text-center" colspan="1" title="Expected Points Added per Play">EPA/play</th>
                <th class="text-center" colspan="1" title="Total Expected Points Added">EPA</th>
                <th class="text-center" colspan="1" title="Success Rate">SR</th>
            </tr>
        </thead>
        <tbody>
            {games.map((g: PlayerGameRow) => (
                <tr>
                    <td class="text-left text-nowrap numeral" colspan="1">
                        {gameHref(g) ? <a href={gameHref(g)}>{day(g.game_date)}</a> : day(g.game_date)}
                    </td>
                    <td class="text-center numeral" colspan="1">{g.week ?? '—'}</td>
                    <td class="text-left text-nowrap" colspan="1">
                        <span class="text-muted me-1">{g.home_away === 'away' ? 'at' : 'vs'}</span>
                        {g.opponent_id && (
                            <img class={`img-fluid team-logo-${g.opponent_id} me-2`} width="20px"
                                src={`https://a.espncdn.com/i/teamlogos/${espnLogoLeague(league)}/500/${g.opponent_id}.png`}
                                alt={`${g.opponent ?? g.opponent_id} logo`} title={String(g.opponent ?? '')} />
                        )}
                        <span>{cleanField(g, 'opponent')}</span>
                    </td>
                    <td class="text-center text-nowrap numeral" colspan="1">
                        {g.result ?? '—'} {g.team_score != null && g.opponent_score != null ? `${g.team_score}-${g.opponent_score}` : ''}{liveOf(g) && (<Fragment>
                            <span class="badge bg-danger ms-1">Live</span>
                            <span class="d-block text-small text-muted text-wrap" data-live-qa
                                  title={admin && liveOf(g)!.rules ? liveOf(g)!.rules : undefined}>{badgeText(liveOf(g)!)}</span>
                        </Fragment>)}
                    </td>
                    <td class="text-left" colspan="1">{gameStatLine(g.box, league)}</td>
                    <td class="text-center numeral" colspan="1">{num(g.plays, 0)}</td>
                    <td class="text-center numeral" colspan="1">{num(g.epa_per_play, 2)}</td>
                    <td class="text-center numeral" colspan="1">{num(g.epa, 2)}</td>
                    <td class="text-center numeral" colspan="1">{g.success_rate == null ? '—' : `${roundNumber(Number(g.success_rate) * 100, 2, 1)}%`}</td>
                </tr>
            ))}
        </tbody>
    </table>
</div>
</Fragment>
)}
