---
/**
 * The player's season line table: one table per category, with exactly the
 * columns and formatting the season leaderboards use
 * (`SDV_PLAYER_METRIC_CATEGORIES` / `..._FORMATTING_VALUES`), so a number reads
 * identically here and on `/year/N/players/<category>`. That is also where
 * `EPA/DB` comes from: a passer's `EPAplay` is per dropback, not per play.
 *
 * Rows are the producer's own season rows, so they carry `_rank` and `_pct`.
 * Both ride in the metric cell, the way `team/TeamCard.astro` shows a team's:
 * the cell is shaded by the percentile on the site's green -> purple ramp and
 * carries the rank as small faded text beside the number. A traded player has
 * one row per team-season; two or more rows of a category add a career roll-up
 * whose rates are recomputed from the summed counts, never averaged
 * (`utils/players.ts` rollUpSeasons).
 *
 * The Team cell carries BOTH spellings: the abbreviation on a phone
 * (`d-md-none`) and the full name from `md` up (`d-none d-md-inline`), because
 * a CFB school name is wide enough to push the metric columns off a phone and
 * an empty cell leaves the row unlabelled (review on #267).
 *
 * With no season selected the page is the player's CAREER, so every season row
 * is shown, oldest first, and each Season cell links to that year's page; a
 * selected season narrows the table to that year. Either way, every season whose
 * ranks the producer withheld -- the player did not clear the leaderboard
 * minimum -- is named in the table's caption rather than left as a row of blanks.
 */
import { cleanTextForTeam, formatRank, generateColorRampValue, joinWithAnd, numberOrNull } from '../../utils/misc';
import { espnLogoLeague, leaguePath } from '../../utils/league';
import { categoryColumns, formatPlayerMetric, percentileOf, playerPath, PLAYER_CATEGORIES, PLAYER_STAT_MINIMUMS, rollUpSeasons, unrankedSeasons, type SeasonRow } from '../../utils/players';
import { teamAbbr } from '../../utils/teams';
import DarkModeLogos from '../DarkModeLogos.astro';

interface Props {
    /** every season row the player has, all seasons */
    rows: SeasonRow[]
    /** the season to narrow to, or null for the career view (every season) */
    season: number | null
    /** the player the rows belong to; each Season cell links to his page for that year */
    espnId: string
}
const { rows, season, espnId } = Astro.props;
const league = Astro.locals.league ?? 'cfb';

const TITLES: Record<string, string> = { passing: 'Passing', rushing: 'Rushing', receiving: 'Receiving' };

interface Block {
    category: string;
    columns: [string, string][];
    shown: SeasonRow[];
    /** additive columns summed over every season, rates recomputed; null for one row */
    career: Record<string, number | string> | null;
    /** the seasons the producer published no rank for in this category, and why */
    caption: string | null;
}

const blocks: Block[] = PLAYER_CATEGORIES.map((category): Block => {
    const all = rows.filter((r: SeasonRow) => r.category === category);
    const shown = (season === null ? all : all.filter((r: SeasonRow) => Number(r.season) === season))
        // chronological, oldest first: a career reads forwards (review on #267).
        // A traded player's two rows for one season stay volume-ordered within it.
        .toSorted((a: SeasonRow, b: SeasonRow) =>
            Number(a.season) - Number(b.season) || Number(b.plays ?? 0) - Number(a.plays ?? 0));
    return {
        category,
        columns: categoryColumns(category),
        shown,
        career: rollUpSeasons(all),
        caption: unrankedSeasons(shown).length > 0
            ? `Did not qualify for ${category} ranks in ${joinWithAnd(unrankedSeasons(shown))}. (${PLAYER_STAT_MINIMUMS[category]})`
            : null,
    };
}).filter((b: Block) => b.shown.length > 0);

const teamIds = [...new Set(rows.map((r: SeasonRow) => r.team_id).filter(Boolean))] as (string | number)[];
const rankOf = (row: SeasonRow, metric: string): number | null => numberOrNull(row[`${metric}_rank`]);
// read out here, not in the template: a cast inside JSX trips the template parser
const careerValue = (b: Block, key: string): unknown => (b.career ? b.career[key] : null);
---
{blocks.length > 0 && (
<Fragment>
<DarkModeLogos teamIds={teamIds} />
{blocks.map((b) => (
<div class="table-responsive mb-3" id={`player-season-${b.category}`}>
    <h3 class="h5">{TITLES[b.category]}</h3>
    <table class="table table-sm">
        {b.caption && <caption class="text-small">{b.caption}</caption>}
        <thead>
            <tr>
                <th class="text-left" colspan="1">Season</th>
                <th class="text-left" colspan="1">Team</th>
                {b.columns.map(([, label]) => <th class="text-center" colspan="1">{label}</th>)}
            </tr>
        </thead>
        <tbody>
            {b.shown.map((row: SeasonRow) => (
                <Fragment>
                    <tr>
                        <td class="text-left numeral" colspan="1"><a href={playerPath(league, espnId, Number(row.season))}>{row.season}</a></td>
                        <td class="text-left text-nowrap" colspan="1">
                            <a href={leaguePath(league, `/year/${row.season}/team/${row.team_id}`)}>
                                <img class={`img-fluid team-logo-${row.team_id} me-2`} width="20px"
                                    src={`https://a.espncdn.com/i/teamlogos/${espnLogoLeague(league)}/500/${row.team_id}.png`}
                                    alt={`${row.pos_team ?? row.team_id} logo`} title={String(row.pos_team ?? '')} />
                                <span class="d-md-none">{cleanTextForTeam(teamAbbr(league, row.team_id, String(row.pos_team ?? '')), row.team_id)}</span>
                                <span class="d-none d-md-inline">{cleanTextForTeam(row.pos_team, row.team_id)}</span>
                            </a>
                        </td>
                        {b.columns.map(([k]) => (
                            <td class:list={["text-center", "numeral", generateColorRampValue(percentileOf(row, k), 100)]} colspan="1">
                                {formatPlayerMetric(b.category, k, row[k])}
                                {rankOf(row, k) !== null && (
                                    <span class="align-self-center text-small" style="opacity: 50%"> #{formatRank(rankOf(row, k))}</span>
                                )}
                            </td>
                        ))}
                    </tr>
                </Fragment>
            ))}
            {b.career && (
                <tr class="table-secondary">
                    <td class="text-left" colspan="1"><strong>Career</strong></td>
                    <td colspan="1"></td>
                    {b.columns.map(([k]) => (
                        <td class="text-center numeral" colspan="1">{formatPlayerMetric(b.category, k, careerValue(b, k))}</td>
                    ))}
                </tr>
            )}
        </tbody>
    </table>
</div>
))}
</Fragment>
)}
