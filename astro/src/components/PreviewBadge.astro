---
// Fixed on-page marker that preview mode is active in THIS browser. Its
// absence is the only signal the preview cookie expired (pages otherwise
// revert to the public variant silently -- see utils/preview.ts).
const active = Astro.locals.preview === true;
---
{active && (
  <div class="preview-badge" title="Preview features are active in this browser (set via /admin or a preview link)">
    PREVIEW
  </div>
)}
