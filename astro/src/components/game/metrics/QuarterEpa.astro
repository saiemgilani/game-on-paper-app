---
/**
 * G18 ('quarter-epa'): the linescore's twin in expected points, under it in the Scoring Plays panel. Rows come from
 * utils/quarterEpa.ts, which returns none when the game's EPA fails its sanity gate.
 */
import type { ESPNTeam } from '../../../resources/espn';
import type { QuarterEpaRow } from '../../../utils/quarterEpa';
import { cleanAbbreviation, roundNumber } from '../../../utils/misc';
import { espnLogoLeague, leaguePath } from '../../../utils/league';

interface Props {
    /** quarterEpa rows, in `teams` order */
    rows: QuarterEpaRow[];
    /** away, then home, as the linescore reads */
    teams: ESPNTeam[];
    season: number;
}
const { rows, teams, season } = Astro.props;
const periods = rows[0]?.byPeriod.length ?? 0;
// the linescore's column labels
const label = (i: number) => (i < 4 ? String(i + 1) : i === 4 ? "OT" : `${i - 3}OT`);
---

<div class="table-responsive mb-2">
    <table class="table table-sm" style="width: auto;">
        <caption class="text-muted text-small">EPA on every play a team had the ball, by quarter.</caption>
        <thead>
            <tr>
                <th class="box-heading">EPA</th>
                {Array.from({ length: periods }, (_, i) => (
                    <th class="numeral" style="text-align: center; min-width: 2.2rem;">{label(i)}</th>
                ))}
                <th class="numeral" style="text-align: center; min-width: 2.6rem;">T</th>
            </tr>
        </thead>
        <tbody>
            {rows.map((r, i) => (
                <tr>
                    <td style="text-align: left;">
                        <a href={leaguePath(Astro.locals.league, `/year/${season}/team/${teams[i].id}`)}>
                            <img class={`img-fluid team-logo-${teams[i].id}`} width="22px" src={`https://a.espncdn.com/i/teamlogos/${espnLogoLeague(Astro.locals.league)}/500/${teams[i].id}.png`} alt={`ESPN team id ${teams[i].id}`} />
                        </a>
                        <span class="ms-1">{cleanAbbreviation(teams[i])}</span>
                    </td>
                    {r.byPeriod.map((v) => (
                        <td class="numeral" style="text-align: center;">{roundNumber(v, 1, 1)}</td>
                    ))}
                    <td class="numeral" style="text-align: center;"><strong>{roundNumber(r.total, 1, 1)}</strong></td>
                </tr>
            ))}
        </tbody>
    </table>
</div>
