---
/**
 * Two-team situational and special-teams splits from the processor's
 * team_usage / drive_scripting / st_team sections: third downs over expected,
 * red-zone and scoring-opportunity efficiency, scripted vs non-scripted
 * drives, and the kicking game with coverage. Renders nothing when the
 * processor emitted no usage box.
 */
import type { ESPNTeam } from '../../../resources/espn';
import type { ProcessedBoxScore } from '../../../resources/python';
import { madeOf, num, pct, scriptSplit, signed, teamRows } from '../../../utils/usage';

interface Props {
    box: Partial<ProcessedBoxScore>,
    awayTeam: ESPNTeam,
    homeTeam: ESPNTeam,
}
const { box, awayTeam, homeTeam } = Astro.props;
const teams = [awayTeam, homeTeam];
const usage = teams.map((t) => teamRows(box.team_usage, t.id)[0]);
const st = teams.map((t) => teamRows(box.st_team, t.id)[0]);
const scripts = teams.map((t) => scriptSplit(box.drive_scripting as any[], t.id));
const present = usage.some(Boolean) || st.some(Boolean) || scripts.some((s) => s.scripted || s.non_scripted);

type Row = { label: string, title?: string, cells: string[] };
const rows = (r: Row) => r;
const sit: Row[] = usage.some(Boolean) ? [
    rows({ label: '3rd downs', title: 'Converted / attempts (expected at the yards to go)', cells: usage.map((u) => u ? `${madeOf(u.third_down_conversions, u.third_down_opportunities)} (exp ${num(u.third_down_expected, 1)})` : '—') }),
    rows({ label: '3rd downs over expected', cells: usage.map((u) => u && (u.third_down_opportunities ?? 0) > 0 ? signed(u.third_down_over_expected) : '—') }),
    rows({ label: 'Red-zone trips', title: 'Drives with a snap inside the 20', cells: usage.map((u) => u ? `${u.rz_trips ?? 0}` : '—') }),
    rows({ label: 'Red-zone TD rate', cells: usage.map((u) => pct(u?.rz_touchdown_rate, 0)) }),
    rows({ label: 'Red-zone points per trip', cells: usage.map((u) => num(u?.rz_points_per_trip, 2)) }),
    rows({ label: 'Red-zone success rate', cells: usage.map((u) => pct(u?.rz_success_rate, 0)) }),
    rows({ label: 'Scoring-opp trips', title: 'Drives with a snap inside the 40', cells: usage.map((u) => u ? `${u.so_trips ?? 0}` : '—') }),
    rows({ label: 'Scoring-opp TD rate', cells: usage.map((u) => pct(u?.so_touchdown_rate, 0)) }),
    rows({ label: 'Scoring-opp points per trip', cells: usage.map((u) => num(u?.so_points_per_trip, 2)) }),
    rows({ label: 'Scoring-opp EPA/play', cells: usage.map((u) => num(u?.so_epa_per_play, 2)) }),
] : [];
const scriptRows: Row[] = scripts.some((s) => s.scripted || s.non_scripted) ? [
    rows({ label: 'Scripted drives', title: 'The first two drives of each half', cells: scripts.map((s) => s.scripted ? `${s.scripted.drives} drives, ${num(s.scripted.epa_per_play, 2)} EPA/play, ${pct(s.scripted.success_rate, 0)} SR, ${num(s.scripted.points_per_drive, 2)} pts/drive` : '—') }),
    rows({ label: 'Non-scripted drives', title: 'Every other drive', cells: scripts.map((s) => s.non_scripted ? `${s.non_scripted.drives} drives, ${num(s.non_scripted.epa_per_play, 2)} EPA/play, ${pct(s.non_scripted.success_rate, 0)} SR, ${num(s.non_scripted.points_per_drive, 2)} pts/drive` : '—') }),
] : [];
const stRows: Row[] = st.some(Boolean) ? [
    rows({ label: 'Field goals', cells: st.map((s) => s ? `${madeOf(s.fg_made, s.fg_attempts)}${s.fgs_blocked > 0 ? ` (${s.fgs_blocked} blocked)` : ''}` : '—') }),
    rows({ label: 'Kickoff touchback rate', cells: st.map((s) => pct(s?.kickoff_touchback_rate, 0)) }),
    rows({ label: 'Kickoff coverage', title: 'Return yards allowed per return (return TDs allowed)', cells: st.map((s) => s ? `${num(s.kickoff_return_avg_allowed, 1)} / return${s.kickoff_return_tds_allowed > 0 ? ` (${s.kickoff_return_tds_allowed} TD)` : ''}` : '—') }),
    rows({ label: 'Net punt average', cells: st.map((s) => num(s?.punt_net_avg, 1)) }),
    rows({ label: 'Punt coverage', title: 'Return yards allowed per return (return TDs allowed)', cells: st.map((s) => s ? `${num(s.punt_return_avg_allowed, 1)} / return${s.punt_return_tds_allowed > 0 ? ` (${s.punt_return_tds_allowed} TD)` : ''}` : '—') }),
    rows({ label: 'Kick returns', cells: st.map((s) => s ? `${s.kick_returns} for ${num(s.kick_return_avg, 1)}${s.kick_return_tds > 0 ? ` (${s.kick_return_tds} TD)` : ''}` : '—') }),
    rows({ label: 'Punt returns', cells: st.map((s) => s ? `${s.punt_returns} for ${num(s.punt_return_avg, 1)}${s.punt_return_tds > 0 ? ` (${s.punt_return_tds} TD)` : ''}` : '—') }),
    rows({ label: 'Blocks made', title: 'Punts and field goals blocked by this team', cells: st.map((s) => s ? `${s.punt_blocks_by} punt, ${s.fg_blocks_by} FG` : '—') }),
] : [];
const blocks: { title: string, rows: Row[] }[] = [
    { title: 'Situational', rows: sit },
    { title: 'Drive scripting', rows: scriptRows },
    { title: 'Special teams', rows: stRows },
].filter((b) => b.rows.length > 0);
---
{present && (
<div class="table-responsive" id="situational-splits-table">
    <table class="table table-sm">
        <thead>
            <tr>
                <th class="box-heading"></th>
                {teams.map((t) => <th class="box-heading" style="text-align: center;">{t.abbreviation}</th>)}
            </tr>
        </thead>
        <tbody>
            {blocks.map((b) => (
                <Fragment>
                    <tr class="table-secondary"><td colspan={teams.length + 1}><b>{b.title}</b></td></tr>
                    {b.rows.map((r) => (
                        <tr>
                            <td title={r.title}>{r.label}</td>
                            {r.cells.map((c) => <td class="numeral" style="text-align: center;">{c}</td>)}
                        </tr>
                    ))}
                </Fragment>
            ))}
        </tbody>
    </table>
</div>
)}
