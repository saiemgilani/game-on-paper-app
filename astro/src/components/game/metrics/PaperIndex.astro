---
import type { ESPNTeam } from '../../../resources/espn';
import Panel from '../../../layouts/panel/GenericPanel.astro';
import { adjustTeamColorsForContrast, cleanAbbreviation, roundNumber, rgbToHex, type ThemedGameColors } from '../../../utils/misc';
import { espnLogoLeague } from '../../../utils/league';

interface Props {
    result: {
        homeShare: number
        margins: Record<string, number>
        /** per margin, the percentage points it alone moved the home share (paper_index.py) */
        impact?: Record<string, number | null>
        /** per margin, its importance in the model; the table's row order (paper_index.py) */
        importance?: Record<string, number>
        byPeriod?: Record<string, { homeShare: number; margins: Record<string, number> }>
    }
    homeTeam: ESPNTeam
    awayTeam: ESPNTeam
    completed: boolean
    colors?: ThemedGameColors
}

const { result, homeTeam, awayTeam, completed, colors } = Astro.props;
const [awayTeamColor, homeTeamColor] = adjustTeamColorsForContrast(awayTeam, homeTeam)

const clampPct = (share: number) => Math.min(99, Math.max(1, Math.round(share * 100)));
const homePct = clampPct(result.homeShare);
const awayPct = 100 - homePct;
// the page's colour decision when there is one ('game-colours'), as custom properties that
// switch with prefers-color-scheme like the rest of the site's dark mode; else the pair
// adjusted for contrast against each other
const barColor = (t: ESPNTeam, fallback: string) => colors
    ? `var(--pi-${t === homeTeam ? "home" : "away"})`
    : (t.id == awayTeam.id ? (rgbToHex(awayTeamColor) ?? fallback) : (rgbToHex(homeTeamColor) ?? fallback));
const barVars = colors && `#paper-index-panel { --pi-home: ${colors.light.home}; --pi-away: ${colors.light.away}; }
@media (prefers-color-scheme: dark) { #paper-index-panel { --pi-home: ${colors.dark.home}; --pi-away: ${colors.dark.away}; } }`;
const meterLabel = `Deserved Win %: ${awayTeam.abbreviation} ${awayPct}%, ${homeTeam.abbreviation} ${homePct}%`;
const fmt = (v: number, digits = 1) => `${v >= 0 ? "+" : ""}${roundNumber(v, 2, digits)}`;
const m = result.margins;
const impact = result.impact;
const pct = (v: number) => `${fmt(v * 100)}%`;
// the home team's edge on each fitted input, in display order
const MARGINS: [string, string, (v: number) => string][] = [
    ["success", "Success Rate", pct],
    ["explosive", "Explosive Play Rate", pct],
    ["explosive_epa", "Explosiveness (EPA/success)", (v) => fmt(v, 2)],
    ["opp_conversion", "Opportunity Conversion Rate", pct],
    ["pts_per_opp", "Points per opportunity", fmt],
    ["field_position", "Field position (EP)", (v) => fmt(v, 2)],
    ["havoc", "Havoc Rate", pct],
    ["turnovers", "Turnovers", (v) => fmt(v, 0)],
];
const importance = result.importance;
// impact as a level, not a number: one to three arrows by how many percentage points the margin
// alone moved the home share, an em-dash under the first step. Steps fitted to Akshay's mockup on
// #306 (a 68% game: 14 pts = 1, 16 and 23 = 2, 26 and 55 = 3, 3 and under = none).
const IMPACT_STEPS = [5, 15, 25];
const impactLevel = (v: number) => IMPACT_STEPS.filter((s) => Math.abs(v) >= s).length;
const LEVEL_WORDS = ["", "slightly", "clearly", "strongly"];
// the model's importance (weight x spread, python/paper_index.py IMPORTANCE) descending: the same
// order every game; rows without one last, and the stable sort keeps display order otherwise
const marginRows = MARGINS
    .filter(([k]) => m[k] != null)
    .map(([k, label, format]) => {
        const v = impact?.[k] ?? null;
        const level = v == null ? 0 : impactLevel(v);
        return {
            label, value: format(m[k]), pos: m[k] >= 0, importance: importance?.[k] ?? null,
            level, up: v != null && v > 0,
            impactText: v == null ? "not measured" : level ? `${LEVEL_WORDS[level]} ${v > 0 ? "helped" : "hurt"} ${homeTeam.abbreviation}` : "little impact",
        };
    })
    .sort((a, b) => Number(a.importance == null) - Number(b.importance == null) || (b.importance ?? 0) - (a.importance ?? 0));
// per-window strip, canonical order; a missing window simply doesn't render
const PERIOD_ORDER = ["q1", "q2", "q3", "q4", "ot"];
const periods = PERIOD_ORDER
    .filter((k) => result.byPeriod?.[k])
    .map((k) => {
        const p = clampPct(result.byPeriod![k].homeShare);
        return { label: k.toUpperCase(), homePct: p, awayPct: 100 - p };
    });
---
{barVars && <style set:html={barVars}></style>}
<Panel id="paper-index" title="Deserved Win %" show={true} class="mb-md-3">
    <div slot="panel-subtitle">
        <p class="mb-0">AKA post-game win expectancy. Inspired by <a href="https://bsky.app/profile/espnbillc.bsky.social">Bill Connelly</a>'s <a href="https://www.espn.com/college-football/story/_/id/48288665/college-football-2026-turnovers-lucky-bounces">SP+ PGWE</a>.</p>
        <blockquote class="text-muted small fst-italic">The idea is to take all of a game's key, predictive stats...and basically toss them into the air and say, "With these stats, you could have expected to win this game X% of the time."</blockquote>
    </div>
    <div class="row mb-3" slot="panel-body">
        <div class="col-lg-8 col-12 d-flex flex-column justify-content-center mb-3 mb-lg-0">
            <div class="d-flex align-items-center gap-2">
                <img class={`img-fluid team-logo-${awayTeam.id}`} width="28" height="28" src={`https://a.espncdn.com/i/teamlogos/${espnLogoLeague(Astro.locals.league)}/500/${awayTeam.id}.png`} alt={awayTeam.abbreviation} />
                <span class="fw-bold" style="min-width: 4ch">{awayPct}%</span>
                <div class="progress flex-grow-1" style="height: 24px" role="meter" aria-label={meterLabel} aria-valuenow={homePct} aria-valuetext={`${homeTeam.abbreviation} ${homePct}%`} aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style={`width: ${awayPct}%; background-color: ${barColor(awayTeam, "#888888")}`}></div>
                    <div class="progress-bar" style={`width: ${homePct}%; background-color: ${barColor(homeTeam, "#444444")}`}></div>
                </div>
                <span class="fw-bold" style="min-width: 4ch">{homePct}%</span>
                <img class={`img-fluid team-logo-${homeTeam.id}`} width="28" height="28" src={`https://a.espncdn.com/i/teamlogos/${espnLogoLeague(Astro.locals.league)}/500/${homeTeam.id}.png`} alt={homeTeam.abbreviation} />
            </div>
            {periods.length > 0 && (
                <div class="d-flex flex-wrap gap-3 mt-3" aria-label="Deserved Win % by quarter">
                    {periods.map((p) => (
                        <div class="text-center" style="min-width: 72px">
                            <div class="progress" style="height: 10px" title={`${p.label}: ${awayTeam.abbreviation} ${p.awayPct}% — ${homeTeam.abbreviation} ${p.homePct}%`}>
                                <div class="progress-bar" style={`width: ${p.awayPct}%; background-color: ${barColor(awayTeam, "#888888")}`}></div>
                                <div class="progress-bar" style={`width: ${p.homePct}%; background-color: ${barColor(homeTeam, "#444444")}`}></div>
                            </div>
                            <span class="small text-muted">{p.label} - <span class="fw-bold">{cleanAbbreviation(homeTeam)} {p.homePct}%</span></span>
                        </div>
                    ))}
                </div>
            )}
        </div>
        <div class="col-lg-4 col-12">
            <table class="table table-sm align-middle mb-0">
                {impact && <caption class="text-muted text-small">Sorted by each metric's importance in the model. Arrows show how much it moved this game's Deserved Win %.</caption>}
                <thead>
                    <tr>
                        <th>Margin</th>
                        <th class="text-center"><img class={`img-fluid team-logo-${homeTeam.id}`} width="35px" src={`https://a.espncdn.com/i/teamlogos/${espnLogoLeague(Astro.locals.league)}/500/${homeTeam.id}.png`} alt={`ESPN team id ${homeTeam.id}`} /></th>
                        {impact && <th class="text-center">Impact</th>}
                    </tr>
                </thead>
                <tbody>
                    {marginRows.map((r) => (
                        <tr>
                            <td class="text-small">{r.label}</td>
                            <td class="text-center fw-bold" style={r.pos ? "color: var(--bs-green)" : "color: var(--bs-purple)"}>{r.value}</td>
                            {impact && (r.level === 0
                                ? <td class="text-center text-muted"><span aria-hidden="true">—</span><span class="visually-hidden">{r.impactText}</span></td>
                                : <td class="text-center text-nowrap" style={r.up ? "color: var(--bs-green)" : "color: var(--bs-purple)"}>
                                    {Array.from({ length: r.level }, () => <i class={`bi bi-arrow-${r.up ? "up" : "down"}`} aria-hidden="true"></i>)}
                                    <span class="visually-hidden">{r.impactText}</span>
                                </td>)}
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</Panel>
