---
import type { ESPNTeam } from '../../../resources/espn';
import { roundNumber } from '../../../utils/misc';

interface Props {
    result: {
        homeShare: number
        margins: Record<string, number>
    }
    homeTeam: ESPNTeam
    awayTeam: ESPNTeam
    completed: boolean
}

const { result, homeTeam, awayTeam, completed } = Astro.props;

// clamp so a 99.7% blowout reads 99/1, never a pinned 100/0
const homePct = Math.min(99, Math.max(1, Math.round(result.homeShare * 100)));
const awayPct = 100 - homePct;
const barColor = (t: ESPNTeam, fallback: string) => `#${t.color ?? fallback}`;
const meterLabel = `Paper Index: ${awayTeam.abbreviation} ${awayPct}%, ${homeTeam.abbreviation} ${homePct}%`;
const fmt = (v: number, digits = 1) => `${v >= 0 ? "+" : ""}${roundNumber(v, 2, digits)}`;
const m = result.margins;
// the home team's edge on each fitted input, in display order
const marginBits = [
    m.success != null ? `success ${fmt(m.success * 100)}%` : null,
    m.explosive != null ? `explosiveness ${fmt(m.explosive * 100)}%` : null,
    m.opp_conversion != null ? `finishing ${fmt(m.opp_conversion * 100)}%` : null,
    m.field_position != null ? `field position ${fmt(m.field_position)} yds` : null,
    m.havoc != null ? `havoc ${fmt(m.havoc * 100)}%` : null,
    m.turnovers != null ? `turnovers ${fmt(m.turnovers, 0)}` : null,
].filter(Boolean);
---
<div class="card border rounded">
    <div class="card-body py-3">
        <h2 class="fs-5 mb-1">Paper Index</h2>
        <p class="small text-muted mb-2">
            Who {completed ? "won" : "is winning"} this game on paper: success rate, explosiveness,
            drive finishing, field position, havoc, and turnovers — each weighted by how much it
            decides real games.
        </p>
        <div class="d-flex align-items-center gap-2">
            <img class={`team-logo-${awayTeam.id}`} width="28" height="28" src={`https://a.espncdn.com/i/teamlogos/ncaa/500/${awayTeam.id}.png`} alt={awayTeam.abbreviation} />
            <span class="fw-bold" style="min-width: 3ch">{awayPct}%</span>
            <div class="progress flex-grow-1" style="height: 20px" role="meter" aria-label={meterLabel} aria-valuenow={homePct} aria-valuetext={`${homeTeam.abbreviation} ${homePct}%`} aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style={`width: ${awayPct}%; background-color: ${barColor(awayTeam, "888888")}`}></div>
                <div class="progress-bar" style={`width: ${homePct}%; background-color: ${barColor(homeTeam, "444444")}`}></div>
            </div>
            <span class="fw-bold" style="min-width: 3ch">{homePct}%</span>
            <img class={`team-logo-${homeTeam.id}`} width="28" height="28" src={`https://a.espncdn.com/i/teamlogos/ncaa/500/${homeTeam.id}.png`} alt={homeTeam.abbreviation} />
        </div>
        {marginBits.length > 0 && (
            <p class="small text-muted m-0 mt-2">{homeTeam.abbreviation} margins: {marginBits.join(" · ")}</p>
        )}
    </div>
</div>
