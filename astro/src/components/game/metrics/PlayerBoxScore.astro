---
import type { ProcessedBoxScore, ProcessedPassingBoxScore, ProcessedReceivingBoxScore, ProcessedRushingBoxScore, ProcessedSTBlock, ProcessedSTKicker, ProcessedSTPunter, ProcessedSTReturner } from '../../../resources/python';
import { roundNumber } from "../../../utils/misc";
import { defensiveBox, playerExtremes } from "../../../utils/defensiveBox";
import { num, playerIdsByName } from "../../../utils/usage";
import { blockerStatLine, kickerStatLine, passingStatLine, punterStatLine, receivingStatLine, returnerStatLine, rushingStatLine } from "../../../utils/players";
import PlayerLink from "../../player/PlayerLink.astro";
import { officialDefense, officialKickers, officialPassing, officialPunters, officialReceiving, officialReturners, officialRushing, type EspnPlayerRow } from "../../../utils/officialBox";
import type { League } from "../../../utils/league";

interface Props {
    pass: ProcessedPassingBoxScore[],
    rush: ProcessedRushingBoxScore[],
    receiver: ProcessedReceivingBoxScore[],
    kickers?: ProcessedSTKicker[],
    punters?: ProcessedSTPunter[],
    blocks?: ProcessedSTBlock[],
    returners?: ProcessedSTReturner[],
    /** Every play in the game, for the longest gain, the best play, and the defence. */
    plays?: any[],
    /** The team whose defenders to credit; omit to leave the defensive table out. */
    teamId?: string | number,
    /** The whole box, purely for the usage sections' player ids (these rows carry none). */
    box?: Partial<ProcessedBoxScore>,
    /** The game's season, so a player link opens on the season being watched. */
    season?: number,
    /**
     * ESPN's player box (`advBoxScore.espn_players`) for a full-game render: the
     * counting stats come from it (utils/officialBox.ts). Omit for a quarter or half,
     * which ESPN does not publish, to keep the play-by-play counts.
     */
    espn?: EspnPlayerRow[],
    league?: League,
}
let { pass, rush, receiver, kickers, punters, blocks, returners, plays = [], teamId, box, season, espn, league = 'cfb' } = Astro.props;

// These rows carry a player NAME and no id, so a link to the player page has to
// borrow the id from the usage/tackle sections of the same box -- the same
// name-keyed join the extremes below already do.
// One interaction per name (review on #267): the name is the link to the
// player page, and filtering the play-by-play to a player is the dropdown
// above the plays (`plays/PlayFocus.astro`), which lists every player-role in
// the game rather than only the ones the advanced box happens to show.
const playerIds = teamId == null ? new Map<string, string>() : playerIdsByName(box, teamId);

// LNG and the single best play come off the plays themselves: the advanced box carries
// totals and rates, not extremes.
// Keyed on the player name: the advanced box rows carry no player id, and the name is
// the only field the two shapes share.
// A passer's longest is his longest COMPLETION, which is the receiving yardage
// on the play -- the same number the official book prints.
const passBest = playerExtremes(plays, "passer_player_name", "yds_receiving");
const rushBest = playerExtremes(plays, "rusher_player_name", "yds_rushed");
const recvBest = playerExtremes(plays, "receiver_player_name", "yds_receiving");
const official = teamId == null ? undefined : espn;
const defense = teamId == null ? [] : officialDefense(defensiveBox(plays, teamId), official, teamId, playerIds, league);

/** "22 LNG · 2.10 best · 1.4% best" — the extremes tail on a stat line. */
const bestTail = (m: Map<string, any>, id: unknown, showLng = true): string => {
    const e = id == null ? null : m.get(String(id));
    if (!e) return "";
    const bits: string[] = [];
    if (showLng && e.LNG != null) bits.push(`${e.LNG} LNG`);
    if (e.EPA_MAX != null) bits.push(`${roundNumber(e.EPA_MAX, 2, 2)} best EPA`);
    if (e.WPA_MAX != null) bits.push(`${roundNumber(e.WPA_MAX * 100, 2, 1)}% best WPA`);
    return bits.length ? `, ${bits.join(", ")}` : "";
};

// Air-yards tail for a passer / receiver stat line. Null aDOT means ESPN's text
// carried no catch spot for this game (pre-2025), so print nothing rather than 0.
const airLine = (p: { aDOT?: number | null, CompAirYds?: number | null, YAC?: number | null }): string =>
    p.aDOT == null ? "" : `, ${p.CompAirYds ?? 0} air yds / ${p.YAC ?? 0} YAC, ${roundNumber(p.aDOT, 2, 1)} aDOT`;

// Highest first; a line only ESPN lists has no EPA and goes last.
const byDesc = (k: string) => (a: any, b: any) => (Number.isFinite(b[k]) ? b[k] : -1e9) - (Number.isFinite(a[k]) ? a[k] : -1e9);
const tid = teamId ?? '';
const passLines: any[] = officialPassing(pass.filter(p => (p.passer_player_name?.length ?? 0) > 0), official, tid, playerIds).toSorted(byDesc('EPA'));
const rushLines: any[] = officialRushing(rush.filter(p => (p.rusher_player_name?.length ?? 0) > 0), official, tid, playerIds).toSorted(byDesc('EPA'));
const recvLines: any[] = officialReceiving(receiver.filter(p => (p.receiver_player_name?.length ?? 0) > 0), official, tid, playerIds).toSorted(byDesc('EPA'));
kickers = officialKickers((kickers || []).filter(p => (p.player_name?.length ?? 0) > 0), official, tid).toSorted(byDesc('fg_epa'));
punters = officialPunters((punters || []).filter(p => (p.player_name?.length ?? 0) > 0), official, tid).toSorted(byDesc('punt_epa'));
returners = officialReturners((returners || []).filter(p => (p.player_name?.length ?? 0) > 0), official, tid).toSorted(byDesc('kick_return_yards'));
/** A pbp-only line on a full-game box: ESPN does not list the player. */
const PBP_NOTE = "Not in ESPN's box score: counted from the play-by-play.";
const fromPbp = (p: any) => p?.source === 'pbp';
const idOf = (name: unknown, p: any) => p?.player_id ?? playerIds.get(String(name ?? '')) ?? p?.espn_athlete_id ?? undefined;
/** An advanced (play-by-play) cell; a line only ESPN lists has none. */
const adv = (v: unknown, scale: number, digits: number, suffix = '') => Number.isFinite(v) ? `${roundNumber((v as number) * scale, 2, digits)}${suffix}` : '\u2014';
blocks = (blocks || []).filter(p => (p.player_name?.length ?? 0) > 0);

---
<div class="table-responsive">
    <table class="table table-sm">
        <thead>
            <tr>
            <th rowspan="1" colspan="1"></th>
            <th rowspan="1" colspan="1" class="box-heading" style="text-align: center;">Yards/play</th>
            <th rowspan="1" colspan="1" class="box-heading" style="text-align: center;" title="Expected Points Added per Play">EPA/play</th>
            <th rowspan="1" colspan="1" class="box-heading" style="text-align: center;" title="Total Expected Points Added">EPA</th>
            <th rowspan="1" colspan="1" class="box-heading" style="text-align: center;" title="Success Rate">SR</th>
            <th rowspan="1" colspan="1" class="box-heading" style="text-align: center;" title="Win Probability Added">WPA</th>
            </tr>
        </thead>
        <tbody>
            {
                (passLines.length > 0) && (
                    <tr>
                        <td colspan="6" class="gt_group_heading" style="color: black; font-weight: bold;" title="Includes pass attempts and sacks.">Dropbacks</td>
                    </tr>
                )
            }
            {
                (passLines.length > 0) && (passLines.map((p) => (
                    <Fragment>
                    <tr>
                        <td style="text-align: left;"><PlayerLink id={idOf(p.passer_player_name, p)} season={season}>{p.passer_player_name}</PlayerLink></td>
                        <td class="numeral" style="text-align: center;">{adv(p.YPA ?? (Number.isFinite(p.EPA) ? 0 : null), 1, 2)}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.EPA_per_Play, 1, 2)}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.EPA, 1, 2)}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.SR, 100, 0, '%')}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.WPA, 100, 1, '%')}</td>
                    </tr>
                    <tr class="stat-line-row">
                        <td colspan="6" class="text-muted">{passingStatLine({ comp: p.Comp, att: p.Att, yards: p.Yds, tds: p.Pass_TD, ints: p.Int })}, {p.Sck ?? 0} Sck{Number.isFinite(p.exp_qbr) && `, ${roundNumber(p.exp_qbr, 2, 1)} xQBR`}{fromPbp(p) && <span title={PBP_NOTE}> (play-by-play)</span>}<span title="Air yards on completions / yards after catch; aDOT = average depth of target (air yards per attempt)">{airLine(p)}</span><span title="Longest completion, and this passer's single best play by EPA and by win probability added">{bestTail(passBest, p.passer_player_name)}</span></td>
                    </tr>
                    </Fragment>
                )))
            }
            {
                (rushLines.length > 0) && (
                    <tr>
                        <td colspan="6" class="gt_group_heading" style="color: black; font-weight: bold;">Rush attempts</td>
                    </tr>
                )
            }
            {
                (rushLines.length > 0) && (rushLines.map((p) => (
                    <Fragment>
                    <tr>
                        <td style="text-align: left;"><PlayerLink id={idOf(p.rusher_player_name, p)} season={season}>{p.rusher_player_name}</PlayerLink></td>
                        <td class="numeral" style="text-align: center;">{adv(p.YPC ?? (Number.isFinite(p.EPA) ? 0 : null), 1, 2)}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.EPA_per_Play, 1, 2)}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.EPA, 1, 2)}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.SR, 100, 0, '%')}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.WPA, 100, 1, '%')}</td>
                    </tr>
                    <tr class="stat-line-row">
                        <td colspan="6" class="text-muted">{rushingStatLine({ carries: p.Car, yards: p.Yds, tds: p.Rush_TD })}, {p.Fum ?? 0} Fum ({p.Fum_Lost ?? 0} lost){fromPbp(p) && <span title={PBP_NOTE}> (play-by-play)</span>}<span title="Longest carry, and this rusher's single best play by EPA and by win probability added">{bestTail(rushBest, p.rusher_player_name)}</span></td>
                    </tr>
                    </Fragment>
                )))
            }
            {
                (recvLines.length > 0) && (
                    <tr>
                        <td colspan="6" class="gt_group_heading" style="color: black; font-weight: bold;">Pass targets</td>
                    </tr>
                )
            }
            {
                (recvLines.length > 0) && (recvLines.map((p) => (
                    <Fragment>
                    <tr>
                        <td style="text-align: left;"><PlayerLink id={idOf(p.receiver_player_name, p)} season={season}>{p.receiver_player_name}</PlayerLink></td>
                        <td class="numeral" style="text-align: center;">{adv(p.YPT ?? (Number.isFinite(p.EPA) ? 0 : null), 1, 2)}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.EPA_per_Play, 1, 2)}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.EPA, 1, 2)}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.SR, 100, 0, '%')}</td>
                        <td class="numeral" style="text-align: center;">{adv(p.WPA, 100, 1, '%')}</td>
                    </tr>
                    <tr class="stat-line-row">
                        <td colspan="6" class="text-muted">{receivingStatLine({ receptions: p.Rec, targets: p.Tar, yards: p.Yds, tds: p.Rec_TD })}, {p.Fum ?? 0} Fum ({p.Fum_Lost ?? 0} lost){fromPbp(p) && <span title={PBP_NOTE}> (play-by-play)</span>}<span title="Air yards on catches / yards after catch; aDOT = average depth of target (air yards per target)">{airLine(p)}</span><span title="Longest catch, and this receiver's single best play by EPA and by win probability added">{bestTail(recvBest, p.receiver_player_name)}</span></td>
                    </tr>
                    </Fragment>
                )))
            }
            {
                (defense.length > 0) && (
                    <tr>
                        <td colspan="6" class="gt_group_heading" style="color: black; font-weight: bold;" title="Read from the tacklers ESPN names in the play text. Older games carry no tacklers and show nothing here.">Defense</td>
                    </tr>
                )
            }
            {
                (defense.length > 0) && (defense.map((d) => (
                    <Fragment>
                    <tr>
                        <td style="text-align: left;"><PlayerLink id={idOf(d.name, d)} season={season}>{d.name}</PlayerLink></td>
                        <td class="numeral" style="text-align: center;">&mdash;</td>
                        <td class="numeral" style="text-align: center;">&mdash;</td>
                        <td class="numeral" style="text-align: center;">&mdash;</td>
                        <td class="numeral" style="text-align: center;">&mdash;</td>
                        <td class="numeral" style="text-align: center;">&mdash;</td>
                    </tr>
                    <tr class="stat-line-row">
                        <td colspan="6" class="text-muted">{d.TOT} tackle{(d.TOT == 1) ? "" : "s"} ({d.SOLO} solo, {d.AST} ast){(d.TFL > 0) ? `, ${d.TFL} TFL` : ""}{(d.SACK > 0) ? `, ${d.SACK} sack` : ""}{(d.INT > 0) ? `, ${d.INT} INT` : ""}{(d.PBU > 0) ? `, ${d.PBU} PBU` : ""}{(d.QBH > 0) ? `, ${d.QBH} ${league === 'nfl' && d.source === 'espn' ? 'QB hit' : 'QB hurr'}` : ""}{fromPbp(d) && <span title={PBP_NOTE}> (play-by-play)</span>}</td>
                    </tr>
                    </Fragment>
                )))
            }
            {
                (punters.length > 0) && (
                    <tr>
                        <td colspan="6" class="gt_group_heading" style="color: black; font-weight: bold;">Punting</td>
                    </tr>
                )
            }
            {punters.map((p: any) => (
                <tr>
                    <td><PlayerLink id={idOf(p.player_name, p)} season={season}>{p.player_name}</PlayerLink></td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">{num(p.punt_epa, 2)}</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                </tr>
                <tr class="stat-line-row">
                    <td colspan="6" class="text-muted"><Fragment set:html={punterStatLine(p)} />{fromPbp(p) && <span title={PBP_NOTE}> (play-by-play)</span>}</td>
                </tr>
            ))}
            {
                (kickers.length > 0) && (
                    <tr>
                        <td colspan="6" class="gt_group_heading" style="color: black; font-weight: bold;">Kicking</td>
                    </tr>
                )
            }
            {kickers.map((k: any) => (
                <tr>
                    <td><PlayerLink id={idOf(k.player_name, k)} season={season}>{k.player_name}</PlayerLink></td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">{(k.fg_epa == null && k.kickoff_epa == null) ? '\u2014' : num((k.fg_epa ?? 0) + (k.kickoff_epa ?? 0), 2)}</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                </tr>
                <tr class="stat-line-row">
                    <td colspan="6" class="text-muted">
                        <Fragment set:html={kickerStatLine(k)} />{fromPbp(k) && <span title={PBP_NOTE}> (play-by-play)</span>}
                    </td>
                </tr>
            ))}
            {
                (returners.length > 0) && (
                    <tr>
                        <td colspan="6" class="gt_group_heading" style="color: black; font-weight: bold;">Kick Returns</td>
                    </tr>
                )
            }
            {returners.map((r: any) => (
                <tr>
                    <td><PlayerLink id={idOf(r.player_name, r)} season={season}>{r.player_name}</PlayerLink></td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">{(r.kick_return_epa == null && r.punt_return_epa == null) ? '\u2014' : num((r.kick_return_epa ?? 0) + (r.punt_return_epa ?? 0), 2)}</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                </tr>
                <tr class="stat-line-row">
                    <td colspan="6" class="text-muted">
                        <Fragment set:html={returnerStatLine(r)} />{fromPbp(r) && <span title={PBP_NOTE}> (play-by-play)</span>}
                    </td>
                </tr>
            ))}
            {
                (blocks.length > 0) && (
                    <tr>
                        <td colspan="6" class="gt_group_heading" style="color: black; font-weight: bold;">Blocked Kicks</td>
                    </tr>
                )
            }
            {blocks.map((b: any) => (
                <tr>
                    <td><PlayerLink id={b.player_id ?? playerIds.get(String(b.player_name ?? ''))} season={season}>{b.player_name}</PlayerLink></td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                    <td class="numeral" style="text-align: center;">&mdash;</td>
                </tr>
                <tr class="stat-line-row">
                    <td colspan="6" class="text-muted">
                        <Fragment set:html={blockerStatLine(b)} />
                    </td>
                </tr>
            ))}


        </tbody>
    </table>
</div>