---
import { DateTime } from 'luxon';
import { retrieveGameSummary, type ESPNPlayByPlayResponse } from '../../resources/espn';
import type { SDVTeamSeasonInformation, SDVTeamSummary } from '../../resources/sdv';
import { retrieveTeamSummaries, retrieveTeamSeasonInformation, retrieveMatchupHistory } from '../../resources/sdv';
import { LEAGUES, leaguePath, type League } from '../../utils/league';
import { CURRENT_YEAR, METRIC_YEAR } from '../../utils/constants';
import { cleanLocation, isChampionshipEvent, pickGameColors } from '../../utils/misc';
import DarkModeLogos from '../DarkModeLogos.astro';
import LocalDate from '../LocalDate.svelte';
import TeamCard from '../team/TeamCard.astro';
import MatchupView from './MatchupView.astro';
import WatchButton from './WatchButton.astro';
import Footer from '../Footer.astro';
import "bootstrap-icons/font/bootstrap-icons.css";
import { gameDescription, gameTitle, jsonLdScript, sportsEventJsonLd } from '../../utils/seo';
import GameHeader from './GameHeader.astro';
import GameEssentials from './GameEssentials.astro';
import PlayersToWatch from './PlayersToWatch.astro';
import RecentForm from './RecentForm.astro';
import { isFeatureEnabled } from '../../utils/features';

interface Props {
    id: string | number
    espnGame: ESPNPlayByPlayResponse
    league?: League
}

const { id, espnGame } = Astro.props;
const league: League = Astro.props.league ?? Astro.locals.league ?? 'cfb';
const espnPath = LEAGUES[league].espnPath;

const game = espnGame.gamepackageJSON.header.competitions[0];

const homeComp = game.competitors[0];
const awayComp = game.competitors[1];
const homeTeam = homeComp.team;
const awayTeam = awayComp.team;
const gameNote = espnGame.gamepackageJSON.header.gameNote ?? "";
const isChampEvent = isChampionshipEvent(gameNote);

const statusDescription = game.status.type.description ?? "Scheduled";
const header = espnGame.gamepackageJSON.header;

// game context (venue, weather, line, leaders, recent form) lives on the
// summary endpoint only; started here, awaited after the SDV fetches so an
// ESPN retry/relay episode overlaps them instead of stacking onto page latency
const gameSummaryPromise = retrieveGameSummary(id, league);

// Canonical is /game/<id>, the served path; /cfb/game/<id> is Disallowed in
// robots.txt, so the old value told Google the authoritative URL was one it may not crawl.
const canonicalUrl = new URL(leaguePath(league, `/game/${id}`), "https://gameonpaper.com").href;
// Team metrics: the game's own season once its tables exist (week 1 onward),
// otherwise the previous season -- and the label below says which one was used.
// Player lists keep the previous season for a current-season game: the player
// tables lag the team tables and the API only falls back on an error, not on an
// empty result.
const gameSeason: number = espnGame.gamepackageJSON.header.season.year;
const summaryYear = (gameSeason == CURRENT_YEAR && CURRENT_YEAR != METRIC_YEAR) ? METRIC_YEAR : gameSeason;

let homeTeamSeason: SDVTeamSeasonInformation = {
    team: null,
    events: [],
};
try {
    homeTeamSeason = await retrieveTeamSeasonInformation(espnGame.gamepackageJSON.header.season.year, homeTeam.id, league)
} catch (e) {
    console.error(e);
    homeTeamSeason = {
        team: null,
        events: [],
    }
}

let awayTeamSeason: SDVTeamSeasonInformation = {
    team: null,
    events: [],
};
try {
    awayTeamSeason = await retrieveTeamSeasonInformation(espnGame.gamepackageJSON.header.season.year, awayTeam.id, league);
} catch (e) {
    console.error(e);
    awayTeamSeason = {
        team: null,
        events: [],
    }
}

let homeSummaries: SDVTeamSummary[] = [];
let awaySummaries: SDVTeamSummary[] = [];
const fetchTeamSummaries = async (season: number): Promise<[SDVTeamSummary[], SDVTeamSummary[]]> => {
    const one = async (teamId: string | number) => {
        try {
            return (await retrieveTeamSummaries({ season, team_id: Number(teamId), league, maxLookback: season })) ?? [];
        } catch (e) {
            console.error(e);
            return [];
        }
    };
    return [await one(homeTeam.id), await one(awayTeam.id)];
};
try {
    [homeSummaries, awaySummaries] = await fetchTeamSummaries(summaryYear);
} catch (e) {
    console.error(e);
    awaySummaries = [];
}

const homeSummary = homeSummaries.length == 0 ? null : homeSummaries[0];
const awaySummary = awaySummaries.length == 0 ? null : awaySummaries[0];

let matchupHistory: Awaited<ReturnType<typeof retrieveMatchupHistory>> = [];
try {
    matchupHistory = await retrieveMatchupHistory(homeTeam.id, awayTeam.id, 5, league);
} catch (e) {
    // same fail-open contract as the other SDV lookups above: a matchup-history
    // outage must not cost the pregame page
    console.error(e);
    matchupHistory = [];
}

const gameSummary = await gameSummaryPromise;
const venue = gameSummary?.gameInfo?.venue ?? null;
const gameSpec = {
    id, hasScore: false,
    away: cleanLocation(awayComp.team), home: cleanLocation(homeComp.team),
    awayName: awayComp.team.displayName, homeName: homeComp.team.displayName,
    awayId: awayTeam.id, homeId: homeTeam.id,
    date: game.date, season: header.season.year, week: header.week,
    note: gameNote, neutralSite: game.neutralSite,
    statusDescription,
    venueName: venue?.fullName,
    venueCity: venue?.address?.city,
    venueRegion: venue?.address?.state,
    venueCountry: venue?.address?.country,
};
const title = gameTitle(gameSpec);
const subtitle = gameDescription({ ...gameSpec, league });
const structuredData = jsonLdScript([sportsEventJsonLd({ ...gameSpec, league })]);
// one colour decision for the game (a light and a dark pair): team_info first, ESPN's header where team_info has none
const gameColors = isFeatureEnabled('game-colours', Astro.locals) ? pickGameColors([homeTeamSeason?.team, homeTeam], [awayTeamSeason?.team, awayTeam]) : undefined;

---

<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico">
        <link href="/assets/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
        <link href="/assets/css/base.css" rel="stylesheet">
        <link href="/assets/css/nav-header.css" rel="stylesheet">
        <link href="/assets/css/dark-game.css" rel="stylesheet">
        <link href="/assets/css/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
        { (isChampEvent) && (<link href="/assets/css/championship.css" rel="stylesheet" />) }

        <meta http-equiv="content-type" content="text/html; charset=UTF-8">
        <meta http-equiv="x-ua-compatible" content="IE=edge,chrome=1">
        <meta name="viewport" content="initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <meta name="referrer" content="origin-when-cross-origin">
        <link rel="canonical" href={canonicalUrl}>
        <title>{title}</title>
        <meta name="description" content={subtitle}>

        <meta property="og:site_name" content="GameOnPaper.com">
        <meta property="og:url" content={canonicalUrl}>
        <meta property="og:title" content={title}>
        <meta property="og:description" content={subtitle}>
        <meta property="og:image" content={`https://s.espncdn.com/stitcher/sports/football/${espnPath}/events/${game.id}.png?templateId=espn.com.share.1`}>
        <meta property="og:image:width" content="400">
        <meta property="og:image:height" content="400">
        <meta property="og:type" content="website">
        <meta name="twitter:site" content="@gameonpaper">
        <meta name="twitter:url" content={canonicalUrl}>
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={subtitle}>
        <meta name="twitter:card" content="summary">
        <meta name="twitter:image" content={`https://s.espncdn.com/stitcher/sports/football/${espnPath}/events/${game.id}.png?templateId=espn.com.share.1`}>
        <meta name="title" content={title}>
        <meta name="medium" content="website">
        <script type="application/ld+json" set:html={structuredData} />
        <!-- Privacy-friendly analytics by Plausible -->
        <script is:inline async src="https://plausible.io/js/pa-Gf0VImJGO-MTdGnypPP3i.js"></script>
        <script is:inline>
          window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
          plausible.init()
        </script>
        <DarkModeLogos teamIds={[homeTeam.id, awayTeam.id]} />
    </head>
    <body>
        <div class="container-fluid border-bottom">
            <GameHeader espnGame={espnGame} />
        </div>
        <div class="container-fluid">
            <div class="row my-3">
                <div class="col-lg-2 col-md-0">

                </div>
                <div class="col-lg-4 col-md-12 margin-override">
                    <TeamCard team={awayTeam} season={espnGame.gamepackageJSON.header.season.year} teamSeason={awayTeamSeason} summary={awaySummary} hideNavigation={false} />
                </div>
                <div class="col-lg-4 col-md-12">
                    <TeamCard team={homeTeam} season={espnGame.gamepackageJSON.header.season.year} teamSeason={homeTeamSeason} summary={homeSummary} hideNavigation={false} />
                </div>
            </div>
        </div>
        {
            (isFeatureEnabled('game-page-v2', Astro.locals)) && (
                <div class="container-fluid">
                    <GameEssentials summary={gameSummary} homeTeam={homeTeam} awayTeam={awayTeam} neutralSite={game.neutralSite} homeAdjEpa={homeSummary?.net_adj_epa} awayAdjEpa={awaySummary?.net_adj_epa} metricYear={summaryYear} />
                    <PlayersToWatch homeTeam={homeTeam} awayTeam={awayTeam} metricYear={gameSeason} />
                    <RecentForm summary={gameSummary} homeTeam={homeTeam} awayTeam={awayTeam} />
                </div>
            )
        }
        <MatchupView awayTeamSeason={awayTeamSeason} homeTeamSeason={homeTeamSeason} awayTeamSummary={awaySummary} homeTeamSummary={homeSummary} matchupHistory={matchupHistory} colors={gameColors} />
        <Footer />
    </body>
</html>