---
import { gameTitleParts, gameTitleText } from '../../utils/gameTitle';
import { leaguePath, type League } from '../../utils/league';

interface Props {
    awayTeam: any
    homeTeam: any
    /** null before kickoff: the title is then "away @ home" */
    awayScore?: string | number | null
    homeScore?: string | number | null
    links: boolean
    league?: League
    /** overrides the football-shaped team href (/team/<ESPN id>): a null result leaves that side plain text */
    hrefOf?: (team: any) => string | null
}
const { awayTeam, homeTeam, awayScore = null, homeScore = null, links, league, hrefOf } = Astro.props;
// the wording is gameTitleParts' (shared with the WP chart's export title); this file only adds the links
const t = gameTitleParts(awayTeam, homeTeam, awayScore, homeScore);
const teamHref = (t: any) => leaguePath(league, `/team/${t.id}`);
// a placeholder competitor (an unset bowl or playoff slot) has no team page: ESPN gives it a
// non-positive id ("-1", "-2"; "0" in older payloads) and the abbreviation "TBD", so that side stays plain text
const real = (t: any) => Number(t?.id) > 0 && t?.abbreviation !== 'TBD';
---
<h1 class="h2 mb-0">{hrefOf
    ? <Fragment>{hrefOf(awayTeam) ? <a class="text-reset" href={hrefOf(awayTeam)}>{t.away}</a> : t.away}{t.mid}{hrefOf(homeTeam) ? <a class="text-reset" href={hrefOf(homeTeam)}>{t.home}</a> : t.home}{t.tail}</Fragment>
    : links
    ? <Fragment>{real(awayTeam) ? <a class="text-reset" href={teamHref(awayTeam)}>{t.away}</a> : t.away}{t.mid}{real(homeTeam) ? <a class="text-reset" href={teamHref(homeTeam)}>{t.home}</a> : t.home}{t.tail}</Fragment>
    : gameTitleText(awayTeam, homeTeam, awayScore, homeScore)}</h1>
