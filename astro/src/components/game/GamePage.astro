---
import NavScroller, { type ScrollerItem } from '../../components/NavScroller.astro';
import { type ProcessedGame } from '../../resources/python';
import { GAME_PAGE_MANIFEST, evaluateManifest, salvageGame } from '../../utils/manifest';
import { gopStorage } from '../../utils/telemetry';
import { cleanLocation, isChampionshipEvent, deduplicateByKey } from '../../utils/misc';
import Panel from '../../layouts/panel/GenericPanel.astro';
import Scripts from '../Scripts.astro';
import PlaysTable from './plays/PlaysTable.astro';
import PlayFilters from './plays/PlayFilters.astro';
import PlayFocus from './plays/PlayFocus.astro';
import PlayMarkSprite from './plays/PlayMarkSprite.astro';
import { threeAndOutPlays } from '../../utils/playIcons';
import TeamPanel from '../../layouts/panel/TeamPanel.astro';
import PlayerBoxScore from './metrics/PlayerBoxScore.astro';
import PassingChart from './metrics/PassingChart.astro';
import RushingChart from './metrics/RushingChart.astro';
import PaperIndex from './metrics/PaperIndex.astro';
import Linescore from './metrics/Linescore.astro';
import DrivesTable from './drives/DrivesTable.astro';
import ExpectedPointsChart from '../charts/ExpectedPointsChart.svelte';
import WinProbabilityChart from '../charts/WinProbabilityChart.svelte';
import { retrievePercentiles } from '../../resources/sdv';
import DarkModeLogos from '../DarkModeLogos.astro';
import { PERCENTILE_YEAR } from '../../utils/constants';
import Footer from '../Footer.astro';
import "bootstrap-icons/font/bootstrap-icons.css";
import FallbackSpinner from '../FallbackSpinner.astro';
import { gameDescription, gameTitle, jsonLdScript, sportsEventJsonLd } from '../../utils/seo';
import { latestDriveSubtitle } from '../../utils/latestDrive';
import GameHeader from './GameHeader.astro';
import FilterGroup from '../../layouts/FilterGroup.astro';
import { LEAGUES, leaguePath, type League } from '../../utils/league';
import SituationalSection from './metrics/SituationalSection.svelte';
import SituationalSplits from './metrics/SituationalSplits.astro';
import UsageBoxScore from './metrics/UsageBoxScore.astro';
import { hasSituationalSplits, withoutUsageSections } from '../../utils/usage';

interface Props {
   id: string | number
   game: ProcessedGame
   league?: League
}

const { id, game } = Astro.props;
const league: League = Astro.props.league ?? Astro.locals.league ?? 'cfb';
const espnPath = LEAGUES[league].espnPath;

// Canonical is /game/<id>, the path actually served. /cfb/game/<id> also
// resolves (it 301s here), so advertising it as canonical pointed Google at a
// redirect and split signals between two URLs for the same page.
const canonicalUrl = new URL(leaguePath(league, `/game/${id}`), "https://gameonpaper.com").href

const gop = gopStorage.getStore();
if (gop) gop.game_id = String(id);
const verdict = evaluateManifest(GAME_PAGE_MANIFEST, game);
if (gop) {
    gop.render_outcome = verdict.outcome;
    gop.missing_datasets = verdict.missingNames.length ? verdict.missingNames : null;
}
// Components cannot Astro.rewrite() -- doing so aborts the stream and the
// page ships as an empty 200 (the 2026-09-07 delayed-game outage). Render
// the error page inline instead; the page-level router should normally have
// caught this state before the component ever mounted.
const requiredMissing = verdict.requiredMissing.length > 0;
if (requiredMissing && gop) gop.render_outcome = 'failed';
salvageGame(game);
// drive-shaped mark: flag the punt that ends a three-and-out so PlayMarks can render it per row
for (const n of threeAndOutPlays(game.plays)) { const p = game.plays.find((x: any) => x.game_play_number === n); if (p) (p as any).three_and_out = true; }

const fullGamePlays = game.plays;

const percentiles = await retrievePercentiles(PERCENTILE_YEAR, undefined, undefined, league);
const homeComp = game.header.competitions[0].competitors[0];
const awayComp = game.header.competitions[0].competitors[1];
const homeTeam = homeComp.team;
const awayTeam = awayComp.team;
const gameNote = game.header?.gameNote ?? "";
const isChampEvent = isChampionshipEvent(gameNote);
const gameStatus = game.header.competitions[0].status;

// Title/description/JSON-LD say what the page is (final, week, "EPA per play",
// "win probability") -- "Game: X, Y" and "Advanced stats for X vs Y" gave Google
// nothing to match a query against. Rendered names stay lowercased.
const hasScore = gameStatus.type.completed == true || gameStatus.type.name.includes("STATUS_IN_PROGRESS") || (gameStatus.type.name.includes("STATUS_DELAYED") && game.plays.length > 0);
const statusDescription = gameStatus.type.description ?? "Scheduled";
const gameSpec = {
    id, hasScore,
    away: cleanLocation(awayComp.team), home: cleanLocation(homeComp.team),
    awayName: awayComp.team.displayName, homeName: homeComp.team.displayName,
    awayId: awayTeam.id, homeId: homeTeam.id,
    awayScore: awayComp.score, homeScore: homeComp.score,
    date: game.header.competitions[0].date, season: game.season.year, week: game.header.week,
    note: game.header?.gameNote, neutralSite: game.header.competitions[0].neutralSite,
    statusDescription,
};
const title = gameTitle(gameSpec);
const subtitle = gameDescription({ ...gameSpec, league });
const structuredData = jsonLdScript([sportsEventJsonLd({ ...gameSpec, league })]);

const previewUrlParams = new URLSearchParams({
    homeSeason: String(game.season.year),
    awaySeason: String(game.season.year),
    homeTeamId: homeTeam.id,
    awayTeamId: awayTeam.id
})

// The top of the page answers "what just happened" before any chart does.
// Newest first here -- this strip is read downward as a feed, unlike All Plays.
// Live and halftime only: once the game is final the whole page is the recap,
// and a "Latest" strip repeating the last five plays is noise.
const latestPlays = gameStatus.type.completed === true ? [] : fullGamePlays.slice(-5).toReversed();
// Quarters actually played, so overtime only offers a button when it happened.
const periodsPlayed = [...new Set(game.plays.map((p: any) => Number(p.period)).filter(Number.isFinite))].sort((a, b) => a - b);
const lastPlay: any = game.plays.at(-1);
const gameState = game.header.competitions[0].status?.type?.state;
const latestSubtitle = latestDriveSubtitle(game.drives, lastPlay, gameState);

const scrollerItems: ScrollerItem[] = [
    // The Latest panel only renders when there are plays, so a game with none
    // must not advertise an anchor that isn't on the page.
    ...(latestPlays.length > 0 ? [{ href: "#latest", title: "Latest" }] : []),
    { href: "#wp-section", title: "WP Chart" },
    { href: "#ep-section", title: "EPA Chart" },
    ...((game.paperIndex && gameStatus.type.completed == true) ? [{ href: "#paper-index-panel", title: "Deserved Win %" }] : []),
    { href: "#team-stats-panel", title: "Team Stats" },
    // rendered only when the processor emitted the two-team usage sections
    ...(hasSituationalSplits(game.advBoxScore) ? [{ href: "#situational-splits-panel", title: "Situational & ST" }] : []),
    { href: "#player-stats", title: "Player Stats" },
    { href: "#big-plays-panel", title: "Big Plays" },
    { href: "#most-important-plays-panel", title: "Most Important Plays" },
    { href: "#scoring-plays-panel", title: "Scoring Plays" },
    { href: "#drives-panel", title: "Drives" },
    { href: "#all-plays-panel", title: "All Plays" },
    // the matchup preview reads the season tables; not offered for a league without them
    ...(LEAGUES[league].sdvEnabled ? [{ href: leaguePath(league, `/game/matchup?${previewUrlParams.toString()}`), title: "Matchup Preview" }] : []),
    { href: `https://www.espn.com/${espnPath}/game/_/gameId/${id}`, title: "Gamecast" },
];

const bigPlays = game.plays.toSorted((a, b) => {
    const diff = Math.abs(a.expectedPoints.added) - Math.abs(b.expectedPoints.added)
    if (diff < 0) {
        return 1
    } else if (diff > 0) {
        return -1
    } else {
        return 0
    }
}).slice(0, 10)

const mostImpPlays = game.plays.toSorted((a, b) => {
    const diff = Math.abs(a.winProbability.added) - Math.abs(b.winProbability.added)
    if (diff < 0) {
        return 1
    } else if (diff > 0) {
        return -1
    } else {
        return 0
    }
}).slice(0, 10)


let gameDrives = game.drives.current ? (game.drives.previous ?? []).concat([game.drives.current]) : (game.drives.previous ?? []);
gameDrives = deduplicateByKey(gameDrives, "id");
const epPlays = fullGamePlays.filter(p => (p.scrimmage_play == true)).map(p => {
    return {
        pos_team: p.pos_team, 
        expectedPoints: p.expectedPoints
    }
});
const wpPlays = fullGamePlays.filter(p => (p.scrimmage_play == true)).map(p => {
    return {
        pos_team: p.pos_team,
        period: p.period,
        winProbability: p.winProbability,
        gameSpreadAvailable: p.gameSpreadAvailable
    }
});
---
<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico">
        <link href="/assets/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
        <link href="/assets/css/base.css" rel="stylesheet">
        <link href="/assets/css/nav-header.css" rel="stylesheet">
        <link href="/assets/css/dark-game.css" rel="stylesheet">
        { (isChampEvent) && (<link href="/assets/css/championship.css" rel="stylesheet" />) }

        <meta http-equiv="content-type" content="text/html; charset=UTF-8">
        <meta http-equiv="x-ua-compatible" content="IE=edge,chrome=1">
        <meta name="viewport" content="initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <meta name="referrer" content="origin-when-cross-origin">
        <link rel="canonical" href={canonicalUrl}>
        <title>{title}</title>
        <meta name="description" content={subtitle}>

        <meta property="og:site_name" content="GameOnPaper.com">
        <meta property="og:url" content={canonicalUrl}>
        <meta property="og:title" content={title}>
        <meta property="og:description" content={subtitle}>
        <meta property="og:image" content={`https://s.espncdn.com/stitcher/sports/football/${espnPath}/events/${id}.png?templateId=espn.com.share.1`}>
        <meta property="og:image:width" content="400">
        <meta property="og:image:height" content="400">
        <meta property="og:type" content="website">
        <meta name="twitter:site" content="@gameonpaper">
        <meta name="twitter:url" content={canonicalUrl}>
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={subtitle}>
        <meta name="twitter:card" content="summary">
        <meta name="twitter:image" content={`https://s.espncdn.com/stitcher/sports/football/${espnPath}/events/${id}.png?templateId=espn.com.share.1`}>
        <meta name="title" content={title}>
        <meta name="medium" content="website">
        <script type="application/ld+json" set:html={structuredData} />
        <script defer is:inline crossorigin="anonymous" data-domain="gameonpaper.com" src="https://plausible.io/js/script.js"></script>
        <DarkModeLogos teamIds={[game.teamInfo.home.id, game.teamInfo.away.id]} />
    </head>
    <body>
        <PlayMarkSprite />
        <div class="container-fluid">
            <GameHeader game={game} />
        </div>
        {/* Outside the header container on purpose: position sticky only works
            while the PARENT is in view; inside the small header container the
            nav released after a single scroll (CodeRabbit, #208). At body
            level it sticks for the whole page. */}
        <div class="game-nav-sticky py-1 mb-3 border-top border-bottom"><NavScroller items={scrollerItems} /></div>
        <div class="container-fluid">
            {latestPlays.length > 0 && (
                <div class="row mb-2">
                    <div class="col-md-12 ms-sm-auto col-lg-12 px-md-4">
                        <Panel id="latest" title="Latest" show={true}>
                            <p class="text-small" slot="panel-subtitle">{latestSubtitle}</p>
                            <div class="row" slot="panel-body">
                                <PlaysTable plays={latestPlays} prefix="latest" expandable={false} />
                            </div>
                        </Panel>
                    </div>
                </div>
            )}
        </div>
        <div class="container-fluid">
            <div class="row mb-3">
                <!-- The nav anchor must NOT be wpChart/epChart: those ids belong to the canvases
     inside the Svelte charts, and a duplicate id makes getElementById hand
     Chart.js the wrapper div -- both charts then silently never draw. -->
                <div id="wp-section" class="col-lg-6 ms-sm-auto px-md-4">
                    <WinProbabilityChart client:only id={id} homeComp={homeComp} awayComp={awayComp} gameStatus={game.header.competitions[0].status} homeTeamSpread={game.homeTeamSpread} overUnder={game.overUnder} plays={wpPlays} percentiles={percentiles} gei={game.gei}>
                        <FallbackSpinner slot="fallback" />
                    </WinProbabilityChart>
                </div>
                <div id="ep-section" class="col-lg-6 ms-sm-auto px-md-4">
                    <ExpectedPointsChart client:only id={id} plays={epPlays} homeTeam={game.teamInfo.home} awayTeam={game.teamInfo.away}>
                        <FallbackSpinner slot="fallback" />
                    </ExpectedPointsChart>
                </div>
            </div>
            {
                (game.paperIndex && gameStatus.type.completed == true) && (
                    <div class="row mb-3">
                        <div class="col-md-12 ms-sm-auto col-lg-12 px-md-4">
                            <PaperIndex result={game.paperIndex} homeTeam={homeTeam} awayTeam={awayTeam} completed={gameStatus.type.completed == true} />
                        </div>
                    </div>
                )
            }
            <div class="row mb-3">
                <div class="col-md-12 ms-sm-auto col-lg-12 px-md-4">
                    <Panel id="team-stats" title="Team Stats" show={true}>
                        <SituationalSection slot="panel-body" client:only season={game.season.year} advBoxScoreSpans={withoutUsageSections(game.advBoxScoreSpans)} league={league} percentiles={percentiles}>
                            <FallbackSpinner slot="fallback" />
                        </SituationalSection>
                    </Panel>
                </div>
            </div>
            {hasSituationalSplits(game.advBoxScore) && (
            <div class="row mb-3">
                <div class="col-md-12 ms-sm-auto col-lg-12 px-md-4">
                    <Panel id="situational-splits" title="Situational & Special Teams" show={true}>
                        <div slot="panel-body">
                            <SituationalSplits box={game.advBoxScore} awayTeam={awayTeam} homeTeam={homeTeam} />
                        </div>
                    </Panel>
                </div>
            </div>
            )}
            <div id="player-stats" class="row mb-3">
                <div class="col-lg-6 ms-sm-auto px-md-4">
                    <TeamPanel id="away-stats-panel" season={game.season.year} team={awayTeam} show={false}>
                        <div class="row" slot="panel-body">
                            <PlayerBoxScore 
                                pass={game.advBoxScore.pass.filter(g => g.pos_team == parseInt(awayTeam.id))}
                                rush={game.advBoxScore.rush.filter(g => g.pos_team == parseInt(awayTeam.id))}
                                receiver={game.advBoxScore.receiver.filter(g => g.pos_team == parseInt(awayTeam.id))}
                                plays={game.plays}
                                teamId={parseInt(awayTeam.id)}
                                box={game.advBoxScore}
                                season={game.season?.year}
                            />
                            <UsageBoxScore box={game.advBoxScore} teamId={parseInt(awayTeam.id)} season={game.season?.year} />
                            <PassingChart plays={game.plays.filter(p => p.pos_team == parseInt(awayTeam.id))} />
                            <RushingChart plays={game.plays.filter(p => p.pos_team == parseInt(awayTeam.id))} />
                        </div>
                    </TeamPanel>
                </div>
                <div class="col-lg-6 ms-sm-auto px-md-4">
                    <TeamPanel id="home-stats-panel" season={game.season.year} team={homeTeam} show={false}>
                        <div class="row" slot="panel-body">
                            <PlayerBoxScore 
                                pass={game.advBoxScore.pass.filter(g => g.pos_team == parseInt(homeTeam.id))}
                                rush={game.advBoxScore.rush.filter(g => g.pos_team == parseInt(homeTeam.id))}
                                receiver={game.advBoxScore.receiver.filter(g => g.pos_team == parseInt(homeTeam.id))}
                                plays={game.plays}
                                teamId={parseInt(homeTeam.id)}
                                box={game.advBoxScore}
                                season={game.season?.year}
                            />
                            <UsageBoxScore box={game.advBoxScore} teamId={parseInt(homeTeam.id)} season={game.season?.year} />
                            <PassingChart plays={game.plays.filter(p => p.pos_team == parseInt(homeTeam.id))} />
                            <RushingChart plays={game.plays.filter(p => p.pos_team == parseInt(homeTeam.id))} />
                        </div>
                    </TeamPanel>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-lg-6 ms-sm-auto px-md-4">
                    <Panel id="big-plays" title="Big Plays" show={false}>
                        <p class="text-small" slot="panel-subtitle">As determined by absolute EPA.</p>
                        <div class="row" slot="panel-body">
                            {
                                (bigPlays.length == 0) && (<p class="text-center text-muted">No big plays in this game.</p>)
                            }
                            {
                                (bigPlays.length > 0) && (<PlaysTable plays={bigPlays} prefix='big-play' expandable={true} />)
                            }
                        </div>
                    </Panel>
                </div>
                <div class="col-lg-6 ms-sm-auto px-md-4">
                    <Panel id="most-important-plays" title="Most Important Plays" show={false}>
                        <p class="text-small" slot="panel-subtitle">As determined by absolute WPA.</p>
                        <div class="row" slot="panel-body">
                            {
                                (mostImpPlays.length == 0) && (<p class="text-center text-muted">No important plays in this game.</p>)
                            }
                            {
                                (mostImpPlays.length > 0) && (<PlaysTable plays={mostImpPlays} prefix='most-important-play' expandable={true} />)
                            }
                        </div>
                    </Panel>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-lg-6 mb-2 ms-sm-auto px-md-4">
                    <Panel id="scoring-plays" title="Scoring Plays" show={false}>
                        <div class="row" slot="panel-body">
                            <Linescore competitors={game.header.competitions[0].competitors} season={game.season.year} />
                            {
                                (game.scoringPlays.length == 0) && (<p class="text-center text-muted">No scoring plays in this game.</p>)
                            }
                            {
                                (game.scoringPlays.length > 0) && (<PlaysTable plays={game.scoringPlays} prefix='scoring-play' expandable={true} />)
                            }
                        </div>
                    </Panel>
                </div>
                <div class="col-lg-6 ms-sm-auto px-md-4">
                    <Panel id="drives" title="Drives" show={false}>
                        <div class="row" slot="panel-body">
                            {
                                (gameDrives.length == 0) && (<p class="text-center text-muted">{"No drives in this game"}</p>)
                            }
                            {
                                (gameDrives.length > 0) && <DrivesTable drives={gameDrives} gamePlays={game.plays} prefix='drives' expandable={true} homeTeam={game.teamInfo.home} awayTeam={game.teamInfo.away} isNeutralSite={game.header.competitions[0].neutralSite} showGuide={true} />
                            }
                        </div>
                    </Panel>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12 ms-sm-auto col-lg-12 px-md-4">
                    <Panel id="all-plays" title="All Plays" show={false}>
                        {
                            (gameStatus.type.completed != true) && (<p class="text-small" slot="panel-subtitle">Most recent plays first. Recent plays may have weird EPA/WPA results due to ESPN data weirdness.</p>)
                        }
                        <div class="row" slot="panel-body">
                            {
                                (game.plays.length == 0) && <p class="text-center text-muted">No plays in this game.</p>
                            }
                            {
                                (game.plays.length > 0) && (
                                    <div class="mt-2 d-flex flex-wrap justify-content-between">
                                        <PlayFilters target="all" periods={periodsPlayed} newestFirst={gameStatus.type.completed != true} />
                                    
                                        <PlayFocus target="all" plays={game.plays}
                                            teams={game.advBoxScore.team.map((t: any) => t.pos_team)}
                                            teamNames={{ [String(homeTeam.id)]: cleanLocation(homeTeam), [String(awayTeam.id)]: cleanLocation(awayTeam) }} />
                                    </div>
                                )
                            }
                            {
                                (game.plays.length > 0) && (gameStatus.type.completed != true) && (
                                    <PlaysTable plays={game.plays.toReversed()} prefix="all" expandable={true} caption="While this game is live, this page will auto-update every minute." showGuide={true} />
                                )
                            }
                            {
                                (game.plays.length > 0) && (gameStatus.type.completed == true) && (
                                    <PlaysTable plays={game.plays} prefix="all" expandable={true} showGuide={true} />
                                )
                            }
                        </div>
                    </Panel>
                </div>
            </div>
        </div>
        <Footer />
        <Scripts />
        {
            (game.plays.length > 0) && (gameStatus.type.completed != true) && (
                <script is:inline src="/assets/js/auto-update.js" />
            )
        }
    </body>
</html>