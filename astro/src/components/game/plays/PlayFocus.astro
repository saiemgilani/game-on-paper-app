---
import { buildPlayIndex, ROLE_LABEL, PLAY_TAGS } from '../../../utils/playFilterIndex';

interface Props {
    /** The `prefix` of the PlaysTable this drives. */
    target: string;
    plays: any[];
    periods: number[];
    /** Team ids, for grouping the player menu by side. */
    teams: (number | string)[];
    teamNames?: Record<string, string>;
    /** The order the table is rendered in: live games newest first, finished games in order. */
    newestFirst: boolean;
}
const { target, plays, periods, teams, teamNames = {}, newestFirst } = Astro.props;
const ix = buildPlayIndex(plays);
const nameOf = (id: string) => teamNames[String(id)] ?? `Team ${id}`;
const periodLabel = (p: number) => (p <= 4 ? `Q${p}` : "OT");
// One option per player-role, so "Cam Miller — dropbacks (63)" and "Cam Miller —
// carries (5)" are separate picks rather than one lump of everything he touched.
const options = ix.players.flatMap((p) =>
    (Object.keys(p.roles) as (keyof typeof ROLE_LABEL)[])
        .filter((r) => (p.roles[r] ?? 0) > 0)
        .map((r) => ({
            value: `r:${r}:${p.id}`,
            name: p.name,
            role: r,
            team: p.teamId,
            label: `${p.name} — ${ROLE_LABEL[r].toLowerCase()} (${p.roles[r]})`,
            n: p.roles[r] ?? 0,
        })))
    .sort((a, b) => b.n - a.n || a.label.localeCompare(b.label));
const byTeam = teams.map((t) => ({ id: String(t), opts: options.filter((o) => o.team === String(t)) }));
const tags = (Object.keys(PLAY_TAGS) as (keyof typeof PLAY_TAGS)[])
    .filter((t) => (ix.tagCounts[t] ?? 0) > 0);
---

{/* Either half is enough to be useful: an early-season game can carry no player ids
    at all yet still have penalties, scoring plays and turnovers worth isolating. */}
{(options.length > 0 || tags.length > 0 || periods.length > 0) && (
    <div class="d-flex flex-wrap gap-2 align-items-center mb-2 w-100" data-play-focus={target} data-index={JSON.stringify(ix.byPlay)}>
        <label class="text-small text-muted" for={`focus-${target}`}>Show only</label>
        <select id={`focus-${target}`} class="form-select form-select-sm" style="width:auto;min-width:250px">
            <option value="">Every play</option>
            {periods.length > 0 && (
                <optgroup label="Periods">
                    {
                        [...new Set(periods.map((p) => Math.min(p, 5)))].map((t) => (
                            <option value={`p:${Math.min(t)}`}>{periodLabel(Math.min(t))}</option>
                        ))
                    }
                </optgroup>
            )}
            {tags.length > 0 && (
                <optgroup label="Play type">
                    {tags.map((t) => <option value={`t:${t}`}>{PLAY_TAGS[t]} ({ix.tagCounts[t]})</option>)}
                </optgroup>
            )}
            {options.length > 0 && byTeam.filter((g) => g.opts.length).map((g) => (
                <optgroup label={nameOf(g.id)}>
                    {g.opts.map((o) => <option value={o.value} data-name={o.name} data-role={o.role} data-team={o.team}>{o.label}</option>)}
                </optgroup>
            ))}
        </select>
        <span class="text-small text-muted" data-focus-count={target}></span>
        {/* The reading-order toggle the quarter filter bar carried before this bar replaced it. */}
        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-order-toggle aria-pressed={String(newestFirst)}>
            {newestFirst ? "Newest first" : "Oldest first"}
        </button>
    </div>
)}

<script>
    // Deferred module, not `is:inline`: this renders above the table it drives, so an
    // inline script would look up a tbody that has not been parsed yet.
    import { pairRows } from '../../../utils/playFilters';

    // This dropdown is the ONLY way to focus the plays on a player (review on
    // #267): the advanced box score's names used to carry a second, jump-here
    // affordance beside the link to the player page, and two interactions on one
    // name is one too many. It lists every player-role in the game anyway.
    for (const bar of document.querySelectorAll<HTMLElement>('[data-play-focus]')) {
        const target = bar.dataset.playFocus;
        const body = document.querySelector<HTMLElement>(`[data-plays-body="${target}"]`);
        const sel = bar.querySelector('select');
        const out = document.querySelector<HTMLElement>(`[data-focus-count="${target}"]`);
        if (!body || !sel) continue;

        let index: Record<string, string[]> = {};
        try { index = JSON.parse(bar.dataset.index || '{}'); } catch { index = {}; }

        // Rows come in [summary, detail] pairs; both must move together or a detail
        // row ends up under a play it does not belong to.
        const pairs = pairRows([...body.children] as HTMLElement[], (row) => row.classList.contains('accordion-body'));
        const keyOf = (pair: HTMLElement[]) => {
            const href = pair[0].getAttribute('href') || '';
            const m = href.match(/-(\d+)$/);
            return m ? m[1] : '';
        };

        sel.addEventListener('change', () => {
            const want = sel.value;
            let shown = 0;
            for (const pair of pairs) {
                const ok = !want || (index[keyOf(pair)] || []).includes(want);
                if (ok) shown++;
                // Inline display, not a class or attribute needing a stylesheet: if the
                // CSS failed to load the filter would silently do nothing.
                for (const row of pair) row.style.display = ok ? '' : 'none';
            }
            if (out) out.textContent = want ? `${shown} of ${pairs.length} plays` : '';
        });

        // Reordering moves whole pairs and never touches `display`, so it composes with
        // the filter above: a hidden play stays hidden wherever it lands.
        const toggle = bar.querySelector<HTMLButtonElement>('[data-order-toggle]');
        toggle?.addEventListener('click', () => {
            pairs.reverse();
            for (const pair of pairs) for (const row of pair) body.appendChild(row);
            const newestFirstNow = toggle.getAttribute('aria-pressed') !== 'true';
            toggle.setAttribute('aria-pressed', String(newestFirstNow));
            toggle.textContent = newestFirstNow ? 'Newest first' : 'Oldest first';
        });
    }
</script>
