---
import type { ProcessedPlay } from '../../../resources/python'
import ExpandedPlayRow from './ExpandedPlayRow.astro'
import PlayRow from './PlayRow.astro'
import { PLAY_ICON_LABEL, PLAY_ICON_LEGEND, PLAY_PILL_TEXT } from '../../../utils/playIcons'


interface Props {
    plays: ProcessedPlay[]
    prefix: string
    expandable: boolean
    caption?: string
    showGuide?: boolean
}

const { plays, prefix, expandable, caption, showGuide } = Astro.props;

---

<div class="table table-responsive">
    <table class="table table-sm table-responsive" style="border-collapse:collapse;">
        {
            (caption && !showGuide) && (
                <caption>{caption}</caption>
            )
        }
        {
            (caption && showGuide) && (
                <caption>
                <span class="mb-1">{caption}</span>
                <div>
                    <p class="mb-0">Play shading guide:</p>
                    <ul>
                        <li><strong class="text-warning">Yellow</strong> - penalty</li>
                        <li><strong class="text-danger">Red</strong> - turnover</li>
                        <li><strong class="text-success">Green</strong> - scoring play</li>
                        <li class="play-marks-legend">Marks - {PLAY_ICON_LEGEND.map((id) => (<span class="me-2 text-nowrap">{PLAY_PILL_TEXT[id] ? <span class={`pi-pill pi-${id}`} aria-hidden="true">{PLAY_PILL_TEXT[id]}</span> : <svg class={`pi pi-${id}`} aria-hidden="true"><use href={`#pi-${id}`} /></svg>} {PLAY_ICON_LABEL[id].toLowerCase()}</span>))}</li>
                    </ul>
                </div>
                </caption>
            )
        }
        {
            (!caption && showGuide) && (
                <caption>
                <div>
                    <p class="mb-0">Play shading guide:</p>
                    <ul>
                        <li><strong class="text-warning">Yellow</strong> - penalty</li>
                        <li><strong class="text-danger">Red</strong> - turnover</li>
                        <li><strong class="text-success">Green</strong> - scoring play</li>
                        <li class="play-marks-legend">Marks - {PLAY_ICON_LEGEND.map((id) => (<span class="me-2 text-nowrap">{PLAY_PILL_TEXT[id] ? <span class={`pi-pill pi-${id}`} aria-hidden="true">{PLAY_PILL_TEXT[id]}</span> : <svg class={`pi pi-${id}`} aria-hidden="true"><use href={`#pi-${id}`} /></svg>} {PLAY_ICON_LABEL[id].toLowerCase()}</span>))}</li>
                    </ul>
                </div>
                </caption>
            )
        }
        <thead>
            <tr>
                <th style="text-align: left;">Time</th>
                <th class="play-offense-col" style="text-align: center;">Offense</th>
                <th style="text-align: left;">Play Description</th>
                <th style="text-align: center;">EPA</th>
                <th style="text-align: center;">WP%</th>
                <th style="text-align: right;">WPA</th>
            </tr>
        </thead>
        <tbody>
            {
                (plays.map(p => (
                    <PlayRow play={p} expandable={expandable} prefix={prefix}>
                        <ExpandedPlayRow play={p} slot="expandable-row-content"/>
                    </PlayRow>
                )))
            }
        </tbody>
    </table>
</div>