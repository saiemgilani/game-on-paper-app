---
import { PLAY_ICON_LABEL, PLAY_PILL_TEXT, playIcons } from '../../../utils/playIcons';

interface Props { play: any; size?: number }
const { play, size } = Astro.props;
const ids = playIcons(play);
---
{ids.length > 0 && (
    <span class="play-marks" style={size ? `font-size:${size}px` : undefined}>
        {ids.map((id) => PLAY_PILL_TEXT[id]
            ? <span class={`pi-pill pi-${id}`} role="img" aria-label={PLAY_ICON_LABEL[id]}>{PLAY_PILL_TEXT[id]}</span>
            : <svg class={`pi pi-${id}`} role="img" aria-label={PLAY_ICON_LABEL[id]}><title>{PLAY_ICON_LABEL[id]}</title><use href={`#pi-${id}`} /></svg>
        )}
    </span>
)}
