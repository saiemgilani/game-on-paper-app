---
import type { ESPNBroadcast, ESPNCompetition, ESPNGeoBroadcast, ESPNScheduleEvent, ESPNStatus } from '../../resources/espn'
import { isESPNNetwork, NETWORK_MAPPINGS } from '../../utils/constants';

interface Props {
  game: ESPNCompetition
}

const { game } = Astro.props;
let actionPrefix: string | null = 'Watch';

if (game.status.type.completed == true) {
    actionPrefix = 'Replay';
} else {
    actionPrefix = 'Watch';
}

let networkName: string | null = null;
const geoBroadcasts = ((game.geoBroadcasts) || []).filter((g: ESPNGeoBroadcast) => ["1", "4"].includes(g.type.id)); // only look at TV & streaming
if (geoBroadcasts.length > 0) {
    networkName = geoBroadcasts[0].media.shortName;
} else if ((game.broadcasts?.length ?? 0) > 0) {
    networkName = game.broadcasts![0].media?.shortName || null;
}

const networkMapping = networkName ? NETWORK_MAPPINGS[networkName] : null;
const networkURL = (isESPNNetwork(networkName)) ? `https://www.espn.com/watch/player/_/eventCalendarId/${game.id}` : networkMapping;

---

<Fragment>
    {
        (networkURL) && <a class="btn btn-sm btn-outline-secondary p-2" role="button" target="_blank" href={networkURL}>{`${actionPrefix} (${networkName})`}</a>
    }
</Fragment>