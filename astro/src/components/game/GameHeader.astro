---
import { DateTime } from 'luxon';
import { EMPTY_ESPN_COMPETITION, type ESPNPlayByPlayResponse } from '../../resources/espn';
import type { ProcessedGame } from '../../resources/python';
import { isChampionshipEvent } from '../../utils/misc';
import { leaguePath } from '../../utils/league';
import LocalDate from '../LocalDate.svelte';
import WatchButton from './WatchButton.astro';
import AdminGameTools from './AdminGameTools.astro';
import GameTitle from './GameTitle.astro';
import { isFeatureEnabled } from '../../utils/features';

interface Props {
   espnGame?: ESPNPlayByPlayResponse
   game?: ProcessedGame
}

const { game, espnGame } = Astro.props;

const espnHeader = game?.header || espnGame?.gamepackageJSON.header;
const espnComp = espnHeader?.competitions[0] || EMPTY_ESPN_COMPETITION;

const homeComp = espnComp.competitors[0];
const awayComp = espnComp.competitors[1];
const homeTeam = homeComp.team;
const awayTeam = awayComp.team;
const gameNote = espnHeader?.gameNote ?? "";
const isChampEvent = isChampionshipEvent(gameNote);
const gameStatus = espnComp.status;
const statusDetail = gameStatus.type.detail;
const statusDescription = gameStatus.type.description ?? "Scheduled";
const isGameInactive = (gameStatus.type.completed == true || statusDescription.includes("Cancel") || statusDescription.includes("Postpone") || statusDescription.includes("Delay") || statusDescription.includes("Schedule"))

const gameDate = espnComp.date;

const league = Astro.locals.league;
const links = isFeatureEnabled('game-links', Astro.locals);
const scheduled = statusDescription.includes("Schedule");
const season = espnHeader?.season;
// the game's own week when linking is on; the scoreboard (today's week) otherwise
const backHref = (links && season?.year && espnHeader?.week != null)
    ? leaguePath(league, `/year/${season.year}/type/${season.type}/week/${espnHeader.week}`)
    : leaguePath(league, "/");

---

<div class="py-3">
    <header class="blog-header d-none d-lg-inline">
        <div class="row d-flex flex-wrap justify-content-between align-items-center">
            <div class="col-2 pt-1">
                <a class="btn btn-sm btn-outline-primary align-middle" href={backHref}><i class="bi-arrow-left"></i></a>
            </div>
            <div class="col-8 text-center">
                <div>
                    <GameTitle awayTeam={awayTeam} homeTeam={homeTeam} awayScore={scheduled ? null : awayComp.score} homeScore={scheduled ? null : homeComp.score} links={links} league={league} />
                    {
                        (gameNote != "") && <p class={`text-small mt-0 mb-3 ${isChampEvent ? "championship-text" : "text-primary"}`}><strong>{gameNote}</strong></p>
                    }
                    {
                        (isGameInactive) && <LocalDate client:only divClass="text-small m-0" date={gameDate} format={DateTime.DATETIME_FULL} prefix={statusDescription} />
                    }
                    {
                        (!isGameInactive) && <p class="text-small m-0">{`LIVE - ${statusDetail}`}</p>
                    }
                </div>
            </div>
            <div class="col-2 d-flex justify-content-end align-items-center">
                <WatchButton game={espnComp} />
            </div>
        </div>
    </header>
    <header class="blog-header d-inline d-lg-none">
        <div class="row mb-3">
            <div class="col-12 text-center">
                <div>
                    <GameTitle awayTeam={awayTeam} homeTeam={homeTeam} awayScore={scheduled ? null : awayComp.score} homeScore={scheduled ? null : homeComp.score} links={links} league={league} />
                    {
                        (gameNote != "") && <p class={`text-small mt-0 mb-3 ${isChampEvent ? "championship-text" : "text-primary"}`}><strong>{gameNote}</strong></p>
                    }
                    {
                        (isGameInactive) && <LocalDate client:only divClass="text-small m-0" date={gameDate} format={DateTime.DATETIME_FULL} prefix={statusDescription} />
                    }
                    {
                        (!isGameInactive) && <p class="text-small m-0">{`LIVE - ${statusDetail}`}</p>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <a class="btn btn-sm btn-outline-primary align-middle p-2" href={backHref}><i class="bi-arrow-left"></i> Back to Scoreboard</a>
            </div>
            <div>
                <WatchButton game={espnComp} />
            </div>
        </div>
    </header>
    {/* Written once here because BOTH game-page twins (components/game and the
        frozen components/game/classic) import this header, so the admin tools
        appear whichever one renders and an admin can flip between them. */}
    <AdminGameTools game={game} />
</div>