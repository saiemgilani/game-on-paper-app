---
// export const prerender = true;

import TeamTrendsChart from "../../components/charts/TeamTrendsChart.svelte";
import { espnLogoLeague } from '../../utils/league';
import GenericPage, { type PageBreadcrumb } from "../../layouts/GenericPage.astro";
import { cleanLocation, retrieveValue, roundNumber, generateColorRampValue, cleanField, formatRank, teamColorHex, yearRange } from "../../utils/misc";
import type { SDVTeamSummary } from "../../resources/sdv";
import TeamRadarChart from "../../components/charts/TeamRadarChart.svelte";
import DarkModeLogos from "../../components/DarkModeLogos.astro";
import FallbackSpinner from '../../components/FallbackSpinner.astro';
import { leaguePath, teamCountOf } from "../../utils/league";
import type { TeamProfileData } from "../../routes/teamProfile";
import TeamPlayerTable from "../../components/team/tables/TeamPlayerTable.astro";
import { isFeatureEnabled } from "../../utils/features";
import { bestSeasons, coachEras, conferenceSpans } from "../../utils/teamHub";
import { formatSeasonSpan } from "../../utils/coaches";

// Route component: routes/teamProfile.ts (per-league page) read ESPN + the
// season tables and made the not-found decision; this renders.
type Props = TeamProfileData;
const { league, id, team, percentiles: allPctls, teamSummaries, seasonBands, coachSeasons } = Astro.props;
// the flag's prop reaches the island only for a viewer the flag admits, so the public island is unchanged
const bandProps = seasonBands ? { seasonBands } : {};

const breadcrumbs: PageBreadcrumb[] = [
    {
        title: "Teams",
        url: leaguePath(league, "/teams"),
        active: false
    },
    {
        title: cleanLocation(team),
        active: true
    }
]

const teamData = teamSummaries.sort((a,b) => a.season - b.season).map((t:any) => {
    t.color = team.color
    t.alternateColor = team.alternateColor
    t.teamName = cleanField(team, "pos_team")
    return t
})
const range = yearRange(teamData.map(b => b.season))

function createSeasonColumn(summary: SDVTeamSummary, key: string): string {
    const val = roundNumber(retrieveValue(summary, key), 2, 2)
    const rank = retrieveValue(summary, `${key}_rank`)

    const colorRampClass = generateColorRampValue(parseInt(rank), teamCountOf(summary, league), true)
    const rankStr = formatRank(parseInt(rank))
    return `
    <td class="numeral ${colorRampClass}" style="text-align: center;">${val} <small class="align-self-center" style="opacity: 50%">#${rankStr}</small></td>
    `
}

function createSeasonRow(summary: SDVTeamSummary): string {
    const cols = ["net_adj_epa", "EPAplay_margin", "adj_off_epa", "EPAplay_off", "adj_def_epa", "EPAplay_def"].map(x => createSeasonColumn(summary, x)).join("")
    return `
    <tr>
        <td><a href="${leaguePath(league, `/year/${summary.season}/team/${team.id}`)}">${summary.season}</a></td>
        ${cols}
    </tr>
    `
}

// 'team-hub': history tables under Seasons, the same six metrics as the Seasons table
const hub = isFeatureEnabled('team-hub', Astro.locals);
const HUB_METRICS: Record<string, string> = {
    net_adj_epa: "Net Adj EPA/Play",
    EPAplay_margin: "Net EPA/Play",
    adj_off_epa: "Off Adj EPA/Play",
    EPAplay_off: "Off EPA/Play",
    adj_def_epa: "Def Adj EPA/Play",
    EPAplay_def: "Def EPA/Play",
};
const best = hub ? bestSeasons(teamData, Object.keys(HUB_METRICS)) : [];
const eras = hub ? coachEras(coachSeasons ?? []) : [];
// CFB only: nfl team_summaries carries today's conference and division on every season
// (Seattle is NFC West in 1999), so it has no realignment history to show
const spans = hub && league === 'cfb' ? conferenceSpans(teamData) : [];

// Astro.response.headers.set('Cache-Control', `public, max-age=${24 * 60 * 60}`);
---

<GenericPage title={`${cleanLocation(team)} | EPA per play & advanced stats, ${range} | Game on Paper`} subtitle={`Team level metric history`} description={`${cleanLocation(team)} ${league === 'nfl' ? 'NFL' : 'college football'} advanced stats by season: offensive and defensive EPA per play, success rate, explosiveness and win probability, ${range}.`} slug={leaguePath(league, `/team/${team.id}`)} breadcrumbs={breadcrumbs}>
    <DarkModeLogos teamIds={[team.id]} />
    <div class="container">
        <div class="row mb-3">
            <div class="col-lg-6 col-xs-12 mb-xs-3">
                <h1 class="d-flex"><img class={`img-fluid team-logo-${team.id} me-2`} width="50px" src={`https://a.espncdn.com/i/teamlogos/${espnLogoLeague(league)}/500/${team.id}.png`} alt={`ESPN team id ${team.id}`}/> <span class="ms-1">{cleanLocation(team)}</span></h1>
                <p class="m-0 text-muted"><strong>Available Seasons:</strong> {range}{league === 'cfb' && " - Data shown is from FBS vs FBS games only."}{league === 'nfl' && " - Regular season games only."}</p>
                <!-- <p class="m-0 text-muted text-small game-context">Last updated: <abbr title="If this is more than one week out of date during the season, please let us know at @gameonpaper.com on BlueSky."><span class="game-date">{SummaryModel.last_updated}</span></abbr></p> -->
            </div>
            <div class="col-lg-6 col-xs-12 mb-xs-3">
                <p class="m-0 mb-2 text-muted text-small">Data from <a href="https://www.sportsdataverse.org">Sportsdataverse</a>, may differ from ESPN due to data availability/quality. Note: other than for Adj EPA/Play, metrics are <strong>not</strong> adjusted for quality of opponent or garbage time.</p>
                <p class="m-0 mb-2 text-muted text-small">Adj EPA/Play methodology adapted from <a href="https://makennnahack.github.io/makenna-hack.github.io/publications/opp_adj_rank_project/">this article</a> by <a href="https://twitter.com/makennnahack">Makenna Hack</a> and <a href="https://blog.collegefootballdata.com/opponent-adjusted-stats-ridge-regression/">this article</a> from <a href="https://twitter.com/jbuddavis">Bud Davis</a>, accounting for home-field advantage, quality of opponent, and garbage time.{league === 'cfb' && " Only considers FBS vs FBS games -- as a result, adj EPA/Play and normal EPA/Play numbers may differ significantly until all teams have played multiple FBS vs FBS games."}</p>
            </div>
        </div>
    </div>
    <TeamTrendsChart client:only title={cleanLocation(team)} teamColor={teamColorHex(team.color)} teamData={teamData} percentiles={allPctls} {...bandProps}>
        <FallbackSpinner slot="fallback" />
    </TeamTrendsChart>
    <TeamRadarChart client:only team={team} teamData={teamData} showSeasonPicker={true} league={league}>
        <FallbackSpinner slot="fallback" />
    </TeamRadarChart>
    <div class="container mb-3">
        <div class="row mb-3">
            <div class="col-12">
                <h2 class="d-inline">Seasons</h2>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-sm table-responsive">
                        <thead>
                            <th class="text-left" colspan="1">Season</th>
                            <th class="text-center" colspan="1">Net Adj EPA/Play (Rk)</th>
                            <th class="text-center" colspan="1">Net EPA/Play (Rk)</th>
                            <th class="text-center" colspan="1">Off Adj EPA/Play (Rk)</th>
                            <th class="text-center" colspan="1">Off EPA/Play (Rk)</th>
                            <th class="text-center" colspan="1">Def Adj EPA/Play (Rk)</th>
                            <th class="text-center" colspan="1">Def EPA/Play (Rk)</th>
                        </thead>
                        <tbody>
                            {
                                teamData.map(t => <Fragment set:html={createSeasonRow(t)} />)
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {best.length > 0 && (
        <div class="container mb-3">
            <TeamPlayerTable id="best-seasons" title="Best Seasons" show={true} population={false}>
                <Fragment slot="header">
                    <th class="text-left" colspan="1">Metric</th>
                    <th class="text-center" colspan="1">Season</th>
                    <th class="text-center" colspan="1">Value (Rk)</th>
                </Fragment>
                <Fragment slot="rows">
                    {best.map(({ metric, row }) => (
                        <tr>
                            <td class="text-left text-nowrap">{HUB_METRICS[metric]}</td>
                            <td class="text-center"><a href={leaguePath(league, `/year/${row.season}/team/${team.id}`)}>{row.season}</a></td>
                            <Fragment set:html={createSeasonColumn(row, metric)} />
                        </tr>
                    ))}
                </Fragment>
            </TeamPlayerTable>
        </div>
    )}
    {eras.length > 0 && (
        <div class="container mb-3">
            <TeamPlayerTable id="head-coaches" title="Head Coaches" show={true} population={false}>
                <Fragment slot="header">
                    <th class="text-left text-nowrap" colspan="1">Head Coach</th>
                    <th class="text-center" colspan="1"><abbr title="First to last season as head coach (seasons)">Seasons</abbr></th>
                    <th class="text-center" colspan="1"><abbr title="Games as head coach">Games</abbr></th>
                </Fragment>
                <Fragment slot="rows">
                    {eras.map((era) => (
                        <tr>
                            <td class="text-left text-nowrap"><strong>{cleanField({ ...era, pos_team_id: team.id }, "coach")}</strong></td>
                            <td class="numeral text-center text-nowrap">{formatSeasonSpan(era)}</td>
                            <td class="numeral text-center">{era.games}</td>
                        </tr>
                    ))}
                </Fragment>
            </TeamPlayerTable>
        </div>
    )}
    {spans.length > 0 && (
        <div class="container mb-3">
            <TeamPlayerTable id="conference-history" title="Conference History" show={true} population={false}>
                <Fragment slot="header">
                    <th class="text-left text-nowrap" colspan="1">Conference</th>
                    <th class="text-center" colspan="1">Seasons</th>
                </Fragment>
                <Fragment slot="rows">
                    {spans.map((s) => (
                        <tr>
                            <td class="text-left text-nowrap">{s.conference}</td>
                            <td class="numeral text-center text-nowrap">{formatSeasonSpan(s)}</td>
                        </tr>
                    ))}
                </Fragment>
            </TeamPlayerTable>
        </div>
    )}
</GenericPage>
