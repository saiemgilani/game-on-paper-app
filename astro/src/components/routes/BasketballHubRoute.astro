---
// BB-G47's league hub (/<league> behind 'bball-hub'): today's games from the scoreboard's read, in Live / Upcoming / Final
// sections, each card with its market line where game_lines has the game, then the index of the league's pages.
// BB-G48 / BB-G49 sections go between the games and the index.
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import NbaGameCard from '../nba/NbaGameCard.astro';
import { darkLogoCss, hasEspnLogo, statusSections } from '../../nba/scoreboard';
import { hubTags } from '../../basketball/hub';
import type { BasketballHubParams } from '../../routes/basketball/hub';
import { basketball } from '../../basketball/config';
import { LEAGUES, leaguePath } from '../../utils/league';

interface Props { data: BasketballHubParams }
const { board, lines, index } = Astro.props.data;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const name = LEAGUES[league].shortName;
const lp = (p: string) => leaguePath(league, p);
const breadcrumbs: PageBreadcrumb[] = [{ title: name, active: true }];
const darkCss = darkLogoCss(board.games.flatMap((g) => g.competitions[0].competitors.filter((c) => hasEspnLogo(c, league)).map((c) => ({ id: c.id, abbreviation: c.team?.abbreviation, season: g.season?.year }))), cfg.darkLogo);
const sections = statusSections(board.games);
// as the scoreboard: the live board names its day when that day is not tonight; a failed read names none
const heading = board.degraded && !board.isLive ? "Today's games" : board.isLive && !board.offDay ? 'Tonight' : board.nav.label;
const subtitle = `${name} games today with the market line and win probability, and every ${name} page on Game on Paper.`;
---
<GenericPage title={`${name} | Game on Paper`} subtitle={subtitle} slug={lp('/')} breadcrumbs={breadcrumbs} description={subtitle} canonicalPath={lp('/')}>
  <div class="container">
    <section aria-labelledby="hub-games-heading" id="hub-games">
      <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
        <h1 id="hub-games-heading" class="h3 mb-0">{heading}</h1>
        <a href={lp('/scoreboard')}>Full scoreboard &rarr;</a>
      </div>
      {board.groupLabel && !board.fallbackNote && <p class="text-muted small mb-1">{board.groupLabel} games</p>}
      {board.degraded && board.games.length === 0 && <p class="text-muted">The scoreboard is unavailable right now. Please try again shortly.</p>}
      {board.stale && board.games.length > 0 && <p class="text-muted small">Live scores are temporarily unavailable. These are the last saved scores for {board.nav.label}.</p>}
      {!board.degraded && board.games.length === 0 && <p class="text-muted">No games scheduled.</p>}
      {board.fallbackNote && <p class="text-muted">{board.fallbackNote}</p>}
      {sections.map((s) => (
        <section id={`hub-${s.key}`} aria-labelledby={`hub-${s.key}-heading`}>
          <h2 id={`hub-${s.key}-heading`} class="h5 mt-3">{s.label}</h2>
          <div class="row">{s.events.map((g) => {
            const l = lines[g.id];
            const tags = hubTags(g.competitions[0]);
            return (
              <NbaGameCard game={g}>
                {(l || tags.length > 0) && (
                  <p class="small mb-3 hub-line" data-hub-line={g.id}>
                    {l?.spread && <span class="d-block">Line: {l.spread}{l.total !== null && `, O/U ${l.total}`}</span>}
                    {!l?.spread && l?.total != null && <span class="d-block">O/U {l.total}</span>}
                    {l?.wp && <span class="d-block">Market, pregame: {l.wp} to win</span>}
                    {(l?.cover || l?.upset) && <span class="d-block">{[l.upset && 'Upset', l.cover].filter(Boolean).join(' · ')}</span>}
                    {tags.length > 0 && <span class="d-block text-muted">{tags.join(' · ')}</span>}
                  </p>
                )}
              </NbaGameCard>
            );
          })}</div>
        </section>
      ))}
    </section>
    <section aria-labelledby="hub-index-heading" id="hub-index" class="mt-4">
      <h2 id="hub-index-heading" class="h4">{name} pages</h2>
      <ul class="list-unstyled row">
        {index.map((p) => (
          <li class="col-md-6 col-xl-4 mb-3">
            <a href={lp(p.path)} class="fw-semibold">{p.label}</a>
            {p.blurb && <span class="d-block small text-muted">{p.blurb}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>
  {darkCss && <style set:html={`@media (prefers-color-scheme: dark){${darkCss}}`}></style>}
  <script is:inline>
    (() => {
      try {
        document.querySelectorAll('[data-gb-utc]').forEach((el) => {
          const d = new Date(el.getAttribute('data-gb-utc'));
          if (isNaN(d.getTime())) return;
          el.textContent = new Intl.DateTimeFormat([], { hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).format(d);
        });
      } catch { /* the ISO server text stands */ }
    })();
  </script>
</GenericPage>
