---
// BB-G47's league hub (/<league> behind 'bball-hub'): today's games from the scoreboard's read, in Live / Upcoming / Final
// sections, each card with its market line where game_lines has the game, then the index of the league's pages.
// BB-G48 / BB-G49 sections go between the games and the index.
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import NbaGameCard from '../nba/NbaGameCard.astro';
import { darkLogoCss, dayNav, hasEspnLogo, statusSections } from '../../nba/scoreboard';
import { hubTags } from '../../basketball/hub';
import { gameHref } from '../../nba/links';
import { cleanAbbreviation } from '../../utils/misc';
import type { BasketballHubParams } from '../../routes/basketball/hub';
import { basketball, seasonLabelFor } from '../../basketball/config';
import { LEAGUES, leaguePath } from '../../utils/league';

interface Props { data: BasketballHubParams }
const { board, lines, index, tonight, dashboards } = Astro.props.data;
// BB-G49: the follow picker's data, safe inside a <script> element (no "</" can close it)
const followJson = dashboards ? JSON.stringify(dashboards.follow).replace(/</g, '\\u003c') : '';
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const name = LEAGUES[league].shortName;
const lp = (p: string) => leaguePath(league, p);
const breadcrumbs: PageBreadcrumb[] = [{ title: name, active: true }];
const darkCss = darkLogoCss(board.games.flatMap((g) => g.competitions[0].competitors.filter((c) => hasEspnLogo(c, league)).map((c) => ({ id: c.id, abbreviation: c.team?.abbreviation, season: g.season?.year }))), cfg.darkLogo);
const sections = statusSections(board.games);
// as the scoreboard: the live board names its day when that day is not tonight; a failed read names none
const heading = board.degraded && !board.isLive ? "Today's games" : board.isLive && !board.offDay ? 'Tonight' : board.nav.label;
const subtitle = `${name} games today with the market line and win probability, and every ${name} page on Game on Paper.`;
---
<GenericPage title={`${name} | Game on Paper`} subtitle={subtitle} slug={lp('/')} breadcrumbs={breadcrumbs} description={subtitle} canonicalPath={lp('/')}>
  <div class="container">
    {dashboards && dashboards.follow.length > 0 && (
      <section aria-labelledby="hub-follow-heading" id="hub-follow" class="mb-3" data-league={league}>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <h2 id="hub-follow-heading" class="h5 mb-0">Your team</h2>
          <select id="hub-follow-pick" class="form-select form-select-sm w-auto" aria-label={`Follow a ${name} team`}>
            <option value="">Pick a team to follow</option>
            {dashboards.follow.map((t) => <option value={t.id}>{t.name}</option>)}
          </select>
          <span class="small text-muted">Kept in this browser only.</span>
        </div>
        <div id="hub-follow-card" class="mt-2" hidden></div>
        <script type="application/json" id="hub-follow-data" set:html={followJson}></script>
        <script is:inline>
          (() => {
            try {
              const sec = document.getElementById('hub-follow');
              const pick = document.getElementById('hub-follow-pick');
              const card = document.getElementById('hub-follow-card');
              const teams = new Map(JSON.parse(document.getElementById('hub-follow-data').textContent).map((t) => [t.id, t]));
              const key = 'gop-follow-' + sec.dataset.league;
              const store = (fn) => { try { return fn(window.localStorage); } catch { return null; } };
              const day = (d) => new Intl.DateTimeFormat([], { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(d + 'T12:00:00Z'));
              const el = (tag, text, attrs) => { const e = document.createElement(tag); if (text) e.textContent = text; Object.assign(e, attrs || {}); return e; };
              const game = (label, g) => {
                const p = el('p', null, { className: 'mb-1 small' });
                p.append(el('span', label + ': ', { className: 'text-muted' }));
                if (!g) { p.append('none on the schedule'); return p; }
                p.append(el('a', (g.result ? g.result + ' ' : '') + (g.home ? 'vs ' : 'at ') + g.opp, { href: '/' + sec.dataset.league + '/game/' + g.id }), ', ' + day(g.date));
                return p;
              };
              const show = (id) => {
                const t = teams.get(id);
                card.replaceChildren();
                card.hidden = !t;
                if (!t) return;
                const head = el('p', null, { className: 'mb-1' });
                head.append(t.href ? el('a', t.name, { href: t.href, className: 'fw-semibold' }) : el('span', t.name, { className: 'fw-semibold' }));
                const facts = [t.record, t.rank].filter(Boolean).join(', ');
                if (facts) head.append(' ', el('span', facts, { className: 'text-muted' }));
                card.append(head, game('Last game', t.last), game('Next game', t.next));
              };
              const saved = store((s) => s.getItem(key));
              if (saved && teams.has(saved)) { pick.value = saved; show(saved); }
              pick.addEventListener('change', () => {
                store((s) => (pick.value ? s.setItem(key, pick.value) : s.removeItem(key)));
                show(pick.value);
              });
            } catch { /* no script, no storage or no data: the picker stands without a card */ }
          })();
        </script>
      </section>
    )}
    <section aria-labelledby="hub-games-heading" id="hub-games">
      <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
        <h1 id="hub-games-heading" class="h3 mb-0">{heading}</h1>
        <a href={lp('/scoreboard')}>Full scoreboard &rarr;</a>
      </div>
      {board.groupLabel && !board.fallbackNote && <p class="text-muted small mb-1">{board.groupLabel} games</p>}
      {board.degraded && board.games.length === 0 && <p class="text-muted">The scoreboard is unavailable right now. Please try again shortly.</p>}
      {board.stale && board.games.length > 0 && <p class="text-muted small">Live scores are temporarily unavailable. These are the last saved scores for {board.nav.label}.</p>}
      {!board.degraded && board.games.length === 0 && <p class="text-muted">No games scheduled.</p>}
      {board.fallbackNote && <p class="text-muted">{board.fallbackNote}</p>}
      {sections.map((s) => (
        <section id={`hub-${s.key}`} aria-labelledby={`hub-${s.key}-heading`}>
          <h2 id={`hub-${s.key}-heading`} class="h5 mt-3">{s.label}</h2>
          <div class="row">{s.events.map((g) => {
            const l = lines[g.id];
            const tags = hubTags(g.competitions[0]);
            return (
              <NbaGameCard game={g}>
                {tonight?.sparklines[g.id] && (
                  <svg class="d-block w-100 mb-2 text-primary hub-wp" data-hub-wp={g.id} viewBox="0 0 100 24" preserveAspectRatio="none" height="28" role="img" aria-label={`${cleanAbbreviation(g.competitions[0].competitors.find((c) => c.homeAway === 'home')!.team)} win probability, play by play`}>
                    <line x1="0" y1="12" x2="100" y2="12" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="2 2" vector-effect="non-scaling-stroke" />
                    <polyline points={tonight.sparklines[g.id]} fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                  </svg>
                )}
                {(l || tags.length > 0) && (
                  <p class="small mb-3 hub-line" data-hub-line={g.id}>
                    {l?.spread && <span class="d-block">Line: {l.spread}{l.total !== null && `, O/U ${l.total}`}</span>}
                    {!l?.spread && l?.total != null && <span class="d-block">O/U {l.total}</span>}
                    {l?.wp && <span class="d-block">Market, pregame: {l.wp} to win</span>}
                    {(l?.cover || l?.upset) && <span class="d-block">{[l.upset && 'Upset', l.cover].filter(Boolean).join(' · ')}</span>}
                    {tags.length > 0 && <span class="d-block text-muted">{tags.join(' · ')}</span>}
                  </p>
                )}
              </NbaGameCard>
            );
          })}</div>
        </section>
      ))}
    </section>
    {tonight && tonight.standouts.length > 0 && (
      <section aria-labelledby="hub-standouts-heading" id="hub-standouts" class="mt-4">
        <h2 id="hub-standouts-heading" class="h4">Standouts</h2>
        <p class="text-muted small mb-2">The best individual games of {dayNav(tonight.day!).label}, by game score.</p>
        <ol class="mb-0">
          {tonight.standouts.map((s) => (
            <li class="mb-1" data-hub-standout={s.gameId}>
              <a href={gameHref(league, s.gameId)} class="fw-semibold">{s.name}</a>{' '}
              <span class="text-muted">{s.team}{s.opponent && ` vs ${s.opponent}`}</span>: {s.line}{' '}
              <span class="text-muted">(game score {s.gameScore.toFixed(1)})</span>
            </li>
          ))}
        </ol>
      </section>
    )}
    {dashboards && dashboards.war.length > 0 && (
      <section aria-labelledby="hub-war-heading" id="hub-war" class="mt-4">
        <h2 id="hub-war-heading" class="h4">WAR leaders, {seasonLabelFor(league, dashboards.warSeason)}</h2>
        <p class="text-muted small mb-2">The season's top {dashboards.war.length} players by wins above replacement.</p>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead><tr><th scope="col">#</th><th scope="col">Player</th><th scope="col">Team</th><th scope="col" class="text-end">WAR</th></tr></thead>
            <tbody>
              {dashboards.war.map((p, i) => (
                <tr>
                  <td>{i + 1}</td>
                  <td>{p.href ? <a href={p.href}>{p.name}</a> : p.name}</td>
                  <td>{p.team}</td>
                  <td class="text-end">{p.war.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
    <section aria-labelledby="hub-index-heading" id="hub-index" class="mt-4">
      <h2 id="hub-index-heading" class="h4">{name} pages</h2>
      <ul class="list-unstyled row">
        {index.map((p) => (
          <li class="col-md-6 col-xl-4 mb-3">
            <a href={lp(p.path)} class="fw-semibold">{p.label}</a>
            {p.blurb && <span class="d-block small text-muted">{p.blurb}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>
  {darkCss && <style set:html={`@media (prefers-color-scheme: dark){${darkCss}}`}></style>}
  <script is:inline>
    (() => {
      try {
        document.querySelectorAll('[data-gb-utc]').forEach((el) => {
          const d = new Date(el.getAttribute('data-gb-utc'));
          if (isNaN(d.getTime())) return;
          el.textContent = new Intl.DateTimeFormat([], { hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).format(d);
        });
      } catch { /* the ISO server text stands */ }
    })();
  </script>
</GenericPage>
