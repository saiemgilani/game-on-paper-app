---
// src/components/routes/NbaTeamRoute.astro
// blazing-the-nets' app/teams/[id]/[season]/page.tsx on GenericPage: the header with the team's
// colour bar and shooting line (the same text as blazing's team header, which carries no 3PM/3PA
// pair, so the parity gate's team mode matches it), the six-chart Dashboard island
// (subjectLabel Team), the roster.
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import Dashboard from '../nba/Dashboard.svelte';
import LineupShotChart from '../nba/LineupShotChart.astro';
import NbaNameFilter from '../nba/NbaNameFilter.astro';
import NbaRosterTable from '../nba/NbaRosterTable.astro';
import NbaSeasonSelect from '../nba/NbaSeasonSelect.astro';
import ShareButton from '../game/ShareButton.svelte';
import { statShareImage } from '../../basketball/statCard';
import { isFeatureEnabled } from '../../utils/features';
import LineupsTab from '../nba/LineupsTab.astro';
import OnOffTab from '../nba/OnOffTab.astro';
import SituationsTab from '../nba/SituationsTab.astro';
import BbTeamGameLog from '../nba/BbTeamGameLog.astro';
import BbTeamRotation from '../nba/BbTeamRotation.astro';
import TeamSeasonBlock from '../nba/TeamSeasonBlock.astro';
import TeamShotQuality from '../nba/TeamShotQuality.astro';
import PlayStyleChips from '../nba/PlayStyleChips.astro';
import ShotProfile from '../nba/ShotProfile.astro';
import { teamViews } from '../../utils/shotProfile';
import NeighborRanks from '../leaderboards/NeighborRanks.astro';
import { fmtInt, fmtPct } from '../../nba/format';
import { teamHref, withParams } from '../../nba/links';
import { placeholderNote } from '../../nba/data/placeholder';
import type { NbaTeamParams } from '../../routes/nba/team';
import { basketball, seasonLabelFor } from '../../basketball/config';
import { dashboardScope, isNcaaDashboards, NCAA_USAGE_NOTE } from '../../basketball/dashboards';
import { LEAGUES, leaguePath } from '../../utils/league';

interface Props { data: NbaTeamParams }
const { season, seasons, current, q, team, line, roster, dashboard, sort, dir, mode, coverage, empty, noPlayers, seasonBlock, poe, lineups, situations, onOff, lineupShots, playStyles, shotZones, gameSet, gameSetCounts, teamFlow, scheduleContext, neighbors } = Astro.props.data;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const name = LEAGUES[league].shortName;
const lp = (p: string) => leaguePath(league, p);
const ft = cfg.featuredTeam;
const byIdPlayers = isNcaaDashboards(league);
const label = seasonLabelFor(league, season);
const scope = dashboardScope(league, season);
const usageNote = isNcaaDashboards(league) ? NCAA_USAGE_NOTE : null;
const title = `${team.name}, ${label} shooting | Game on Paper`;
const emptyNote = `No ${cfg.statsSourceLabel} shots are linked to ${team.name} in ${label}.`;
const description = empty ? emptyNote : `${team.name} ${label} shooting: ${fmtPct(line.fgPct)} FG%, ${fmtPct(line.efgPct)} eFG% on ${fmtInt(line.attempts)} attempts, charted against the league, with the roster's shooting splits.`;
const breadcrumbs: PageBreadcrumb[] = [{ title: name, url: lp('/'), active: false }, { title: 'Teams', url: `${lp('/teams')}${q}`, active: false }, { title: team.tricode, active: true }];
const basePath = lp(`/team/${team.team_id}`);
const params = { season: String(season) };
const defaults = { season: String(current) };
// BB-G15 ('bball-poe'): the section shows for a failed read (it says so) or a season with a team row
const poeShown = poe === null || (poe !== undefined && poe.some((r) => r.level === 'team'));
// 'bball-share-card' (preview), G-R5: the season card as og:image and a Share button; off, the head and the page are today's
const shareCard = isFeatureEnabled('bball-share-card', Astro.locals);
const shareImage = shareCard ? statShareImage('team', league, team.team_id, season, team.name) : undefined;
---
<GenericPage title={title} subtitle={description} slug={basePath} breadcrumbs={breadcrumbs} description={description} canonicalPath={teamHref(team.team_id, q, league)} image={shareImage}>
  <link href="/assets/css/sticky-table.css" rel="stylesheet">
  <div class="container">
    <div class="row mb-3 align-items-start">
      <div class="col-auto"><span aria-hidden="true" class="nba-team-bar rounded d-block" style={`background: ${team.color}; height: 5rem`}></span></div>
      <div class="col">
        <h1 class="h3 mb-1">{team.tricode} <span class="fw-normal">{team.name}</span></h1>
        <p class="text-muted mb-1">{label} {scope.noun}</p>
        {!empty && (<p class="numeral mb-2" id="nba-line">{fmtInt(line.makes)}/{fmtInt(line.attempts)} FG &middot; {fmtPct(line.fgPct)} FG% &middot; {fmtPct(line.efgPct)} eFG% &middot; {fmtPct(line.fg3Pct)} 3P%</p>)}{coverage && (<p class="small text-muted mb-2" id="nba-coverage">{coverage}</p>)}{playStyles !== undefined && <PlayStyleChips chips={playStyles} detail />}
        <div class="d-flex flex-wrap align-items-center gap-3">
          <NbaSeasonSelect seasons={seasons} season={season} current={current} basePath={basePath} />
          {!empty && !noPlayers && (<a href={withParams(lp('/players'), { season: String(season), team: byIdPlayers ? String(team.team_id) : team.tricode }, { season: String(current), team: byIdPlayers ? '' : ft ? ft.tricode(season) : 'ALL' })}>{team.tricode} player list &rarr;</a>)}{shareCard && (<ShareButton client:load label url={`https://gameonpaper.com${teamHref(team.team_id, q, league)}`} />)}
        </div>
      </div>
    </div>{seasonBlock !== undefined && (<TeamSeasonBlock data={seasonBlock} season={season} espnId={team.espn_id || team.team_id} teamName={team.name} {...(gameSet ? { gameSet } : {})} {...(gameSetCounts !== undefined ? { gameSetCounts } : {})} {...(scheduleContext ? { context: scheduleContext } : {})} {...(seasonBlock && teamFlow !== undefined ? { logged: true } : {})} />)}{lineups !== undefined && (<LineupsTab data={lineups} season={season} current={current} basePath={basePath} teamName={team.name} />)}{onOff !== undefined && (<OnOffTab data={onOff} season={season} current={current} basePath={basePath} teamName={team.name} />)}{situations !== undefined && (<SituationsTab data={situations} season={season} current={current} basePath={basePath} teamName={team.name} />)}{poeShown && (<TeamShotQuality rows={poe ?? null} season={season} seasonQuery={q} names={new Map(roster.map((r) => [r.person_id, r.name]))} />)}{shotZones !== undefined && (<ShotProfile views={shotZones === null ? null : teamViews(shotZones)} season={season} name={team.name} team />)}{seasonBlock && teamFlow !== undefined && (<BbTeamGameLog data={seasonBlock} flow={teamFlow} season={season} espnId={team.espn_id || team.team_id} {...(gameSet ? { set: gameSet } : {})} />)}{seasonBlock && scheduleContext && (<BbTeamRotation data={seasonBlock} box={scheduleContext.box} season={season} espnId={team.espn_id || team.team_id} />)}{neighbors !== undefined && (<section id="nearby-ranks" aria-label="Nearby ranks" class="mb-4">
      <h2 class="h5">Nearby ranks</h2>
      {neighbors === null ? (<p class="text-muted" id="nearby-unavailable">The nearby ranks are temporarily unavailable.</p>)
        : neighbors.length === 0 ? (<p class="text-muted" id="nearby-empty">There are no {label} ranks for {team.name}.</p>)
        : (<Fragment><p class="small text-muted">The teams ranked within five places of {team.name} on each measure, {label}, in the producer's ranks; 1 is best (the lowest defensive rating and turnover rate, the hardest schedule), and for pace the fastest.</p>
      <NeighborRanks lists={neighbors} kind="team" /></Fragment>)}
    </section>)}
    {empty ? (<p class="text-muted" id="nba-empty">{emptyNote}</p>) : (<Fragment><nav aria-label="On this page" class="small mb-3">
      <span class="text-muted">On this page:</span>{seasonBlock !== undefined && (<a href="#season" class="ms-2">Season</a>)}{lineups !== undefined && (<a href="#lineups" class="ms-2">Lineups</a>)}{onOff !== undefined && (<a href="#on-off" class="ms-2">On/Off</a>)}{situations !== undefined && (<a href="#situations" class="ms-2">Situations</a>)}{poeShown && (<a href="#poe" class="ms-2">Points over expected</a>)}{shotZones !== undefined && (<a href="#shot-profile" class="ms-2">Shot profile</a>)}{neighbors !== undefined && (<a href="#nearby-ranks" class="ms-2">Nearby ranks</a>)}
      <a href="#charts" class="ms-2">Shot charts</a>{lineupShots && (<a href="#lineup-shots" class="ms-2">Lineup shot chart</a>)}
      <a href="#roster" class="ms-2">Roster</a>
    </nav>
    <div id="charts">
      {dashboard!.unlocated && <p class="small text-muted">{placeholderNote(dashboard!.unlocated.count, dashboard!.unlocated.total, 'season')}</p>}
      <Dashboard client:load data={dashboard!} subject={`${team.name} ${label}`} subjectLabel="Team" />
    </div>{lineupShots && (<LineupShotChart view={lineupShots} teamName={team.name} seasonLabel={label} scope={scope.noun} basePath={basePath} params={Astro.url.searchParams} />)}
    <section id="roster" aria-label="Roster by attempts" class="mt-3">
      <h2 class="h5">Roster by attempts</h2>
      {noPlayers ? (<p class="text-muted" id="nba-no-players">No player is named on these shots.</p>) : (<Fragment><NbaNameFilter tableId="nba-roster" count={roster.length} />
      <NbaRosterTable rows={roster} seasonQuery={q} sort={sort} dir={dir} mode={mode} basePath={basePath} params={params} defaults={defaults} {...(cfg.hidePie ? { hidePie: true, note: usageNote } : {})} /></Fragment>)}
    </section></Fragment>)}
  </div>
</GenericPage>
