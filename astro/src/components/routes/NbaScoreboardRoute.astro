---
import { DateTime } from 'luxon';
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import ErrorPage from '../ErrorPage.astro';
import NbaGameCard from '../nba/NbaGameCard.astro';
import { darkLogoCss, shortDay } from '../../nba/scoreboard';
import type { NbaScoreboardPrep } from '../../routes/nba/scoreboard';
import { basketball } from '../../basketball/config';
import { LEAGUES, leaguePath } from '../../utils/league';

interface Props { data: NbaScoreboardPrep }
const { data } = Astro.props;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const name = LEAGUES[league].shortName;
const lp = (p: string) => leaguePath(league, p);
const firstMonth = DateTime.fromISO(cfg.firstScoreboardDay, { zone: 'utc' }).setLocale('en-US').toFormat('LLLL yyyy');
const breadcrumbs: PageBreadcrumb[] = [{ title: name, url: lp('/'), active: false }, { title: 'Scoreboard', active: true }];
// The route accepts days up to the server's UTC date + 14; the picker's max is the same bound.
const darkCss = 'badDate' in data ? '' : darkLogoCss(data.games.flatMap((g) => g.competitions[0].competitors.map((c) => ({ id: c.id, abbreviation: c.team?.abbreviation, season: g.season?.year }))), cfg.darkLogo);
// A degraded read with no ?date= has no trustworthy day (the route only has the server clock).
const noDay = !('badDate' in data) && data.degraded && !!data.undated;
const maxDay = new Date(Date.now() + 14 * 86400000).toISOString().slice(0, 10);
---
{'badDate' in data ? (
    <ErrorPage htmlTitle="Bad date" htmlSubtitle={`${name} scoreboard`} slug={lp('/scoreboard')} humanTitle="That is not a date we can show."
        message={`Use ?date=YYYY-MM-DD for a day between ${firstMonth} and two weeks from today.`} />
) : (
    <GenericPage title={`${name} scoreboard${data.isLive || noDay ? '' : `, ${data.nav.label}`} | Game on Paper`}
        subtitle={`${name} scores${noDay ? '' : ` for ${data.nav.label}`} with win probability, four factors and shot charts for every game.`}
        slug={lp('/scoreboard')} breadcrumbs={breadcrumbs}
        description={`Live ${name} scoreboard with Game on Paper's win probability, four factors, advanced box scores and shot charts for every game.`}
        canonicalPath={data.isLive || noDay ? lp('/scoreboard') : `${lp('/scoreboard')}?date=${data.day}`}>
      <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <h1 class="h3 mb-0">{noDay ? 'Scoreboard' : data.isLive ? 'Tonight' : data.nav.label}</h1>
          <div class="d-flex flex-wrap align-items-center gap-2">
            {!noDay && data.nav.prev >= cfg.firstScoreboardDay && <a class="btn btn-sm btn-outline-primary text-nowrap" href={`${lp('/scoreboard')}?date=${data.nav.prev}`} rel="prev">&larr; {shortDay(data.nav.prev)}</a>}
            <form method="get" action={lp('/scoreboard')} class="d-inline-flex align-items-center gap-1">
              <label class="visually-hidden" for="nba-date">Day</label>
              <input id="nba-date" type="date" name="date" class="form-control form-control-sm" value={noDay ? undefined : data.day} min={cfg.firstScoreboardDay} max={maxDay} onchange="this.value && this.checkValidity() && this.form.submit()" />
              <button type="submit" class="btn btn-sm btn-outline-primary">Go</button>
            </form>
            {!noDay && data.nav.next <= maxDay && <a class="btn btn-sm btn-outline-primary text-nowrap" href={`${lp('/scoreboard')}?date=${data.nav.next}`} rel="next">{shortDay(data.nav.next)} &rarr;</a>}
            {!data.isLive && <a class="btn btn-sm btn-link text-nowrap" href={lp('/scoreboard')}>Tonight</a>}
          </div>
        </div>
        {data.degraded && data.games.length === 0 && <p class="text-muted">The scoreboard is unavailable right now. Please try again shortly.</p>}
        {data.stale && data.games.length > 0 && <p class="text-muted small">Live scores are temporarily unavailable. These are the last saved scores for {data.nav.label}.</p>}
        {!data.degraded && data.games.length === 0 && <p class="text-muted">No games scheduled.</p>}
        <div class="row">
          {data.games.map((g) => <NbaGameCard game={g} />)}
        </div>
      </div>
      {darkCss && <style set:html={`@media (prefers-color-scheme: dark){${darkCss}}`}></style>}
      <script is:inline>
        (() => {
          try {
            document.querySelectorAll('[data-gb-utc]').forEach((el) => {
              const d = new Date(el.getAttribute('data-gb-utc'));
              if (isNaN(d.getTime())) return;
              el.textContent = new Intl.DateTimeFormat([], { hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).format(d);
            });
          } catch { /* the ISO server text stands */ }
        })();
      </script>
    </GenericPage>
)}
