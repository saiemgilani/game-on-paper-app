---
// src/components/routes/NbaLeadersRoute.astro
// blazing-the-nets' app/leaders/[season]/page.tsx on GenericPage.
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import Leaderboards from '../nba/Leaderboards.svelte';
import NbaSeasonSelect from '../nba/NbaSeasonSelect.astro';
import type { NbaLeadersParams } from '../../routes/nba/leaders';
import { basketball, islandLeagueProps, seasonLabelFor } from '../../basketball/config';
import { LEAGUES, leaguePath } from '../../utils/league';

interface Props { data: NbaLeadersParams }
const { season, seasons, current, q, boards } = Astro.props.data;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const name = LEAGUES[league].shortName;
const lp = (p: string) => leaguePath(league, p);
const ft = cfg.featuredTeam;
const label = seasonLabelFor(league, season);
const ip = islandLeagueProps(league, season);
const title = `${name} rolling leaders, ${label} | Game on Paper`;
const description = `Who is shooting best over their last 5, 10 and 20 games in ${label}: FG%, eFG%, 3P% and most improved${ft ? `, the ${ft.menuLabel} highlighted` : ''}.`;
const breadcrumbs: PageBreadcrumb[] = [{ title: name, url: lp('/'), active: false }, { title: 'Leaders', active: true }];
---
<GenericPage title={title} subtitle={description} slug={lp('/leaders')} breadcrumbs={breadcrumbs} description={description} canonicalPath={`${lp('/leaders')}${q}`}>
  <div class="container">
    <div class="row mb-3">
      <div class="col-12">
        <h1 class="h3">Rolling leaders, {label}</h1>
        <NbaSeasonSelect seasons={seasons} season={season} current={current} basePath={lp('/leaders')} />
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        {boards
          ? (<Leaderboards client:load boards={boards} netsTeamId={ft?.statsTeamId ?? null} seasonQuery={q} {...(ip.pronoun ? { pronoun: ip.pronoun } : {})} {...(ip.leaderBars ? { bars: ip.leaderBars } : {})} />)
          : (<p class="text-muted">The Data API has no game logs for {label}, and rolling windows need game dates, so there are no leaderboards for this season.</p>)}
      </div>
    </div>
  </div>
</GenericPage>
