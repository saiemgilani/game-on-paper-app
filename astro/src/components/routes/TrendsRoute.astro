---
import TrendsChart from '../../components/charts/TrendsChart.svelte';
import TrendsMetricDropdown from '../../components/dropdowns/TrendsMetricDropdown.svelte';
import FallbackSpinner from '../../components/FallbackSpinner.astro';
import FreshnessStamp from '../../components/FreshnessStamp.astro';
import GenericPage from '../../layouts/GenericPage.astro';
import type { PageBreadcrumb } from '../../layouts/GenericPage.astro';
import { retrievePercentiles, sdvIngestStamp, type SDVSeasonPercentile } from '../../resources/sdv';
import { isFeatureEnabled } from '../../utils/features';
import { freshnessStamp } from '../../utils/freshness';
import { leaguePath, type League } from '../../utils/league';
import { yearRange } from '../../utils/misc';

// Route component: the page (per league) sets the league; this reads and renders.
interface Props { league: League }
const { league } = Astro.props;
const query = Astro.url.searchParams;
const metric = query.get("sort") || "EPAplay";
const stamp = isFeatureEnabled('freshness-stamps', Astro.locals) ? freshnessStamp(await sdvIngestStamp(league, 'percentiles')) : null;

let allPctls: SDVSeasonPercentile[] = []
for (const p of [0.01, 0.25, 0.5, 0.75, 0.99]) {
    // one meta snapshot for the stamp and all five reads, so the chart never mixes versions
    const percentiles = await retrievePercentiles(undefined, p, undefined, league, stamp?.iso);
    allPctls = allPctls.concat(percentiles);
}

const selectedPercentiles = allPctls.map((p: any) => {
    return {
        season: p["season"] || 2025,
        pctile: p["pctile"],
        value: p[metric]
    }
})


const breadcrumbs: PageBreadcrumb[] = [
    {
        title: 'Charts',
        active: false
    },
    {
        title: 'National Trends',
        active: true,
    }
]

const range = yearRange(selectedPercentiles.map(b => b.season))
const title = `National Trends | ${range} | Game on Paper`;
// Astro.response.headers.set('Cache-Control', `public, max-age=${24 * 60 * 60}`);

---

<GenericPage title={title} subtitle={`National level metric history`} description={`How ${league === 'nfl' ? 'NFL' : 'college football'} advanced stats have moved nationally, ${range}: EPA per play, success rate, explosiveness and win probability season over season.`} slug={leaguePath(league, "/charts/trends")} breadcrumbs={breadcrumbs}>
    <div class="container">
        <div class="row mb-3">
            <div class="col-lg-6 col-xs-12 mb-xs-3">
                <h1>National Trends</h1>
                <p class="m-0 text-muted"><strong>Available Seasons:</strong> {range}{league === 'cfb' && " - Data shown is from FBS vs FBS games only."}{league === 'nfl' && " - Regular season games only."}</p>
                <p class="m-0 mb-2 text-muted text-small">Data from <a href="https://www.sportsdataverse.org">Sportsdataverse</a>, may differ from ESPN due to data availability/quality. Note: other than for Adj EPA/Play, metrics are <strong>not</strong> adjusted for quality of opponent or garbage time.</p>
                <p class="m-0 mb-2 text-muted text-small">Adj EPA/Play methodology adapted from <a href="https://makennnahack.github.io/makenna-hack.github.io/publications/opp_adj_rank_project/">this article</a> by <a href="https://twitter.com/makennnahack">Makenna Hack</a> and <a href="https://blog.collegefootballdata.com/opponent-adjusted-stats-ridge-regression/">this article</a> from <a href="https://twitter.com/jbuddavis">Bud Davis</a>, accounting for home-field advantage, quality of opponent, and garbage time.{league === 'cfb' && " Only considers FBS vs FBS games -- as a result, adj EPA/Play and normal EPA/Play numbers may differ significantly until all teams have played multiple FBS vs FBS games."}</p>
                <FreshnessStamp stamp={stamp} />
            </div>
            <div class="ms-auto col-lg-6 col-xs-12">
                <TrendsMetricDropdown client:idle metric={metric} />
            </div>
        </div>
    </div>
    <TrendsChart client:only {...(stamp ? { freshness: stamp.text } : {})} title="National Trends" teamColor={null} teamData={[]} category={"offensive"} metric={metric} percentiles={selectedPercentiles}>
        <FallbackSpinner slot="fallback" />
    </TrendsChart>
</GenericPage>
