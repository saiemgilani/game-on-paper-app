---
import NbaGamePage from '../nba/game/NbaGamePage.astro';
import NbaPreGamePage from '../nba/game/NbaPreGamePage.astro';
import type { NbaGamePrep } from '../../routes/nba/game';

interface Props { data: Exclude<NbaGamePrep, { notFound: true } | { unavailable: true }> }
const { data } = Astro.props;
---
{'pregame' in data ? <NbaPreGamePage espnGame={data.espnGame} /> : <NbaGamePage game={data.game} sourceTools={data.sourceTools} situations={data.situations} poe={data.poe} impact={data.impact} flow={data.flow} epv={data.epv} garbage={data.garbage} averages={data.averages} shooting={data.shooting} shotFilters={data.shotFilters} shift={data.shift} season={data.season} playerSeason={data.playerSeason} info={data.info} playerProps={data.playerProps} />}
