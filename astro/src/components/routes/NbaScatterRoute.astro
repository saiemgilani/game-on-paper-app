---
// src/components/routes/NbaScatterRoute.astro
// blazing-the-nets' app/scatter/[season]/page.tsx on GenericPage.
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import NbaSeasonSelect from '../nba/NbaSeasonSelect.astro';
import ScatterExplorer from '../nba/ScatterExplorer.svelte';
import type { NbaScatterParams } from '../../routes/nba/scatter';
import { basketball, islandLeagueProps, seasonLabelFor } from '../../basketball/config';
import { dashboardScope, isNcaaDashboards, NCAA_USAGE_NOTE } from '../../basketball/dashboards';
import { LEAGUES, leaguePath } from '../../utils/league';

interface Props { data: NbaScatterParams }
const { season, seasons, current, q, points, min, coverage } = Astro.props.data;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const name = LEAGUES[league].shortName;
const lp = (p: string) => leaguePath(league, p);
const ft = cfg.featuredTeam;
const label = seasonLabelFor(league, season);
const scope = dashboardScope(league, season);
const usageNote = isNcaaDashboards(league) ? NCAA_USAGE_NOTE : null;
const ip = islandLeagueProps(league, season);
// D42 (college only): the conference filter; a chosen conference rides a season change (the loader falls back to that season's default)
const conference = 'conference' in Astro.props.data ? Astro.props.data.conference : undefined;
const keepConference = conference && Astro.url.searchParams.get('conference') === conference.selected ? { conference: conference.selected } : undefined;
const title = `${name} scatter, ${label} | Game on Paper`;
const description = `Every ${name} player with ${min.fga}+ field-goal attempts in ${label}, plotted on two shooting or volume numbers${ft ? `, the ${ft.menuLabel} highlighted` : ''}.`;
const breadcrumbs: PageBreadcrumb[] = [{ title: name, url: lp('/'), active: false }, { title: 'Scatter', active: true }];
---
<GenericPage title={title} subtitle={description} slug={lp('/scatter')} breadcrumbs={breadcrumbs} description={description} canonicalPath={`${lp('/scatter')}${q}`}>
  <div class="container">
    <div class="row mb-3">
      <div class="col-12">
        <h1 class="h3">League scatter, {label}</h1>
        <NbaSeasonSelect seasons={seasons} season={season} current={current} basePath={lp('/scatter')} {...(keepConference ? { params: keepConference } : {})} />{conference && (
          <form method="get" action={lp('/scatter')} class="mt-2">
            {season !== current && (<input type="hidden" name="season" value={String(season)} />)}
            <label class="visually-hidden" for="nba-conference">Conference</label>
            <select id="nba-conference" name="conference" class="form-select form-select-sm w-auto d-inline-block" onchange="this.form.submit()">
              <option value="all" selected={conference.selected === 'all'}>All D-I</option>
              {conference.options.map((o) => <option value={o.slug} selected={conference.selected === o.slug}>{o.label}</option>)}
            </select>
            <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button></noscript>
          </form>)}{coverage && (<p class="small text-muted mt-2" id="nba-coverage">{coverage}</p>)}{usageNote && (<p class="small text-muted" id="nba-usage">{usageNote}</p>)}
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        {points.length === 0
          ? (<p class="text-muted">No {scope.adj} shots in {label} yet.</p>)
          : (<ScatterExplorer client:load points={points} subject={`${name} ${label}`} {...('highlight' in ip ? { highlight: ip.highlight } : {})} {...(ip.minFga ? { minFga: ip.minFga } : {})} />)}
      </div>
    </div>
  </div>
</GenericPage>
