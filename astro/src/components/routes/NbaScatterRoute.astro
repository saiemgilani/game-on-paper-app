---
// src/components/routes/NbaScatterRoute.astro
// blazing-the-nets' app/scatter/[season]/page.tsx on GenericPage.
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import NbaSeasonSelect from '../nba/NbaSeasonSelect.astro';
import ScatterExplorer from '../nba/ScatterExplorer.svelte';
import { seasonLabel } from '../../nba/seasons';
import type { NbaScatterParams } from '../../routes/nba/scatter';

interface Props { data: NbaScatterParams }
const { season, seasons, current, q, points } = Astro.props.data;
const label = seasonLabel(season);
const title = `NBA scatter, ${label} | Game on Paper`;
const description = `Every NBA player with 100+ field-goal attempts in ${label}, plotted on two shooting or volume numbers, the Nets highlighted.`;
const breadcrumbs: PageBreadcrumb[] = [{ title: 'NBA', url: '/nba', active: false }, { title: 'Scatter', active: true }];
---
<GenericPage title={title} subtitle={description} slug="/nba/scatter" breadcrumbs={breadcrumbs} description={description} canonicalPath={`/nba/scatter${q}`}>
  <div class="container">
    <div class="row mb-3">
      <div class="col-12">
        <h1 class="h3">League scatter, {label}</h1>
        <NbaSeasonSelect seasons={seasons} season={season} current={current} basePath="/nba/scatter" />
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        {points.length === 0
          ? (<p class="text-muted">No regular-season shots in {label} yet.</p>)
          : (<ScatterExplorer client:load points={points} subject={`NBA ${label}`} />)}
      </div>
    </div>
  </div>
</GenericPage>
