---
// The Nets roster for a season: blazing-the-nets' app/home/[season]/page.tsx on GenericPage
// with Bootstrap cards. Numbers via blazing's fmt* (the same text the charts use).
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import NbaHeadshot from '../nba/NbaHeadshot.astro';
import NbaSeasonSelect from '../nba/NbaSeasonSelect.astro';
import { lineOf } from '../../nba/data/aggregate';
import { teamName } from '../../nba/data/teams';
import { fmtDec, fmtInt, fmtPct } from '../../nba/format';
import { playerHref, withParams } from '../../nba/links';
import type { NbaHomeParams } from '../../routes/nba/home';
import { basketball, seasonLabelFor } from '../../basketball/config';
import { LEAGUES, leaguePath } from '../../utils/league';

interface Props { data: NbaHomeParams }
const { season, seasons, current, q, roster, headshots } = Astro.props.data;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const name = LEAGUES[league].shortName;
const ft = cfg.featuredTeam;
const lp = (p: string) => leaguePath(league, p);
if (!ft) throw new Error(`${league}: no featured team`);
const label = seasonLabelFor(league, season);
const title = `${teamName(ft.statsTeamId, season)} shooting, ${label} | Game on Paper`;
const subtitle = `Hex shot charts, shooting signatures and distance and side splits for every ${ft.menuLabel} player, compared with the rest of the league, from ${cfg.statsSourceLabel} play-by-play.`;
const breadcrumbs: PageBreadcrumb[] = [{ title: name, url: lp('/'), active: false }, { title: label, active: true }];
---
<GenericPage title={title} subtitle={subtitle} slug={lp('/')} breadcrumbs={breadcrumbs} canonicalPath={`${lp('/')}${q}`}>
  <div class="container">
    <div class="row mb-3">
      <div class="col-12">
        <h1 class="h3">Where the {ft.menuLabel} shoot, and how often it goes in.</h1>
        <p class="text-muted">{subtitle}</p>
        <div class="d-flex flex-wrap align-items-center gap-3">
          <NbaSeasonSelect seasons={seasons} season={season} current={current} basePath={lp('/')} />
          <a href={lp('/scoreboard')}>Scoreboard &rarr;</a>
          <a href={withParams(lp('/players'), { season: String(season) }, { season: String(current) })}>All players &rarr;</a>
          <a href={withParams(lp('/teams'), { season: String(season) }, { season: String(current) })}>All teams &rarr;</a>
        </div>
      </div>
    </div>
    <div class="row mb-3">
      <div class="col-12">
        <h2 class="h4">{teamName(ft.statsTeamId, season)}, {label} <small class="text-muted">regular season, by attempts</small></h2>
        {roster.length === 0 && (<p class="text-muted">No {ft.menuLabel} regular-season shots in {label} yet; the charts fill in after their first game.</p>)}
      </div>
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3" id="nba-roster">
      {roster.map((p) => {
        const line = lineOf(p);
        return (
          <div class="col">
            <a href={playerHref(p.person_id, q, league)} class="card border rounded h-100 text-decoration-none text-reset">
              <div class="card-body d-flex align-items-center gap-3">
                <NbaHeadshot src={headshots.get(p.person_id) ?? null} name={p.player_name} size={88} decorative />
                <div class="overflow-hidden">
                  <p class="card-title h6 mb-1 text-truncate">{p.player_name}</p>
                  <p class="mb-0 numeral">{fmtInt(p.attempts)} FGA &middot; {fmtPct(line.fgPct)} FG &middot; {fmtPct(line.efgPct)} eFG</p>
                  {p.stats && (<p class="mb-0 text-muted numeral">{fmtInt(p.stats.gp)} GP &middot; {fmtDec(p.stats.min)} MIN{p.statsScope === 'all-teams' && ' (season totals across teams)'}</p>)}
                </div>
              </div>
            </a>
          </div>
        );
      })}
    </div>
  </div>
</GenericPage>
