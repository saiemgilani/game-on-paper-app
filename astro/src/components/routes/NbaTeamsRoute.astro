---
// src/components/routes/NbaTeamsRoute.astro
// blazing-the-nets' app/teams/list/[season]/page.tsx on GenericPage: one Bootstrap card per team,
// a colour bar, the tricode and name, the season's shooting line.
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import NbaConferenceTeams from '../nba/NbaConferenceTeams.astro';
import NbaSeasonSelect from '../nba/NbaSeasonSelect.astro';
import { fmtInt, fmtPct } from '../../nba/format';
import { teamHref, withParams } from '../../nba/links';
import { placeholderNote } from '../../nba/data/placeholder';
import type { NbaTeamsParams } from '../../routes/nba/teams';
import { basketball, seasonLabelFor } from '../../basketball/config';
import { dashboardScope, isNcaaDashboards } from '../../basketball/dashboards';
import { LEAGUES, leaguePath } from '../../utils/league';

interface Props { data: NbaTeamsParams; landing?: boolean }
const { data, landing = false } = Astro.props;
const { season, seasons, current, q, teams, lines, coverage, conferences } = data;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const name = LEAGUES[league].shortName;
const lp = (p: string) => leaguePath(league, p);
const byIdPlayers = isNcaaDashboards(league);
const label = seasonLabelFor(league, season);
const scope = dashboardScope(league, season);
const title = `${name} teams, ${label} shooting | Game on Paper`;
const subtitle = `Every team's ${label} ${scope.adj} shooting line, from ${scope.source}, with a shot chart and roster for each${byIdPlayers ? ' team with linked shots' : ''}.`;
const here = lp(landing ? '/' : '/teams');
const breadcrumbs: PageBreadcrumb[] = landing
    ? [{ title: name, active: true }]
    : [{ title: name, url: lp('/'), active: false }, { title: 'Teams', active: true }];
---
<GenericPage title={title} subtitle={subtitle} slug={here} breadcrumbs={breadcrumbs} canonicalPath={`${here}${q}`}>
  <div class="container">
    <div class="row mb-3">
      <div class="col-12">
        <h1 class="h3">{landing ? `${name} teams, ${label}` : `Teams, ${label}`}</h1>
        {data.unlocated && <p class="small text-muted">{placeholderNote(data.unlocated.count, data.unlocated.total, 'season')}</p>}
        <p class="text-muted">{subtitle}</p>{coverage && (<p class="small text-muted" id="nba-coverage">{coverage}</p>)}
        <NbaSeasonSelect seasons={seasons} season={season} current={current} basePath={here} />
        {landing && (
          <div class="d-flex flex-wrap align-items-center gap-3 mt-2">
            <a href={lp('/scoreboard')}>Scoreboard &rarr;</a>
            <a href={withParams(lp('/players'), { season: String(season) }, { season: String(current) })}>{byIdPlayers ? 'Players' : 'All players'} &rarr;</a>
            <a href={withParams(lp('/scatter'), { season: String(season) }, { season: String(current) })}>Scatter &rarr;</a>
            <a href={withParams(lp('/leaders'), { season: String(season) }, { season: String(current) })}>Leaders &rarr;</a>
          </div>
        )}
      </div>
    </div>
    {teams.length === 0 && (<p class="text-muted">No {scope.adj} shots in {label} yet.</p>)}
    {conferences ? (<NbaConferenceTeams groups={conferences} lines={lines} seasonQuery={q} />) : (<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3" id="nba-teams">
      {teams.map((t) => {
        const line = lines.get(t.team_id);
        return (
          <div class="col">
            <a href={teamHref(t.team_id, q, league)} class="card border rounded h-100 text-decoration-none text-reset">
              <div class="card-body d-flex align-items-center gap-3">
                <span aria-hidden="true" class="nba-team-bar rounded" style={`background: ${t.color}`}></span>
                <div class="overflow-hidden">
                  <p class="card-title h6 mb-1 text-truncate">{t.tricode} <span class="fw-normal text-muted">{t.name}</span></p>
                  <p class="mb-0 numeral">{fmtInt(line?.attempts)} FGA &middot; {fmtPct(line?.fgPct)} FG &middot; {fmtPct(line?.efgPct)} eFG</p>
                </div>
              </div>
            </a>
          </div>
        );
      })}
    </div>)}
  </div>
</GenericPage>
