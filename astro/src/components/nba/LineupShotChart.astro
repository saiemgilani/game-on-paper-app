---
// BB-G52, behind 'bball-lineup-shotchart': the team's offense or defense season shots with up to five of its players ON or
// OFF the floor (on defense, also up to five of the shooting opponents' players), in the team page's square and zone chart against the league. A plain GET form (no island but the chart):
// the route filters on the server (nba/lineupShots.ts), so a filtered view is a URL.
import HexShotChart from './charts/HexShotChart.svelte';
import { fmtInt, fmtPct } from '../../nba/format';
import { placeholderNote } from '../../nba/data/placeholder';
import { MAX_LINEUP_FILTERS, type LineupFilter, type LineupOption, type LineupShotsView } from '../../nba/lineupShots';

interface Props { view: LineupShotsView; teamName: string; seasonLabel: string; scope: string; basePath: string; params: URLSearchParams }
const { view, teamName, seasonLabel, scope, basePath, params } = Astro.props;
const data = view.status === 'ok' ? view.data : null;
const side = data ? data.side : (view as { side: 'offense' | 'defense' }).side;
// the page's other parameters (season, roster sort) ride along; the form's own five are rebuilt
const keep = [...params].filter(([k]) => !['side', 'p', 's', 'op', 'os'].includes(k));
const slotsOf = (fs: LineupFilter[] | undefined) => Array.from({ length: MAX_LINEUP_FILTERS }, (_, i) => fs?.[i] ?? null);
// ponytail: the opponent rows list every opponent player of the season (~400 NBA names, five times over), plain <option>s
const rows = [
    { key: 'p', state: 's', label: 'Player', slots: slotsOf(data?.filters), options: data?.options ?? [] },
    ...(side === 'defense' ? [{ key: 'op', state: 'os', label: 'Opponent player', slots: slotsOf(data?.oppFilters), options: data?.oppOptions ?? [] }] : []),
];
const nameIn = (opts: LineupOption[], id: string) => opts.find((o) => o.id === id)?.name ?? `#${id}`;
const said = [
    ...(data?.filters ?? []).map((f) => `${nameIn(data!.options, f.id)} ${f.on ? 'on' : 'off'}`),
    ...(data?.oppFilters ?? []).map((f) => `opponent ${nameIn(data!.oppOptions, f.id)} ${f.on ? 'on' : 'off'}`),
];
const lineups = said.length ? said.join(', ') : 'Every lineup';
const subject = side === 'offense' ? `${teamName} shots` : `Opponent shots against ${teamName}`;
const clearQuery = new URLSearchParams([...keep, ...(side === 'defense' ? [['side', 'defense']] : [])]).toString();
const clearHref = `${basePath}${clearQuery ? `?${clearQuery}` : ''}#lineup-shots`;
---
<section id="lineup-shots" aria-labelledby="lineup-shots-h" class="mt-3">
  <h2 class="h5" id="lineup-shots-h">Lineup shot chart</h2>
  <p class="small text-muted mb-2">{seasonLabel} {scope} shots with up to {MAX_LINEUP_FILTERS} {teamName} players on or off the floor{side === 'defense' ? `, and up to ${MAX_LINEUP_FILTERS} of the shooting opponents' players` : ''}, by square or zone against the league.</p>
  {view.status === 'unavailable' && (<p class="text-muted" id="lineup-shots-unavailable">Lineup shot data is not available for {seasonLabel}.</p>)}
  {view.status === 'error' && (<p class="text-muted" id="lineup-shots-error">The lineup shot chart could not be loaded right now.</p>)}
  {data && (<Fragment>
    <form method="get" action={`${basePath}#lineup-shots`} class="mb-2" id="lineup-shots-form">
      {keep.map(([k, v]) => (<input type="hidden" name={k} value={v} />))}
      <div class="row g-2 align-items-end">
        <div class="col-12 col-md-auto">
          <label class="form-label small mb-0" for="lineup-side">Shots</label>
          <select class="form-select form-select-sm" id="lineup-side" name="side">
            <option value="offense" selected={side === 'offense'}>Offense ({teamName} shots)</option>
            <option value="defense" selected={side === 'defense'}>Defense (opponent shots)</option>
          </select>
        </div>
        {rows.map((r) => r.slots.map((f, i) => (
          <div class="col-12 col-sm-6 col-md-auto">
            <label class="form-label small mb-0" for={`lineup-${r.key}${i + 1}`}>{r.label} {i + 1}</label>
            <div class="input-group input-group-sm">
              <select class="form-select" id={`lineup-${r.key}${i + 1}`} name={r.key}>
                <option value="">Any</option>
                {r.options.map((o) => (<option value={o.id} selected={f?.id === o.id}>{o.name}</option>))}
              </select>
              <select class="form-select" name={r.state} aria-label={`${r.label} ${i + 1} on or off the floor`} style="max-width: 5.5rem">
                <option value="on" selected={f?.on !== false}>On</option>
                <option value="off" selected={f?.on === false}>Off</option>
              </select>
            </div>
          </div>
        )))}
        <div class="col-12 col-md-auto">
          <button type="submit" class="btn btn-sm btn-primary">Apply</button>
          <a href={clearHref} class="btn btn-sm btn-link">Clear players</a>
        </div>
      </div>
    </form>
    <script is:inline>
      // drop the empty player rows (and their On/Off pair) so a filtered view's URL names only what it filters
      document.getElementById('lineup-shots-form')?.addEventListener('formdata', (e) => {
        const d = e.formData;
        [['p', 's'], ['op', 'os']].forEach(([pk, sk]) => {
          const p = d.getAll(pk), s = d.getAll(sk);
          d.delete(pk); d.delete(sk);
          p.forEach((v, i) => { if (v) { d.append(pk, v); d.append(sk, s[i] ?? 'on'); } });
        });
      });
    </script>
    <p class="small mb-2" id="lineup-shots-line"><span class="fw-semibold">{lineups}:</span> {fmtInt(data.line.makes)}/{fmtInt(data.line.attempts)} FG, {fmtPct(data.line.fgPct)} FG%, {fmtPct(data.line.efgPct)} eFG% <span class="text-muted">({fmtInt(data.line.attempts)} of {fmtInt(data.total)} {side === 'offense' ? 'team' : 'opponent'} shots{data.unknown > 0 ? `; ${fmtInt(data.unknown)} without a known lineup left out` : ''})</span></p>
    {data.unlocated && (<p class="small text-muted">{placeholderNote(data.unlocated.count, data.unlocated.total, 'season')}</p>)}
    {data.hex
      ? (<div id="lineup-shots-chart" style="max-width: 640px"><HexShotChart client:load data={data.hex} title={`${subject}, ${seasonLabel} (${lineups})`} /></div>)
      : (<p class="text-muted" id="lineup-shots-none">No {side === 'offense' ? 'team' : 'opponent'} shots match these players.</p>)}
  </Fragment>)}
</section>
