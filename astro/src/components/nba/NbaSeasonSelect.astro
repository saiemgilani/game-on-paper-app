---
// A plain <select> whose options are URLs (CoachLeaderboardPage.astro's pattern: no JS island).
import { withParams } from '../../nba/links';
import { seasonLabel } from '../../nba/seasons';
interface Props { seasons: number[]; season: number; current: number; basePath: string; params?: Record<string, string>; id?: string }
const { seasons, season, current, basePath, params = {}, id = 'nba-season' } = Astro.props;
const options = [...seasons].sort((a, b) => b - a);
---
<label class="visually-hidden" for={id}>Season</label>
<select id={id} class="form-select form-select-md" onchange="window.location.href = this.value">
  {options.map((s) => (
    <option value={withParams(basePath, { ...params, season: String(s) }, { season: String(current) })} selected={s === season}>{seasonLabel(s)}</option>
  ))}
</select>
