---
/**
 * One college team's tournament run (BB-G59, behind 'bball-series'): the header with the result, the game strip (each
 * game's round, opponent and score, and the run's record after it, linking to the game page), the team's totals over the
 * run, and the player tables (per-game lines and the shift from the regular season). Every number is a producer column
 * (routes/basketball/runs.ts); one per cell. `?spoilers=off` keeps the result out of the head; the body is the same.
 */
import GenericPage, { type PageBreadcrumb } from '../../layouts/GenericPage.astro';
import SeriesPlayerTables from './SeriesPlayerTables.astro';
import { seasonLabelFor } from '../../basketball/config';
import { gameHref, teamHrefFromEspn } from '../../nba/links';
import { LEAGUES, leaguePath } from '../../utils/league';
import { runHref, runsIndexHref, runStatus, type RunParams } from '../../routes/basketball/runs';

interface Props { data: RunParams }
const { league, id, season, games, team, players, spoilerFree } = Astro.props.data;
const shortName = LEAGUES[league].shortName;
const label = seasonLabelFor(league, season);
const last = games[games.length - 1];
const name = last.team_display_name ?? `Team ${last.team_id}`;
const tournament = last.tournament_name ?? 'Tournament';
const status = runStatus(last);
const title = `${name}: ${label} ${tournament}`;
const description = spoilerFree
    ? `${name} in the ${label} ${tournament}: every game, the team's totals and each player's line against the regular season.`
    : `${name}, ${label} ${tournament}: ${status}. Every game, the team's totals and each player's line against the regular season.`;
const url = runHref(league, id);
const shareUrl = spoilerFree ? `${url}?spoilers=off` : url;
const lastSeason = LEAGUES[league].seasons[LEAGUES[league].seasons.length - 1];
const breadcrumbs: PageBreadcrumb[] = [
    { title: shortName, url: leaguePath(league, '/'), active: false },
    { title: 'Tournaments', url: runsIndexHref(league, season, lastSeason), active: false },
    { title: `${last.team_abbreviation ?? name}: ${tournament}`, url, active: true },
];
const href = teamHrefFromEspn({ id: last.team_id }, league, season);
const where = (g: (typeof games)[number]) => (g.home_away === 'away' ? '@' : 'vs.');
const sides = [{ id: last.team_id, name, players }];
---

<GenericPage title={title} subtitle={`${label} ${shortName} ${tournament}`} description={description} slug={url} canonicalPath={shareUrl} breadcrumbs={breadcrumbs} heading={title}>
    <div class="container">
        <div class="text-center mb-3" id="run-header">
            <p class="text-muted text-small mb-1">{label} · {tournament}</p>
            <h2 class="h4 mb-1">{href ? <a href={href}>{name}</a> : <span>{name}</span>}</h2>
            <p class="mb-0 numeral" data-run-status>{status}</p>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4" id="run-strip">
            {games.map((g) => (
                <a class="card border rounded text-reset text-decoration-none p-2 text-center" style="min-width: 9rem" href={gameHref(league, g.game_id)} data-run-game={g.game_number}>
                    <span class="text-small text-muted">{g.round_name || `Game ${g.game_number}`}{g.game_date ? ` · ${g.game_date.slice(0, 10).slice(5)}` : ''}</span>
                    <span class="numeral">{where(g)} {g.opponent_abbreviation ?? g.opponent_display_name}</span>
                    <span class="numeral">
                        <span class={g.winner_team_id === g.team_id ? 'fw-bold' : 'text-muted'}>{g.team_score ?? ''}</span>
                        <span class="text-muted">-</span>
                        <span class={g.winner_team_id === g.opponent_team_id ? 'fw-bold' : 'text-muted'}>{g.opponent_score ?? ''}</span>
                    </span>
                    <span class="text-small numeral" data-run-record>{g.completed ? `${g.wins}-${g.losses}` : 'Upcoming'}</span>
                </a>
            ))}
        </div>

        {team && (
        <div class="table-responsive mb-4" id="run-team-totals">
            <h3 class="h6">Team totals</h3>
            <table class="table table-sm text-center">
                <thead>
                    <tr>
                        <th><abbr title="Run wins">W</abbr></th><th><abbr title="Run losses">L</abbr></th><th><abbr title="Points scored in the run">PTS</abbr></th><th><abbr title="Points allowed in the run">OPP</abbr></th>
                        <th>FGM</th><th>FGA</th><th>3PM</th><th>3PA</th><th>FTM</th><th>FTA</th>
                        <th>REB</th><th>AST</th><th>STL</th><th>BLK</th><th>TOV</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-run-team={team.team_id}>
                        {[team.wins, team.losses, team.pts, team.opp_pts, team.fgm, team.fga, team.fg3m, team.fg3a, team.ftm, team.fta, team.reb, team.ast, team.stl, team.blk, team.tov].map((v) => <td class="numeral">{v}</td>)}
                    </tr>
                </tbody>
            </table>
        </div>
        )}

        <SeriesPlayerTables sides={sides} unit="run" />

        <p class="text-muted text-small" id="run-provenance">
            Data from <a href="https://www.sportsdataverse.org">Sportsdataverse</a> (ESPN box scores). A run is one team's games in one tournament. Totals are the sum of the run's final game boxes, a per-game line divides by the games the player played, and the regular season leaves out the conference tournament.
        </p>
    </div>
</GenericPage>
