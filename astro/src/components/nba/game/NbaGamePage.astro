---
import GenericPage, { type PageBreadcrumb } from '../../../layouts/GenericPage.astro';
import Panel from '../../../layouts/panel/GenericPanel.astro';
import NavScroller, { type ScrollerItem } from '../../NavScroller.astro';
import NbaGameHeader from './NbaGameHeader.astro';
import NbaAdminSourceTools from './NbaAdminSourceTools.astro';
import NbaFourFactors from './NbaFourFactors.astro';
import NbaTeamBox from './NbaTeamBox.astro';
import NbaPlayerBox from './NbaPlayerBox.astro';
import NbaWinProbability from './NbaWinProbability.astro';
import NbaGameShotCharts from './NbaGameShotCharts.astro';
import NbaPlaysTable from './NbaPlaysTable.astro';
import NbaImpactBox from './NbaImpactBox.astro';
import NbaGameFlow from './NbaGameFlow.astro';
import NbaGarbageTime from './NbaGarbageTime.astro';
import { isFeatureEnabled } from '../../../utils/features';
import { cleanAbbreviation, pickGameColors } from '../../../utils/misc';
import { gameHref, scoreboardDayHref, teamHrefFromEspn } from '../../../nba/links';
import { basketballEventJsonLd } from '../../../basketball/parity';
import { LEAGUES, leaguePath } from '../../../utils/league';
import { basketball, pickRegulation } from '../../../basketball/config';
import type { NbaGame } from '../../../resources/nbaGame';
import type { BasketballSourceTools } from '../../../routes/basketball/game';
import type { ImpactBoxReads } from '../../../resources/impactBox';
import type { GameFlowReads } from '../../../resources/gameFlow';
import type { GarbageReads } from '../../../resources/garbageTime';
import { garbageView } from '../../../utils/garbageTime';
import NbaGameLines from './NbaGameLines.astro';
import type { GameLine } from '../../../utils/gameLines';

interface Props {
    game: NbaGame; /** admin + 'source-switch' only (routes/basketball/game.ts) */ sourceTools?: BasketballSourceTools
    /** BB-G1, 'bball-impact-box' and a final only: the Impact box's reads; null when one failed; absent: no panel */
    impact?: ImpactBoxReads | null
    /** BB-G28, 'bball-game-flow' and a final only: the game_flow rows; null when the read failed; absent: no panel */
    flow?: GameFlowReads | null
    /** BB-G2, 'bball-garbage-time' with the Impact box and a final only: the possession log and `?garbage=out`; absent: no toggle */
    garbage?: { reads: GarbageReads | null; out: boolean }
    /** BB-G43, 'bball-lines', live or final with a game_lines row: the market row; null when the read failed; absent: no panel */
    lines?: GameLine | null
}
const { game, sourceTools, impact, flow, garbage, lines } = Astro.props;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const title = `${game.away.team.displayName} ${game.away.score ?? ''} at ${game.home.team.displayName} ${game.home.score ?? ''} | Game on Paper`.replace(/\s+/g, ' ');
const description = `${game.away.team.displayName} at ${game.home.team.displayName}: win probability, biggest plays, four factors, advanced box score and shot charts.`;
const breadcrumbs: PageBreadcrumb[] = [{ title: LEAGUES[league].shortName, url: leaguePath(league, '/'), active: false }, { title: 'Scoreboard', url: scoreboardDayHref(league, game.date), active: false }, { title: `${cleanAbbreviation(game.away.team)} @ ${cleanAbbreviation(game.home.team)}`, active: true }];
const items: ScrollerItem[] = [{ href: '#wp', title: 'Win probability' }, ...(flow !== undefined ? [{ href: '#flow', title: 'Game flow' }] : []), ...(lines !== undefined ? [{ href: '#lines', title: 'Lines' }] : []), { href: '#factors', title: 'Four factors' }, { href: '#teambox', title: 'Team box' }, { href: '#players', title: 'Players' }, ...(impact !== undefined ? [{ href: '#impact', title: 'Impact' }] : []), { href: '#shots', title: 'Shots' }, { href: '#plays', title: 'Plays' }];
const side = (s: typeof game.home) => ({ name: s.team.displayName, href: teamHrefFromEspn(s.team, league, game.season), score: s.score });
const jsonLd = basketballEventJsonLd({ league, path: gameHref(league, game.id), date: game.date, description, venue: game.venue, statusDetail: game.status.detail, home: side(game.home), away: side(game.away) });
const colors = isFeatureEnabled('game-colours', Astro.locals) ? pickGameColors(game.home.team, game.away.team) : null;
// BB-G2: undefined (the page as without the flag) unless the log flags garbage time; `split` only on `?garbage=out`
const gt = garbage && garbageView(garbage.reads, impact, garbage.out, league, game.regulation, pickRegulation(cfg.regulation, game.season, game.regulation).periodMinutes);
const split = gt?.rates ? gt : undefined;
---
<GenericPage title={title} subtitle={description} slug={gameHref(league, game.id)} breadcrumbs={breadcrumbs} description={description} jsonLd={[jsonLd]}>
  <link href="/assets/css/sticky-table.css" rel="stylesheet">
  <div class="container">
    <NbaGameHeader game={game} />{sourceTools && <NbaAdminSourceTools game={game} tools={sourceTools} />}
    <div class="game-nav-sticky py-1 mb-3 border-top border-bottom"><NavScroller items={items} /></div>
    <Panel id="wp" title="Win probability" show={true}><div slot="panel-body"><NbaWinProbability game={game} colors={colors} /></div></Panel>{flow !== undefined && (<Panel id="flow" title="Game flow" show={true}><div slot="panel-body"><NbaGameFlow game={game} flow={flow} /></div></Panel>)}{lines !== undefined && (<Panel id="lines" title="Lines and markets" show={true}><div slot="panel-body"><NbaGameLines line={lines} home={game.home.team} away={game.away.team} game={game} /></div></Panel>)}
    <Panel id="factors" title="Four factors" show={true}><div slot="panel-body">{split ? <NbaGarbageTime game={game} view={split} part="factors" /> : <NbaFourFactors game={game} />}</div></Panel>
    <Panel id="teambox" title="Team box" show={true}><div slot="panel-body">{split?.box ? <NbaGarbageTime game={game} view={split} part="teambox" /> : (<Fragment>{split && <NbaGarbageTime game={game} view={split} part="teambox" />}<NbaTeamBox game={game} /></Fragment>)}</div></Panel>
    <Panel id="players" title="Players" show={true}><div slot="panel-body">{split && <NbaGarbageTime game={game} view={split} part="whole" />}<div class="row"><div class="col-12 col-xl-6"><NbaPlayerBox side={game.away} id="box-away" league={league} /></div><div class="col-12 col-xl-6"><NbaPlayerBox side={game.home} id="box-home" league={league} /></div></div></div></Panel>{impact !== undefined && (<Panel id="impact" title="Impact and lineups" show={true}><div slot="panel-body">{gt && <NbaGarbageTime game={game} view={gt} part="toggle" />}<NbaImpactBox game={game} impact={gt?.impact ?? impact} fromLog={gt?.impact !== undefined} /></div></Panel>)}
    <Panel id="shots" title="Shot charts" show={true}><div slot="panel-body"><NbaGameShotCharts game={game} /></div></Panel>
    <Panel id="plays" title="Play-by-play" show={true}><div slot="panel-body"><NbaPlaysTable game={game} /></div></Panel>
  </div>
</GenericPage>
