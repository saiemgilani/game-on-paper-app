---
import { DateTime } from 'luxon';
import GenericPage, { type PageBreadcrumb } from '../../../layouts/GenericPage.astro';
import GameTitle from '../../game/GameTitle.astro';
import LocalDate from '../../LocalDate.svelte';
import { gameHref, scoreboardDayHref, teamHrefFromEspn } from '../../../nba/links';
import { LEAGUES, leaguePath } from '../../../utils/league';
import { basketball } from '../../../basketball/config';
import { cleanAbbreviation } from '../../../utils/misc';
import RecentForm from '../../game/RecentForm.astro';
import NbaPlayersToWatch from './NbaPlayersToWatch.astro';
import NbaGameInfo from './NbaGameInfo.astro';
import { pregameInfo } from '../../../resources/gameInfo';
import NbaGameLines from './NbaGameLines.astro';
import { retrieveGameLine } from '../../../resources/gameLines';
import { hasLine } from '../../../utils/gameLines';
import { isFeatureEnabled } from '../../../utils/features';
import { basketballEventJsonLd } from '../../../basketball/parity';
import { retrieveGameSummary, type ESPNPlayByPlayResponse } from '../../../resources/espn';
import NbaPregameProjection from './NbaPregameProjection.astro';
import type { PregameProjection } from '../../../routes/basketball/game';

/** `projection`: BB-G18, set only with 'bball-pregame-projection' on (null: no card); `ourHomeWp`: its win chance for the Lines panel (#459) */
interface Props { espnGame: ESPNPlayByPlayResponse; projection?: PregameProjection | null; ourHomeWp?: number | null }
const { espnGame, projection, ourHomeWp } = Astro.props;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const comp = espnGame.gamepackageJSON.header.competitions[0];
const home = comp.competitors.find((c: any) => c.homeAway === 'home') ?? comp.competitors[0];
const away = comp.competitors.find((c: any) => c.homeAway === 'away') ?? comp.competitors[1];
const rec = (c: any) => c?.record?.[0]?.summary ?? c?.records?.[0]?.summary ?? '';
const ab = (c: any) => cleanAbbreviation(c.team);
// "ATL 0-0", or just "ATL" when the record is missing
const side = (c: any) => [ab(c), rec(c)].filter(Boolean).join(' ');
const paren = (c: any) => (rec(c) ? ` (${rec(c)})` : '');
// BB-G43 ('bball-lines'): the market row beside the summary's read; no row, no panel; a failed read says so
const linesRead = isFeatureEnabled('bball-lines', Astro.locals) ? retrieveGameLine(league, espnGame.gamepackageJSON.header.season?.year ?? null, String(espnGame.gameId)).then((row) => (row && hasLine(row) ? row : undefined), (e: any) => { console.error(`ERROR while loading the ${league} game lines for game ${espnGame.gameId}: ${e}`); return null; }) : undefined;
// the line is the summary's pickcenter, shown only when ESPN has one (never a default)
const summary = await retrieveGameSummary(espnGame.gameId, league, AbortSignal.timeout(3000)); // a slow ESPN must not stall a cold pregame render
const line = summary?.pickcenter?.[0]?.details || null;
const title = `${away.team.displayName} at ${home.team.displayName} | Game on Paper`;
const description = `${away.team.displayName}${paren(away)} at ${home.team.displayName}${paren(home)}: tip time and broadcast. Win probability, four factors and shot charts arrive at tip-off.`;
const breadcrumbs: PageBreadcrumb[] = [{ title: LEAGUES[league].shortName, url: leaguePath(league, '/'), active: false }, { title: 'Scoreboard', url: scoreboardDayHref(league, comp.date), active: false }, { title: `${ab(away)} @ ${ab(home)}`, active: true }];
const networks = ((comp as any).broadcasts ?? []).map((b: any) => b?.media?.shortName).filter(Boolean).join(', ');
const season = espnGame.gamepackageJSON.header.season?.year ?? null;
// BB-G42 ('bball-game-info'): the crew and the injury report from the summary above, the profiles from the Data API; a failed read costs the panel
const info = isFeatureEnabled('bball-game-info', Astro.locals) ? await pregameInfo(league, season, summary).catch((e: any) => { console.error(`ERROR while loading the ${league} game info for game ${espnGame.gameId}: ${e}`); return null; }) : undefined;
const lines = await linesRead;
const jsonLd = basketballEventJsonLd({
    league, path: gameHref(league, espnGame.gameId), date: comp.date, description, venue: (comp as any).venue?.fullName ?? null, statusDetail: comp.status?.type?.description ?? null,
    home: { name: home.team.displayName, href: teamHrefFromEspn(home.team, league, season), score: null },
    away: { name: away.team.displayName, href: teamHrefFromEspn(away.team, league, season), score: null },
});
---
<GenericPage title={title} subtitle={description} slug={gameHref(league, espnGame.gameId)} breadcrumbs={breadcrumbs} description={description} jsonLd={[jsonLd]}>
  <div class="container py-3 text-center">
    <GameTitle awayTeam={away.team} homeTeam={home.team} links={false} hrefOf={(t) => teamHrefFromEspn(t, league, espnGame.gamepackageJSON.header.season?.year)} league={league} />
    <LocalDate client:only divClass="text-small m-0" date={comp.date} format={DateTime.DATETIME_FULL} prefix={comp.status.type.description ?? 'Scheduled'}><p slot="fallback" class="text-small m-0">&nbsp;</p></LocalDate>
    <p class="text-muted m-0">{side(away)}, {side(home)}</p>
    {line && <p class="text-muted m-0">{`Line: ${line}`}</p>}
    {networks && <p class="text-muted m-0">{networks}</p>}
  </div>
  <div class="container">
    {projection && <NbaPregameProjection projection={projection} homeTeam={home.team} awayTeam={away.team} />}
    {season !== null && <NbaPlayersToWatch homeTeam={home.team} awayTeam={away.team} season={season} />}
    <RecentForm summary={summary} homeTeam={home.team} awayTeam={away.team} />
    {info !== undefined && (<section id="info" class="mt-3"><h2 class="h5">Game info</h2><NbaGameInfo info={info} home={home.team} away={away.team} season={season} /></section>)}{lines !== undefined && (<section id="lines" class="mt-3"><h2 class="h5">Lines and markets</h2><NbaGameLines line={lines} home={home.team} away={away.team} ours={ourHomeWp ?? null} /></section>)}
  </div>
</GenericPage>
