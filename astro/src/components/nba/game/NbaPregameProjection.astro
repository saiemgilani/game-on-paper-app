---
// BB-G18 (behind 'bball-pregame-projection'): the pregame page's Projection, football's GameEssentials projection column
// for basketball. The favourite, the expected margin and its win chance from the producer's ratings and closed form
// (utils/pregameProjection.ts); each side's rating, its rank and games, and the home edge it carries.
import { basketball, seasonLabelFor } from '../../../basketball/config';
import { cleanAbbreviation, generateMarginalString, roundNumber } from '../../../utils/misc';
import { teamLogoUrl } from '../../../utils/league';
import { pct } from '../../../utils/playoff';
import type { PregameProjection } from '../../../routes/basketball/game';
import DarkModeLogos from '../../DarkModeLogos.astro';

interface Props {
    projection: PregameProjection
    homeTeam: { id: string | number; abbreviation?: string }
    awayTeam: { id: string | number; abbreviation?: string }
}
const { projection: p, homeTeam, awayTeam } = Astro.props;
const league = basketball(Astro.locals.league).league;
const college = league === 'mbb' || league === 'wbb';
const { margin, homeWinProb, hfa } = p.projection;
const homeFav = margin >= 0;
const fav = homeFav ? homeTeam : awayTeam;
const favProb = homeFav ? homeWinProb : 1 - homeWinProb;
const metric = college ? 'adjusted efficiency margin' : 'adjusted net rating';
const signed = (x: number) => generateMarginalString(x, 2, 1);
const sideText = (t: Props['homeTeam'], r: PregameProjection['home']) =>
    `${cleanAbbreviation(t as any)} ${signed(r.rating)}${r.rank != null ? ` (#${roundNumber(r.rank, 0, 0)})` : ''}${r.games != null ? `, ${r.games} ${r.games === 1 ? 'game' : 'games'}` : ''}`;
const edge = p.neutral ? 'neutral site, no home edge' : `home court ${signed(hfa)} pts`;
---
<DarkModeLogos teamIds={[fav.id]} />
<div class="row my-3">
    <div class="col-lg-2 d-none d-lg-block"></div>
    <div class="col-lg-8 col-md-12 margin-override">
        <div class="card border rounded">
            <div class="card-body py-3 text-center" id="pregame-projection">
                <p class="small text-muted text-uppercase mb-1">Projection</p>
                <p class="mb-0 fw-bold d-flex align-items-center justify-content-center gap-1">
                    <img class={`team-logo-${fav.id}`} width="24" height="24" src={teamLogoUrl(league, fav.id, false, p.season)} alt={cleanAbbreviation(fav as any)} />
                    <span>{Math.abs(margin) < 0.05 ? 'Even' : `${cleanAbbreviation(fav as any)} by ${roundNumber(Math.abs(margin), 2, 1)}`}</span>
                </p>
                <p class="small text-muted m-0">{pct(favProb)} by {metric}, {seasonLabelFor(league, p.season)}</p>
                <p class="small text-muted m-0">{sideText(awayTeam, p.away)}; {sideText(homeTeam, p.home)}; {edge}</p>
            </div>
        </div>
    </div>
</div>
