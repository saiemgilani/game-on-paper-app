---
// src/components/nba/game/NbaEpvBox.astro
// BB-G26, behind 'bball-epv': the NBA game page's EPV box, football's per-player EPA. Each side's EPV added with the ball
// and allowed, and each player's EPV added on their own events and on-court EPV +/-. Every number is the producer's
// (sdv-db epv_player_games / epv_team_games, sdv-py nba_epv_*); this reads, orders and formats.
import type { NbaGame } from '../../../resources/nbaGame';
import { epvSide, type EpvBoxReads } from '../../../resources/epvBox';
import { fmtInt } from '../../../nba/format';
import { cleanAbbreviation } from '../../../utils/misc';

interface Props { game: NbaGame; epv: EpvBoxReads | null }
const { game, epv } = Astro.props;
const dash = '—';
const minus = '−';
const signed = (v: number | null | undefined, digits = 1) => (v == null ? dash : v > 0 ? `+${v.toFixed(digits)}` : v < 0 ? `${minus}${Math.abs(v).toFixed(digits)}` : (0).toFixed(digits));
const int = (v: number | null | undefined) => (v == null ? dash : fmtInt(v));
const perPoss = (v: number | null | undefined) => (v == null ? dash : signed(v, 2));
const built = epv && epv.players.length > 0;
const sides = built
    ? (['away', 'home'] as const).map((key) => ({ key, abbr: cleanAbbreviation(game[key].team), name: game[key].team.displayName, ...epvSide(epv, key) }))
    : [];
---
{epv === null ? (<p class="text-muted" id="epv-unavailable">The EPV box is temporarily unavailable.</p>) : !built ? (<p class="text-muted" id="epv-empty">The EPV box is not built for this game yet; it follows the nightly ingest.</p>) : (
<Fragment>
<div class="table-responsive"><table class="table table-sm numeral align-middle" aria-label="Team EPV">
  <thead><tr><th scope="col">Team</th><th scope="col" class="text-end"><abbr title="EPV added on the team's own possessions: points scored above what each possession's start was worth">Off. EPV</abbr></th><th scope="col" class="text-end"><abbr title="The opponent's EPV added: lower is better">Def. EPV</abbr></th><th scope="col" class="text-end"><abbr title="Off. minus Def. EPV">Net</abbr></th><th scope="col" class="text-end">Poss</th><th scope="col" class="text-end"><abbr title="Off. EPV per possession">Off./poss</abbr></th><th scope="col" class="text-end"><abbr title="Def. EPV per opponent possession">Def./poss</abbr></th></tr></thead>
  <tbody>
    {sides.map((s) => (
      <tr>
        <th scope="row" class="fw-normal">{s.abbr}</th>
        <td class="text-end">{signed(s.team?.off_epv)}</td>
        <td class="text-end">{signed(s.team?.def_epv)}</td>
        <td class="text-end fw-bold">{signed(s.team?.net_epv)}</td>
        <td class="text-end">{int(s.team?.poss)}</td>
        <td class="text-end">{perPoss(s.team?.off_epv_per_poss)}</td>
        <td class="text-end">{perPoss(s.team?.def_epv_per_poss)}</td>
      </tr>
    ))}
  </tbody>
</table></div>
<div class="row">
  {sides.map((s) => (
    <div class="col-12 col-xl-6" id={`epv-${s.key}`}>
      <h3 class="h6">{s.name}</h3>
      {s.players.length === 0 ? (<p class="text-muted small">No EPV rows for {s.abbr}.</p>) : (
      <div class="table-responsive"><table class="table table-sm numeral align-middle" aria-label={`${s.abbr} EPV`}>
        <thead><tr><th scope="col">Player</th><th scope="col" class="text-end"><abbr title="EPV added on the player's own events: shots, turnovers, rebounds, fouls, steals and blocks">EPV added</abbr></th><th scope="col" class="text-end"><abbr title="The player's own events">Plays</abbr></th><th scope="col" class="text-end"><abbr title="The team's EPV added with the ball while the player was on the floor">On off.</abbr></th><th scope="col" class="text-end"><abbr title="The opponent's EPV added while the player was on the floor: lower is better">On def.</abbr></th><th scope="col" class="text-end"><abbr title="On-court EPV +/-: On off. minus On def.">On net</abbr></th></tr></thead>
        <tbody>
          {s.players.map((p) => (
            <tr>
              <th scope="row" class="fw-normal text-nowrap">{p.name}</th>
              <td class="text-end fw-bold">{signed(p.epv_own)}</td>
              <td class="text-end">{int(p.own_actions)}</td>
              <td class="text-end">{signed(p.off_epv_on)}</td>
              <td class="text-end">{signed(p.def_epv_on)}</td>
              <td class="text-end">{signed(p.epv_on)}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
      )}
    </div>
  ))}
</div>
<p class="small text-muted mb-0">EPV is the offense's expected points to the end of the possession; EPV added is the points plus the EPV after a play minus the EPV before it, basketball's EPA. These are sums like +/-, not rankings.</p>
</Fragment>
)}
