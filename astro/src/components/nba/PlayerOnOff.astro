---
// src/components/nba/PlayerOnOff.astro
// BB-G7, behind 'bball-player-on-off' (all four leagues; college through ncaa_player_crosswalk, resources/playerOnOff.ts):
// the player page's On/Off section. On/Off: his team with him on the floor
// and off it, and the difference, per 100 possessions, one row per team he played for; a rating is shaded by the
// producer's league percentile where he is ranked (on and on-off only). Top partners: the teammates he shared the most
// minutes with, each split four ways (the team page's WOWY table, BB-G4). Every number is the producer's (sdv-db
// player_on_off / player_wowy).
import { RATINGS, type OnOffRow, type Rating } from '../../resources/playerOnOff';
import type { PlayerOnOff } from '../../utils/playerOnOff';
import { fmtInt } from '../../nba/format';
import { playerHref, teamHref, teamHrefFromEspn } from '../../nba/links';
import { generateColorRampValue, generateMarginalString } from '../../utils/misc';
import { basketball, seasonLabelFor } from '../../basketball/config';
import { PRO_LEAGUES } from '../../utils/league';

interface Props { data: PlayerOnOff; season: number; q: string; name: string }
const { data, season, q, name } = Astro.props;
const cfg = basketball(Astro.locals.league);
const league = cfg.league;
const pro = PRO_LEAGUES.includes(league);
// college rows carry ESPN team ids, whose page is a 404 for a season's non-member: the game page's member-aware link
const teamLink = (id: number) => (pro ? teamHref(id, q, league) : teamHrefFromEspn({ id }, league, season));
const label = seasonLabelFor(league, season);
const { teams, partners, names, tricodes } = data;

const dash = '—';
const shade = (pct: number | null | undefined) => generateColorRampValue(pct ?? null, 100);
const rtg = (v: number | null | undefined) => (v == null ? dash : v.toFixed(1));
const net = (v: number | null | undefined) => (v == null ? dash : generateMarginalString(v, 1, 1));
const fmt = (m: Rating, side: 'on' | 'off' | 'diff', v: number | null) => (m === 'net_rtg' || side === 'diff' ? net(v) : rtg(v));
const HEAD: Record<Rating, { label: string; hover: string }> = {
    off_rtg: { label: 'ORtg', hover: 'Points scored per 100 possessions' },
    def_rtg: { label: 'DRtg', hover: 'Points allowed per 100 possessions' },
    net_rtg: { label: 'Net', hover: 'ORtg minus DRtg' },
};
const pctOf = (p: OnOffRow, m: Rating, side: 'on' | 'off' | 'diff') => (side === 'off' ? null : p[`${m}_${side}_pct`]);
const tricode = (id: number) => tricodes.get(String(id)) ?? `#${id}`;
---
<section id="on-off" aria-label={`${label} on/off`} class="mb-4">
  <h2 class="h5">On/Off</h2>
  {teams === null ? (<p class="text-muted" id="on-off-unavailable">The {label} on/off numbers are temporarily unavailable.</p>) : teams.length === 0 ? (<p class="text-muted" id="on-off-empty">No {label} on/off numbers for {name} yet.</p>) : (
    <Fragment>
      <p class="small text-muted mb-2" id="on-off-note">On is the team with {name} on the floor; off is the rest of the team's season: every one of its games, including any before the player joined or after the player left, and the games the player missed. So on plus off is always the team's whole season.{pro && cfg.statsSourceLabel && ` ${cfg.statsSourceLabel} counts the off side only while the player was on the roster, so for a player traded or signed mid-season its numbers differ from these.`}</p>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0" id="on-off-table">
          <caption class="small text-muted">Per 100 possessions. Shading by league percentile where {name} is ranked (on and on − off); a plain cell is below the rank gate.</caption>
          <thead>
            <tr>
              <td colspan="4"></td>
              <th scope="colgroup" colspan="3" class="text-center">On the floor</th>
              <th scope="colgroup" colspan="3" class="text-center">Off the floor</th>
              <th scope="colgroup" colspan="3" class="text-center">On − off</th>
            </tr>
            <tr>
              <th scope="col">Team</th>
              <th scope="col" class="text-end"><abbr title="Games played for the team, of its games">GP</abbr></th>
              <th scope="col" class="text-end"><abbr title="Minutes on the floor">Min on</abbr></th>
              <th scope="col" class="text-end"><abbr title="The team's minutes with the player off the floor">Min off</abbr></th>
              {(['on', 'off', 'diff'] as const).flatMap(() => RATINGS.map((m) => (<th scope="col" class="text-end text-nowrap"><abbr title={HEAD[m].hover}>{HEAD[m].label}</abbr></th>)))}
            </tr>
          </thead>
          <tbody>
            {teams.map((t) => (
              <tr>
                <th scope="row" class="fw-normal text-nowrap">{teamLink(t.team_id) ? (<a href={teamLink(t.team_id)!}>{tricode(t.team_id)}</a>) : tricode(t.team_id)}</th>
                <td class="numeral text-end text-nowrap">{fmtInt(t.games)} of {fmtInt(t.team_games)}</td>
                <td class="numeral text-end">{fmtInt(t.minutes_on)}</td>
                <td class="numeral text-end">{fmtInt(t.minutes_off)}</td>
                {(['on', 'off', 'diff'] as const).flatMap((side) => RATINGS.map((m) => (<td class:list={['numeral', 'text-end', shade(pctOf(t, m, side))]}>{fmt(m, side, t[`${m}_${side}`])}</td>)))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div id="wowy" class="mt-3">
        <h3 class="h6">Top partners</h3>
        {partners.length === 0 ? (<p class="text-muted" id="wowy-empty">No {label} teammate pairs for {name} yet.</p>) : (
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" id="wowy-table">
              <caption class="small text-muted">The {partners.length} teammates {name} shared the most minutes with: the team's minutes and net rating per 100 possessions in each part of its season. The four parts add up to the team's season.</caption>
              <thead>
                <tr>
                  <td></td>
                  <th scope="colgroup" colspan="2" class="text-center">Together</th>
                  <th scope="colgroup" colspan="2" class="text-center">{name} without</th>
                  <th scope="colgroup" colspan="2" class="text-center">Teammate without</th>
                  <th scope="colgroup" colspan="2" class="text-center">Neither</th>
                </tr>
                <tr>
                  <th scope="col">Teammate</th>
                  {[0, 1, 2, 3].flatMap(() => [(<th scope="col" class="text-end">Min</th>), (<th scope="col" class="text-end"><abbr title={HEAD.net_rtg.hover}>Net</abbr></th>)])}
                </tr>
              </thead>
              <tbody>
                {partners.map((l) => (
                  <tr>
                    <th scope="row" class="fw-normal text-nowrap">{names.has(l.teammate) ? (<a href={playerHref(Number(l.teammate), q, league)}>{names.get(l.teammate)}</a>) : `#${l.teammate}`}</th>
                    {[l.together, l.without, l.mateOnly, l.neither].flatMap((s) => [(<td class="numeral text-end">{fmtInt(s.minutes)}</td>), (<td class="numeral text-end">{net(s.net)}</td>)])}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </Fragment>
  )}
</section>
