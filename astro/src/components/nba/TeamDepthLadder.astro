---
// src/components/nba/TeamDepthLadder.astro
// BB-G61, behind 'bball-depth-ladder': the team page's depth ladder. One row per tier, best first: the team's players the
// producer put in it (sdv-db's player_war `war_tier`, a player on the team they played most possessions for), how many, and
// the league's median players per team in that tier (sdv-db's roster_tier_shape). Every tier and median is sdv-py's
// (BB-G61); a player without a tier stays off. A name links to the player page when the roster has one (`pages`: the
// roster's ids, ESPN's in college like player_war's). `data` null: a failed read, and the section says so.
import type { DepthLadderReads } from '../../resources/depthLadder';
import { fmtDec, fmtInt } from '../../nba/format';
import { playerHref } from '../../nba/links';
import { basketball, seasonLabelFor } from '../../basketball/config';
import { DEPTH_LADDER_NOTE, depthLadder } from '../../utils/depthLadder';

interface Props { data: DepthLadderReads | null; season: number; seasonQuery: string; teamName: string; pages: ReadonlySet<string> }
const { data, season, seasonQuery, teamName, pages } = Astro.props;
const league = basketball(Astro.locals.league).league;
const label = seasonLabelFor(league, season);
const rungs = data ? depthLadder(data.players, data.shape) : [];
const href = (id: string) => (pages.has(id) ? playerHref(Number(id), seasonQuery, league) : null);
---
<section id="depth-ladder" aria-label="Depth ladder" class="mb-4">
  <h2 class="h5">Depth ladder</h2>
  {data === null ? (<p class="text-muted" id="depth-ladder-unavailable">The {label} depth ladder is temporarily unavailable.</p>) : (<Fragment>
  <div class="table-responsive">
    <table class="table table-sm align-middle mb-1" id="depth-ladder-table">
      <caption class="small text-muted">{teamName}'s {label} players by WAR tier, beside the league's median roster.</caption>
      <thead><tr class="text-nowrap"><th scope="col">Tier</th><th scope="col">Players</th><th scope="col" class="text-end">Team players</th><th scope="col" class="text-end"><abbr title="The median number of players per team in this tier">League median</abbr></th></tr></thead>
      <tbody>
        {rungs.map((r) => (
          <tr data-tier={r.tier}>
            <th scope="row" class="text-nowrap">{r.tier}{r.band && (<span class="d-block small text-muted fw-normal">percentile {r.band}</span>)}</th>
            <td>{r.players.length === 0 ? (<Fragment><span class="text-muted" aria-hidden="true">—</span><span class="visually-hidden">No players</span></Fragment>) : r.players.map((p, i) => (<Fragment>{i > 0 && ', '}{href(p.id) ? (<a href={href(p.id)!}>{p.name}</a>) : p.name}</Fragment>))}</td>
            <td class="numeral text-end">{fmtInt(r.players.length)}</td>
            <td class="numeral text-end">{r.median == null ? (<Fragment><span aria-hidden="true">—</span><span class="visually-hidden">No median</span></Fragment>) : fmtDec(r.median, 1)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small text-muted mb-0" id="depth-ladder-note">{DEPTH_LADDER_NOTE}</p>
  </Fragment>)}
</section>
