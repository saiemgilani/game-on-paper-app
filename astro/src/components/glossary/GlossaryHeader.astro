---
interface Props {
	keys: string[];
}

const { keys } = Astro.props;
---

<div class="container-fluid">
    <nav class="d-none d-lg-flex nav justify-content-center mt-3">
        {
            keys.map((k, i, arr) => (
                <a class="link-primary p-2" href={`#glossary-section-${k}`}>{k.toLocaleUpperCase()}</a>
                <span class="p align-self-center" hidden={i == arr.length - 1}>&#9899;</span>
            ))
        }
    </nav>
</div>
<div class="d-inline d-lg-none" style="background: inherit;">
    <div class="game-nav-sticky py-1 mt-n3 mb-3 border-bottom">
        <select class="form-select form-select-md" style="min-width:250px;border:0;" id="glossary-section-picker">
            <option disabled selected>Navigate to...</option>
            {
                (keys.map((k) => <option value={`#glossary-section-${k}`}>{k.toLocaleUpperCase()}</option>))
            }
        </select>
    </div>
</div>
<script>
    document.getElementById("glossary-section-picker")?.addEventListener("change", (e: Event) => {
        const href = (e.target as HTMLSelectElement).value;
        if (href && href.startsWith("#")) {
            document.getElementById(href.replace("#", ""))?.scrollIntoView({ behavior: "smooth"})
        } else if (href && (href.startsWith("/") || href.startsWith("https://"))) {
            const aTag: HTMLAnchorElement = document.createElement("a")
            aTag.href = href;
            aTag.target = "__blank"
            aTag.click()
        }
    })
</script>