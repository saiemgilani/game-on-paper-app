---
import type { GlossaryEntry } from '../../resources/glossary';
import type { Term } from '../../utils/seo';
import GlossaryItem from './GlossaryItem.astro';

interface Props {
    letter: string
	entries?: GlossaryEntry[];

	/** entry -> deep-link id, from termSlugs() over the whole glossary */

	slugs: Map<Term, string>;
}

const { letter, entries, slugs } = Astro.props;
---

<h2 id={`glossary-section-${letter}`}>{letter.toLocaleUpperCase()}</h2>
{
    entries?.map((e) => (
        <GlossaryItem entry={e} slug={slugs.get(e)!} />
    ))
}
