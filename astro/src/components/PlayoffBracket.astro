---
import type { BracketRound, BracketSlot } from '../utils/playoff';
import { pct } from '../utils/playoff';
import { teamLogoUrl } from '../utils/league';

interface Props {
    rounds: BracketRound[]
    champion: BracketSlot
    names: Record<string, string>
}
const { rounds, champion, names } = Astro.props;
---
<div class="playoff-bracket" role="group" aria-label="Projected College Football Playoff bracket">
    {rounds.map((round, r) => (
        <div class="bracket-round">
            <h2 class="bracket-round-name">{round.name}</h2>
            <div class={`bracket-games${r === rounds.length - 1 ? ' bracket-final' : ''}`}>
                {round.games.map((game) => (
                    <div class="bracket-game">
                        {game.map((s) => (
                            <a class="bracket-slot" href={`/team/${s.teamId}`}>
                                <span class="bracket-seed">{s.seed}</span>
                                <img class={`team-logo-${s.teamId}`} width="20" height="20" src={teamLogoUrl('cfb', s.teamId, false)} alt="" />
                                <span class="bracket-team">{names[s.teamId] ?? s.teamId}</span>
                                <span class="bracket-pct" title="Chance to beat this opponent">{pct(s.pct)}</span>
                            </a>
                        ))}
                    </div>
                ))}
                {r === rounds.length - 1 && (
                    <div>
                        <h2 class="bracket-round-name">Champion</h2>
                        <div class="bracket-game bracket-champion">
                            <a class="bracket-slot" href={`/team/${champion.teamId}`}>
                                <span class="bracket-seed">{champion.seed}</span>
                                <img class={`team-logo-${champion.teamId}`} width="20" height="20" src={teamLogoUrl('cfb', champion.teamId, false)} alt="" />
                                <span class="bracket-team">{names[champion.teamId] ?? champion.teamId}</span>
                                <span class="bracket-pct" title="Chance to win the title, if the projected field holds">{pct(champion.pct)}</span>
                            </a>
                        </div>
                    </div>
                )}
            </div>
        </div>
    ))}
</div>

<style>
    /* each column spaces its games evenly, so a later game sits between the two that feed it */
    .playoff-bracket {
        display: grid;
        grid-template-columns: repeat(4, minmax(11rem, 1fr));
        gap: 0.75rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }
    .bracket-round {
        display: flex;
        flex-direction: column;
    }
    .bracket-round-name {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--bs-secondary-color);
        margin-bottom: 0.5rem;
    }
    .bracket-games {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        gap: 0.75rem;
    }
    /* the title game sits level with the gap between the semifinals, the champion under it */
    .bracket-final {
        justify-content: center;
    }
    .bracket-game {
        border: 1px solid var(--bs-border-color);
        border-radius: 0.375rem;
        background: var(--bs-body-bg);
    }
    .bracket-champion {
        border-width: 2px;
        border-color: var(--bs-emphasis-color);
    }
    .bracket-slot {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.3rem 0.5rem;
        color: inherit;
        text-decoration: none;
        font-size: 0.85rem;
    }
    .bracket-slot + .bracket-slot {
        border-top: 1px solid var(--bs-border-color);
    }
    .bracket-seed {
        width: 1.25rem;
        text-align: right;
        color: var(--bs-secondary-color);
        font-variant-numeric: tabular-nums;
    }
    .bracket-team {
        flex: 1;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .bracket-pct {
        color: var(--bs-secondary-color);
        font-variant-numeric: tabular-nums;
    }
</style>
