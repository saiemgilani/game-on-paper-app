---
import type { BracketRound, BracketSlot } from '../utils/playoff';
import { pct } from '../utils/playoff';
import { teamLogoUrl } from '../utils/league';

interface Props {
    rounds: BracketRound[]
    champion: BracketSlot
    /** cleaned full names (md and up) and abbreviations (mobile), by team id */
    names: Record<string, string>
    abbrs: Record<string, string>
}
const { rounds, champion, names, abbrs } = Astro.props;
const name = (id: string) => names[id] ?? id;
const abbr = (id: string) => abbrs[id] ?? name(id);
const BEAT = 'Chance to beat this opponent';
const TITLE = 'Chance to win the title, if the projected field holds';
---
<!-- md and up: the bracket graphic, each game a bordered two-row table -->
<div class="playoff-bracket d-none d-md-grid" role="group" aria-label="Projected College Football Playoff bracket">
    {rounds.map((round, r) => (
        <div class="bracket-round">
            <h2 class="bracket-round-name">{round.name}</h2>
            <div class={`bracket-games${r === rounds.length - 1 ? ' bracket-final' : ''}`}>
                {round.games.map((game) => (
                    <table class="table table-sm table-bordered align-middle mb-0 bracket-game">
                        <tbody>
                            {game.map((s) => (
                                <tr class="bracket-slot">
                                    <td class="text-center text-muted numeral bracket-seed">{s.seed}</td>
                                    <td class="text-left text-nowrap bracket-team">
                                        <a href={`/team/${s.teamId}`}><img class={`team-logo-${s.teamId} me-2`} width="20" height="20" src={teamLogoUrl('cfb', s.teamId, false)} alt="" />{name(s.teamId)}</a>
                                    </td>
                                    <td class="text-center numeral bracket-pct" title={BEAT}>{pct(s.pct)}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                ))}
                {r === rounds.length - 1 && (
                    <div>
                        <h2 class="bracket-round-name">Champion</h2>
                        <table class="table table-sm table-bordered align-middle mb-0 bracket-game bracket-champion">
                            <tbody>
                                <tr class="bracket-slot">
                                    <td class="text-center text-muted numeral bracket-seed">{champion.seed}</td>
                                    <td class="text-left text-nowrap bracket-team">
                                        <a href={`/team/${champion.teamId}`}><img class={`team-logo-${champion.teamId} me-2`} width="20" height="20" src={teamLogoUrl('cfb', champion.teamId, false)} alt="" />{name(champion.teamId)}</a>
                                    </td>
                                    <td class="text-center numeral bracket-pct" title={TITLE}>{pct(champion.pct)}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                )}
            </div>
        </div>
    ))}
</div>

<!-- mobile: the same games as one table, grouped by round, by abbreviation -->
<div class="table-responsive d-md-none">
    <table class="table table-sm align-middle bracket-table" aria-label="Projected College Football Playoff bracket">
        <tbody>
            {rounds.map((round) => (
                <>
                    <tr><td colspan="4" class="gt_group_heading fw-bold">{round.name}</td></tr>
                    {round.games.map(([a, b]) => (
                        <tr class="bracket-slot">
                            <td class="text-left text-nowrap"><a href={`/team/${a.teamId}`}><span class="text-muted numeral me-1">{a.seed}</span><img class={`team-logo-${a.teamId} me-1`} width="18" height="18" src={teamLogoUrl('cfb', a.teamId, false)} alt="" />{abbr(a.teamId)}</a></td>
                            <td class="text-center numeral" title={BEAT}>{pct(a.pct)}</td>
                            <td class="text-left text-nowrap"><a href={`/team/${b.teamId}`}><span class="text-muted numeral me-1">{b.seed}</span><img class={`team-logo-${b.teamId} me-1`} width="18" height="18" src={teamLogoUrl('cfb', b.teamId, false)} alt="" />{abbr(b.teamId)}</a></td>
                            <td class="text-center numeral" title={BEAT}>{pct(b.pct)}</td>
                        </tr>
                    ))}
                </>
            ))}
            <tr><td colspan="4" class="gt_group_heading fw-bold">Champion</td></tr>
            <tr class="bracket-slot">
                <td class="text-left text-nowrap" colspan="3"><a href={`/team/${champion.teamId}`}><span class="text-muted numeral me-1">{champion.seed}</span><img class={`team-logo-${champion.teamId} me-1`} width="18" height="18" src={teamLogoUrl('cfb', champion.teamId, false)} alt="" />{abbr(champion.teamId)}</a></td>
                <td class="text-center numeral" title={TITLE}>{pct(champion.pct)}</td>
            </tr>
        </tbody>
    </table>
</div>

<style>
    /* each column spaces its games evenly, so a later game sits between the two that feed it */
    .playoff-bracket {
        grid-template-columns: repeat(4, minmax(11rem, 1fr));
        gap: 0.75rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }
    .bracket-round {
        display: flex;
        flex-direction: column;
    }
    .bracket-round-name {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--bs-secondary-color);
        margin-bottom: 0.5rem;
    }
    .bracket-games {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        gap: 0.75rem;
    }
    /* the title game sits level with the gap between the semifinals, the champion under it */
    .bracket-final {
        justify-content: center;
    }
    .bracket-champion {
        border-width: 2px;
        border-color: var(--bs-emphasis-color);
    }
    .bracket-seed {
        width: 2rem;
    }
    .bracket-team {
        max-width: 0;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .bracket-pct {
        width: 3.25rem;
    }
</style>
