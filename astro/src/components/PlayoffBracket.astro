---
import type { BracketSlot } from '../utils/playoff';
import { pct } from '../utils/playoff';
import { leaguePath, teamLogoUrl, type League } from '../utils/league';

/** A team's slot, or (college) a First Four slot: its label names the pair whose winner takes it, with no number.
 *  A later-round slot of a game still to be played (the NBA Cup's knockout) has no seed either. */
type Slot = BracketSlot | { seed?: number; label: string };

interface Props {
    rounds: { name: string; games: [Slot, Slot][] }[]
    /** the CFP's champion box; a bracket without one (college bracketology) leaves it out */
    champion?: BracketSlot | null
    /** cleaned full names (md and up) and abbreviations (mobile), by team id */
    names: Record<string, string>
    abbrs: Record<string, string>
    /** the league of the logos and team links (the CFP's 'cfb' by default) */
    league?: League
    /** a team's link, null for plain text (a college non-member); default the league's /team/<id> */
    href?: (teamId: string) => string | null
    /** what each slot's number is */
    pctTitle?: string
    label?: string
}
const {
    rounds, champion = null, names, abbrs, league = 'cfb',
    href = (id: string) => leaguePath(league, `/team/${id}`),
    pctTitle = 'Chance to beat this opponent', label = 'Projected College Football Playoff bracket',
} = Astro.props;
const name = (id: string) => names[id] ?? id;
const abbr = (id: string) => abbrs[id] ?? name(id);
const isTeam = (s: Slot): s is BracketSlot => !('label' in s);
const TITLE = 'Chance to win the title, if the projected field holds';
// the CFP's four rounds keep the stylesheet's column count; any other bracket sets its own
const cols = rounds.length === 4 ? undefined : `--bracket-rounds: ${rounds.length}`;
---
<!-- md and up: the bracket graphic, each game a bordered two-row table -->
<div class="playoff-bracket d-none d-md-grid" role="group" aria-label={label} style={cols}>
    {rounds.map((round, r) => (
        <div class="bracket-round">
            <h2 class="bracket-round-name">{round.name}</h2>
            <div class={`bracket-games${champion && r === rounds.length - 1 ? ' bracket-final' : ''}`}>
                {round.games.map((game) => (
                    <table class="table table-sm table-bordered align-middle mb-0 bracket-game">
                        <tbody>
                            {game.map((s) => isTeam(s) ? (
                                <tr class="bracket-slot">
                                    <td class="text-center text-muted numeral bracket-seed">{s.seed}</td>
                                    <td class="text-left text-nowrap bracket-team">
                                        {href(s.teamId)
                                            ? <a href={href(s.teamId)}><img class={`team-logo-${s.teamId} me-2`} width="20" height="20" src={teamLogoUrl(league, s.teamId, false)} alt="" />{name(s.teamId)}</a>
                                            : <Fragment><img class={`team-logo-${s.teamId} me-2`} width="20" height="20" src={teamLogoUrl(league, s.teamId, false)} alt="" />{name(s.teamId)}</Fragment>}
                                    </td>
                                    <td class="text-center numeral bracket-pct" title={pctTitle}>{pct(s.pct)}</td>
                                </tr>
                            ) : (
                                <tr class="bracket-slot">
                                    <td class="text-center text-muted numeral bracket-seed">{s.seed}</td>
                                    <td class="text-left text-nowrap text-muted bracket-team" colspan="2">{s.label}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                ))}
                {champion && r === rounds.length - 1 && (
                    <div>
                        <h2 class="bracket-round-name">Champion</h2>
                        <table class="table table-sm table-bordered align-middle mb-0 bracket-game bracket-champion outline-championship">
                            <tbody>
                                <tr class="bracket-slot">
                                    <td class="text-center text-muted numeral bracket-seed outline-championship">{champion.seed}</td>
                                    <td class="text-left text-nowrap bracket-team outline-championship fw-bold">
                                        <a href={href(champion.teamId)}><img class={`team-logo-${champion.teamId} me-2`} width="20" height="20" src={teamLogoUrl(league, champion.teamId, false)} alt="" />{name(champion.teamId)}</a>
                                    </td>
                                    <td class="text-center numeral bracket-pct outline-championship text-championship fw-bold" title={TITLE}>{pct(champion.pct)}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                )}
            </div>
        </div>
    ))}
</div>

<!-- mobile: the same games as one table, grouped by round, by abbreviation -->
<div class="table-responsive d-md-none">
    <table class="table table-sm align-middle bracket-table" aria-label={label}>
        <tbody>
            {rounds.map((round) => (
                <>
                    <tr><td colspan="4" class="gt_group_heading fw-bold">{round.name}</td></tr>
                    {round.games.map((game) => (
                        <tr class="bracket-slot">
                            {game.map((s) => isTeam(s) ? (
                                <>
                                    <td class="text-left text-nowrap"><span class="text-muted numeral me-1">{s.seed}</span>{href(s.teamId)
                                        ? <a href={href(s.teamId)}><img class={`team-logo-${s.teamId} me-1`} width="18" height="18" src={teamLogoUrl(league, s.teamId, false)} alt="" />{abbr(s.teamId)}</a>
                                        : <Fragment><img class={`team-logo-${s.teamId} me-1`} width="18" height="18" src={teamLogoUrl(league, s.teamId, false)} alt="" />{abbr(s.teamId)}</Fragment>}</td>
                                    <td class="text-center numeral" title={pctTitle}>{pct(s.pct)}</td>
                                </>
                            ) : (
                                <td class="text-left text-nowrap text-muted" colspan="2"><span class="numeral me-1">{s.seed}</span>{s.label}</td>
                            ))}
                        </tr>
                    ))}
                </>
            ))}
            {champion && (
                <>
                    <tr><td colspan="4" class="gt_group_heading fw-bold text-championship">Champion</td></tr>
                    <tr class="bracket-slot">
                        <td class="text-left text-nowrap fw-bold" colspan="3"><span class="text-muted numeral me-1">{champion.seed}</span><a href={href(champion.teamId)}><img class={`team-logo-${champion.teamId} me-1`} width="18" height="18" src={teamLogoUrl(league, champion.teamId, false)} alt="" />{abbr(champion.teamId)}</a></td>
                        <td class="text-center numeral text-championship fw-bold" title={TITLE}>{pct(champion.pct)}</td>
                    </tr>
                </>
            )}
        </tbody>
    </table>
</div>

<style>
    /* each column spaces its games evenly, so a later game sits between the two that feed it */
    .playoff-bracket {
        grid-template-columns: repeat(var(--bracket-rounds, 4), minmax(11rem, 1fr));
        gap: 0.75rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }
    .bracket-round {
        display: flex;
        flex-direction: column;
    }
    .bracket-round-name {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--bs-secondary-color);
        margin-bottom: 0.5rem;
    }
    .bracket-games {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        gap: 0.75rem;
    }
    /* the title game sits level with the gap between the semifinals, the champion under it */
    .bracket-final {
        justify-content: center;
    }
    .bracket-champion,
    .bracket-champion td {
        border-width: 2px;
    }
    .bracket-seed {
        width: 2rem;
    }
    .bracket-team {
        max-width: 0;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .bracket-pct {
        width: 3.25rem;
    }
</style>
