---
import type { ESPNScheduleEvent } from "../../resources/espn";
import { leaguePath } from "../../utils/league";
import { isChampionshipEvent, isEventFavorite, cleanScore, cx, calculateSpiceLevel, SPICE_LABEL } from "../../utils/misc";
import { isFeatureEnabled } from "../../utils/features";
import { SESSION_FAVORITES_DEFAULT } from "../../utils/constants";
import LocalDate from "../LocalDate.svelte";
import BroadcastButton from "./BroadcastButton.astro";
import GameSituation from "./GameSituation.astro";
import TeamRow from "./TeamRow.astro";
import {DateTime} from "luxon";

interface Props {
  game: ESPNScheduleEvent
}

interface GameThumbTheme {
    borderClass?: string
    buttonClass: string
    outlineClass?: string
    textClass?: string
}

const { game } = Astro.props;

const espnGame = (game as ESPNScheduleEvent);
const espnGameComp = espnGame.competitions[0];
const homeComp = espnGameComp.competitors[0];
const awayComp = espnGameComp.competitors[1];
const homeScore = cleanScore(homeComp.score);
const awayScore = cleanScore(awayComp.score);
const gameStatus = espnGameComp.status;

const spiceLevel = calculateSpiceLevel(espnGame);
// G12 ('spice-cues'): the border colour gets a text cue and the card a name,
// from the same SPICE_LABEL map the legend reads
const spiceLabel = isFeatureEnabled('spice-cues', Astro.locals) ? SPICE_LABEL[spiceLevel] : null;
const gameNote = espnGame.competitions[0].notes.length > 0 ? espnGame.competitions[0].notes[0].headline : ""
// conference championships get the gold treatment too, not just CFP events
const isChamp = isChampionshipEvent(gameNote) || gameNote.includes("Championship");
// no announced kickoff: the date is a placeholder midnight, so LocalDate
// would render a bogus local time -- show ESPN's TBD detail text instead
const timeTBD = (espnGameComp as any).timeValid === false;

function generateThumbTheme(): GameThumbTheme {
    if (isChamp) {
        return {
            buttonClass: "btn-outline-championship",
            borderClass: (spiceLevel == 'none') ? undefined : `spice-level-${spiceLevel}`,
            outlineClass: "outline-championship",
            textClass: "text-championship"
        }
    }

    return {
        buttonClass: "btn-outline-primary",
        borderClass: `spice-level-${spiceLevel}`,
        textClass: "text-primary"
    }
}

const { buttonClass, borderClass, outlineClass, textClass } = generateThumbTheme()
const hasLastPlay = (espnGameComp.situation && espnGameComp.situation?.lastPlay);
const canShowSituation = (
    (!(gameStatus.type.completed == true || gameStatus.type.detail.includes("Cancel") || gameStatus.type.detail.includes("Postpone")))
    && (espnGameComp.situation != null && espnGameComp.situation.lastPlay != null)
)
const canLoadStats = gameStatus && !(
    (gameStatus.type.name.includes("STATUS_DELAYED") && !hasLastPlay) 
    || gameStatus.type.detail.includes("Cancel") 
    || gameStatus.type.detail.includes("Postpone") 
    || (gameStatus.type.name.includes("STATUS_IN_PROGRESS") && !hasLastPlay)
)
const canLoadStatsTheme = canLoadStats ? `` : `disabled`
---

<div class="col-xl-3 col-lg-6">
    <div class={cx("row border rounded m-2 mb-4", outlineClass, borderClass)} role={spiceLabel ? "group" : undefined} aria-label={spiceLabel ?? undefined}>
        <div class="col p-3">
            <div class={cx("d-flex justify-content-between", spiceLabel && "flex-wrap")}>
                <strong class={cx("d-inline-block mb-2", textClass, "text-small")}>
                    {
                        (gameStatus.type.completed == true) && <LocalDate client:idle divClass={"m-0"} prefix={gameStatus.type.detail} date={espnGame.date} format={DateTime.DATETIME_SHORT} />
                    }
                    {
                        (gameStatus.type.name.includes("STATUS_SCHEDULED")) && (timeTBD
                            ? <div class="m-0">{gameStatus.type.detail}</div>
                            : <LocalDate client:idle divClass={"m-0"} date={espnGame.date} format={DateTime.DATETIME_SHORT} />)
                    }
                    {
                        (gameStatus.type.completed != true) && (!gameStatus.type.name.includes("STATUS_SCHEDULED")) && <Fragment>{gameStatus.type.detail}</Fragment>
                    }
                </strong>
                {spiceLabel && <span class="text-small text-muted text-nowrap ms-auto ps-2">{spiceLabel}</span>}
            </div>
            <TeamRow espnComp={awayComp} espnStatus={gameStatus} winner={awayScore > homeScore} completed={gameStatus.type.completed == true} hasBall={espnGameComp.situation?.lastPlay?.end?.team?.id == awayComp.id} isRedZone={espnGameComp.situation?.isRedZone} spacer="" />
            <TeamRow espnComp={homeComp} espnStatus={gameStatus} winner={awayScore < homeScore} completed={gameStatus.type.completed == true} hasBall={espnGameComp.situation?.lastPlay?.end?.team?.id == homeComp.id} isRedZone={espnGameComp.situation?.isRedZone} spacer="mb-3" />
            <GameSituation hidden={!canShowSituation} game={espnGame} />
            <div class="d-flex justify-content-between game-thumb-actions">
                <div class="text-left">
                    <a class=`btn btn-sm ${buttonClass} ${canLoadStatsTheme}` role="button" href={leaguePath(Astro.locals.league, `/game/${espnGame.id}`)}>{ (gameStatus.type.name.includes("STATUS_SCHEDULED")) ? "Preview" : "Stats" }</a>
                </div>
                <div class="text-right">
                    <BroadcastButton game={espnGame} />
                </div>
            </div>
            {gameNote && <p class:list={["small m-0 mt-3", isChamp ? "text-championship" : "text-muted"]}>{gameNote}</p>}
        </div>
    </div>
</div>