---
/**
 * A status pill: the site's one badge component.
 *
 * Bootstrap's `badge bg-*` was being spelled out inline everywhere it was
 * wanted (`Footer.astro`'s PREVIEW, `BroadcastButton`'s network, the play
 * page's `DecisionCard`), and the player game log was about to add a fourth.
 * This is that markup, once, so a new caller gets the same pill, the same
 * `title` handling and the same detail line rather than approximating them.
 *
 * `variant` is a Bootstrap SEMANTIC name, never a hex or a hand-rolled colour,
 * so the pill has a dark half for free. Anything the badge needs to say beyond
 * its own word goes in the default slot and renders as a muted line under it,
 * which keeps a long verdict off the pill's `text-nowrap` row.
 */
export type StatusVariant = 'danger' | 'warning' | 'success' | 'secondary' | 'info' | 'primary' | 'dark';

interface Props {
    /** the pill's word -- short, one or two words */
    label: string
    variant?: StatusVariant
    /** hover copy on the pill */
    title?: string | null
    /** utility classes for the pill, e.g. `ms-1` */
    class?: string
    /** marks the detail line, so a test or a style can find this badge's kind */
    dataAttr?: string
}
const { label, variant = 'secondary', title, class: className, dataAttr } = Astro.props;
const hasDetail = Astro.slots.has('default');
---
<span class:list={["badge", `bg-${variant}`, className]} title={title ?? undefined}>{label}</span>
{hasDetail && (
    <span class="d-block text-small text-muted text-wrap" data-status-detail={dataAttr}><slot /></span>
)}
