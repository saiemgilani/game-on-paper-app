---
import GenericPanel from "../../../layouts/panel/GenericPanel.astro";
import { LEAGUES } from "../../../utils/league";

interface Props {
    id: string
    title: string
    show: boolean
    /** replaces the game-pool sentence, for a table read from a different population */
    note?: string
}

const { id, title, show, note } = Astro.props;
---

<GenericPanel id={id} title={title} show={show}>
    <p slot="panel-subtitle" class="text-small text-muted"><slot name="subtitle" /> {note ?? ((Astro.locals.league ?? 'cfb') === 'cfb' ? `Data shown is from ${LEAGUES.cfb.pool} vs ${LEAGUES.cfb.pool} games only.` : 'Data shown is from regular season games only.')}</p>
    <div slot="panel-body">
        <slot name="controls" />
        <div class="table-responsive">
            <table class="table table-sm table-responsive">
                <thead>
                    <tr>
                        <slot name="header" />
                    </tr>
                </thead>
                <tbody>
                    <slot name="rows" />
                </tbody>
            </table>
        </div>
    </div>

</GenericPanel>