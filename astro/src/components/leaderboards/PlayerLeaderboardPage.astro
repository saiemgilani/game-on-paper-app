---
import FreshnessStamp from "../FreshnessStamp.astro";
import { retrievePlayerSummaries, sdvIngestStamp, sdvPin, type SummaryType } from "../../resources/sdv";
import { freshnessStamp } from "../../utils/freshness";
import { isFeatureEnabled } from "../../utils/features";
import GenericPage, { type PageBreadcrumb } from "../../layouts/GenericPage.astro";
import { LEAGUES, leaguePath } from "../../utils/league";
import PlayerLeaderboardTable from "./PlayerLeaderboardTable.astro";
import { toTitleCase } from "../../utils/misc";
import PlayerMetricDropdown from "../dropdowns/PlayerMetricDropdown.svelte";
import { PLAYER_LEADERBOARD_COPY, datasetJsonLd } from "../../utils/seo";
import { PLAYER_STAT_MINIMUMS, playerBoardSort } from "../../utils/players";

interface Props {
    season: number
    category?: string
    metric?: string
}

let { season, category, metric } = Astro.props;
const league = Astro.locals.league ?? 'cfb';
const cfg = LEAGUES[league];
const AVAILABLE_SEASONS = cfg.seasons;
category = category || "passing";
metric = metric || "EPAplay";
// A stamped render reads its rows here, pinned to the stamp; any read that cannot confirm
// that stamp clears the pin and the render shows none (the rows still render).
const pin = isFeatureEnabled('freshness-stamps', Astro.locals) ? sdvPin(await sdvIngestStamp(league, category)) : undefined;
const { sortBy, ranked } = playerBoardSort(metric);
const rows = pin ? await retrievePlayerSummaries(season, category as SummaryType, null, sortBy, ranked, 150, season, league, pin) : undefined;
const stamp = pin?.held ? freshnessStamp(pin.version) : null;

const categoryTitle = toTitleCase(category);
const copy = PLAYER_LEADERBOARD_COPY[category] ?? PLAYER_LEADERBOARD_COPY.passing;
const pageTitle = copy.title(season, league);
const pageUrl = leaguePath(league, `/year/${season}/players/${category}`);
const dataset = datasetJsonLd({
    name: copy.h1(season, league),
    description: copy.description(season, league),
    url: pageUrl,
    season,
    league,
    variables: ["EPA per play", "total EPA", "success rate", "explosiveness"],
});

const breadcrumbs: PageBreadcrumb[] = [
    { title: "Seasons", active: false },
    { title: `${season}`, url: leaguePath(league, `/year/${season}`), active: false },
    { title: `${categoryTitle}`, url: pageUrl, active: true },
];


// the same minimums the player page's "does not qualify" caption quotes
const statMinimum = (PLAYER_STAT_MINIMUMS[category] ?? "")
    + " (adapted from <a href='https://www.pro-football-reference.com/about/minimums.htm'>Pro Football Reference</a>)."

---

<GenericPage title={pageTitle} subtitle={`${categoryTitle} during the ${season} season`} description={copy.description(season, league)} slug={pageUrl} breadcrumbs={breadcrumbs} jsonLd={[dataset]}>
    <div class="container">
        <div class="row mb-3">
            <div class="col-lg-6 col-xs-12 mb-xs-3">
                <h1 class="h3">{copy.h1(season, league)}</h1>
                <p class="m-0 text-muted"><strong>Available Seasons:</strong> {AVAILABLE_SEASONS[0]} to {AVAILABLE_SEASONS[AVAILABLE_SEASONS.length - 1]}{league === 'cfb' && " - Data shown is from FBS vs FBS games only."}{league === 'nfl' && " - Regular season games only."}</p>
                <p class="m-0 mb-2 text-muted text-small">Data from <a href="https://www.sportsdataverse.org">Sportsdataverse</a>, may differ from ESPN due to data availability/quality. Note: other than for Adj EPA/Play, metrics are <strong>not</strong> adjusted for quality of opponent or garbage time. To qualify, <Fragment set:html={statMinimum} /></p>
                {
                    (category == "receiving" && league == "cfb") && (<p class="m-0 mb-2 text-muted text-small"><strong>Note: </strong> ESPN does not consistently mark targeted receivers for incomplete passes, which affects Catch %, EPA/target and Yards/Target averages.</p>)
                }
                <p class="m-0 mb-2 text-muted text-small">Adj EPA/Play methodology adapted from <a href="https://makennnahack.github.io/makenna-hack.github.io/publications/opp_adj_rank_project/">this article</a> by <a href="https://twitter.com/makennnahack">Makenna Hack</a> and <a href="https://blog.collegefootballdata.com/opponent-adjusted-stats-ridge-regression/">this article</a> from <a href="https://twitter.com/jbuddavis">Bud Davis</a>, accounting for home-field advantage, quality of opponent, and garbage time.{league === 'cfb' && " Only considers FBS vs FBS games -- as a result, adj EPA/Play and normal EPA/Play numbers may differ significantly until all teams have played multiple FBS vs FBS games."}</p>
                <FreshnessStamp stamp={stamp} />
            </div>
            <div class="ms-auto col-lg-6 col-xs-12">
                <PlayerMetricDropdown client:idle season={season} category={category} metric={metric} league={league} />
            </div>
        </div>
    </div>
    <PlayerLeaderboardTable season={season} category={category} metric={metric} rows={rows} />
</GenericPage>
