---
import { COACH_BOARDS, COACH_MIN_PLAYS, coachBoardColumns, formatCoachValue, formatSeasonSpan, numericValue, rankCoachRows, resolveCoachSort, sortCoachRows, splitByMinPlays, type CoachRow } from '../../utils/coaches';
import { MEME_STRING_LIST } from '../../utils/constants';
import { espnLogoLeague, leaguePath } from '../../utils/league';
import { cleanField, countRegexMatches, generateColorRampValue } from '../../utils/misc';
import DarkModeLogos from '../DarkModeLogos.astro';
import "bootstrap-icons/font/bootstrap-icons.css";

interface Props {
    /** absent on the careers board */
    season?: number
    board: string
    metric: string
    /** the board's rows, fetched by the page (coach_tendencies or coach_careers) */
    rows: CoachRow[]
}

const { season, board, metric, rows } = Astro.props;
const league = Astro.locals.league ?? 'cfb';
const careers = season === undefined;
const def = { ...COACH_BOARDS[board], columns: coachBoardColumns(COACH_BOARDS[board], league) };
const sortKey = resolveCoachSort(board, metric, league);
const sortColumn = def.columns.find((c) => c.key === sortKey) ?? def.columns[0];

const minPlays = careers ? COACH_MIN_PLAYS.careers : COACH_MIN_PLAYS.season;
// a situational board ranks only coaches with games in the sorted situation
const minGames = def.minGames && sortColumn.games ? { key: sortColumn.games, min: careers ? def.minGames.careers : def.minGames.season } : undefined;
const gamesLabel = minGames && def.columns.find((c) => c.key === minGames.key)?.label.toLowerCase();
const { qualified, partial } = splitByMinPlays(sortCoachRows(rows, sortColumn), minPlays, minGames);
const ranks = rankCoachRows(qualified, sortKey);
// every quality cell is shaded by its own column's rank, as the team grid does;
// a style column (pace, pass rate, go rate) has no good end, so it stays plain
// a situational column is shaded only among coaches who also clear the games floor in its own
// situation, so a 1-opener career's 100% is not painted the best opener record
const gamesFloor = def.minGames && (careers ? def.minGames.careers : def.minGames.season);
const columnRank = new Map<string, { n: number; ranks: Map<CoachRow, number | null> }>(def.columns.filter((c) => !c.neutral).map((c) => {
    const pool = gamesFloor && c.games ? splitByMinPlays(qualified, 0, { key: c.games, min: gamesFloor }).qualified : qualified;
    const sorted = sortCoachRows(pool, c);
    const r = rankCoachRows(sorted, c.key);
    return [c.key, { n: pool.length, ranks: new Map(sorted.map((row, i) => [row, r[i]])) }];
}));
const shade = (row: CoachRow, key: string) => {
    const col = columnRank.get(key);
    return generateColorRampValue(col?.ranks.get(row) ?? null, col?.n ?? qualified.length, true) ?? '';
};
const hrefFor = (key: string) => `?sort=${key}`;
const arrow = sortColumn.lowerIsBetter ? 'up' : 'down';
const teamHref = (row: CoachRow) => leaguePath(league, `/year/${row.season}/team/${row.pos_team_id}`);
const logoSrc = (row: CoachRow) => `https://a.espncdn.com/i/teamlogos/${espnLogoLeague(league)}/500/${row.pos_team_id}.png`;
const teamIds = careers ? [] : [...new Set(qualified.concat(partial).map((r) => String(r.pos_team_id)))];
// Rk, Coach, Team|Teams, G|Seasons, Plays, then the board's metrics
const totalColumns = 5 + def.columns.length;

function formatCoachString(row: CoachRow): string {
    if (!row.coach) {
        return "N/A"
    }
    if (typeof(row.coach) == "number") {
        return "N/A"
    }
    if (!row.teams) {
        return row.coach
    }
    if (typeof(row.teams) == "number") {
        return row.coach
    }

    for (const s of row.teams.split(",")) {
        if (MEME_STRING_LIST.includes(s)) {
            return row.coach?.toString().toLocaleLowerCase()
        }
    }
    
    return row.coach
}

function formatTeamStrings(teams?: string | number | null): string {
    if (!teams) {
        return "N/A"
    }
    if (typeof(teams) == "number") {
        return "N/A"
    }
    for (const s of teams.split(",")) {
        if (MEME_STRING_LIST.includes(s)) {
            teams = teams.replace(s, s.toLocaleLowerCase())
        }
    }
    
    const countCommas = countRegexMatches(teams, /,/g);
    return countCommas > 1 ? `<abbr title="${teams}">${countCommas + 1} teams</abbr>` : teams
}
---
<DarkModeLogos teamIds={teamIds} />
<div class="container">
    <div class="row mb-3">
        <div class="col-12">
            {rows.length === 0 && (
                <p class="text-muted coach-empty">No head coach data {careers ? 'yet' : `for the ${season} season yet`}. It is published once the season's play-by-play has been processed.</p>
            )}
            {rows.length > 0 && (
            <div class="table-responsive">
                <table class="table table-sm table-responsive coach-board" data-board={board} data-sort={sortKey}>
                    <thead>
                        <tr>
                            <th class="text-right text-nowrap" colspan="1">Rk</th>
                            <th class="text-left text-nowrap" colspan="1">Head Coach</th>
                            {careers ? (
                                <Fragment>
                                    <th class="text-left text-nowrap" colspan="1">Teams</th>
                                    <th class="text-center" colspan="1"><abbr title="First to last season as head coach (seasons)">Seasons</abbr></th>
                                </Fragment>
                            ) : (
                                <Fragment>
                                    <th class="text-left text-nowrap" colspan="1">Team</th>
                                    <th class="text-center" colspan="1"><abbr title="Games as head coach">Games</abbr></th>
                                </Fragment>
                            )}
                            <th class="text-center" colspan="1"><abbr title="Offensive plays as head coach">Plays</abbr></th>
                            {def.columns.map((c) => (
                                <th class="text-center" colspan="1">
                                    <a class="text-reset text-decoration-none" href={hrefFor(c.key)}><abbr title={c.hover}>{c.label}</abbr></a>
                                    <i class={`bi bi-arrow-${arrow}`} hidden={c.key !== sortKey}></i>
                                </th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {qualified.map((row, i) => (
                            <tr>
                                <td class="text-right" colspan="1">{ranks[i] ?? '—'}</td>
                                <td class="text-left text-nowrap" colspan="1"><strong>{formatCoachString(row)}</strong></td>
                                {careers ? (
                                    <Fragment>
                                        <td class="text-left" colspan="1"><Fragment set:html={formatTeamStrings(row.teams)} /></td>
                                        <td class="text-center text-nowrap" colspan="1">{formatSeasonSpan(row)}</td>
                                    </Fragment>
                                ) : (
                                    <Fragment>
                                        <td class="text-left" colspan="1">
                                            <a href={teamHref(row)}><img class={`img-fluid team-logo-${row.pos_team_id} me-2`} width="20px" src={logoSrc(row)} alt={`ESPN team id ${row.pos_team_id} ${cleanField(row, "pos_team")}`} title={cleanField(row, "pos_team")} />{cleanField(row, "pos_team")}</a>
                                        </td>
                                        <td class="text-center" colspan="1">{row.games}</td>
                                    </Fragment>
                                )}
                                <td class="text-center" colspan="1">{row.plays}</td>
                                {def.columns.map((c) => (
                                    <td class={`text-center ${shade(row, c.key)}`} colspan="1">{formatCoachValue(numericValue(row, c.key), c.format)}</td>
                                ))}
                            </tr>
                        ))}
                        {partial.length > 0 && (
                            <tr class="table-secondary coach-partial-divider">
                                <td colspan={totalColumns} class="text-muted small">Fewer than {minPlays} plays{careers ? '' : ' this season'} (interim or partial {careers ? 'careers' : 'seasons'}){minGames && `, or ${minGames.min === 1 ? 'no' : `fewer than ${minGames.min}`} ${gamesLabel}`}: shown, not ranked.</td>
                            </tr>
                        )}
                        {partial.map((row) => (
                            <tr class="coach-partial">
                                <td class="text-right text-muted" colspan="1">—</td>
                                <td class="text-left text-nowrap" colspan="1"><strong>{cleanField(row, "coach")}</strong></td>
                                {careers ? (
                                    <Fragment>
                                        <td class="text-left" colspan="1">{formatTeamStrings(row.teams)}</td>
                                        <td class="text-center text-nowrap" colspan="1">{formatSeasonSpan(row)}</td>
                                    </Fragment>
                                ) : (
                                    <Fragment>
                                        <td class="text-left" colspan="1">
                                            <a href={teamHref(row)}><img class={`img-fluid team-logo-${row.pos_team_id} me-2`} width="20px" src={logoSrc(row)} alt={`ESPN team id ${row.pos_team_id} ${cleanField(row, "pos_team")}`} title={cleanField(row, "pos_team")} />{cleanField(row, "pos_team")}</a>
                                        </td>
                                        <td class="text-center" colspan="1">{row.games}</td>
                                    </Fragment>
                                )}
                                <td class="text-center" colspan="1">{row.plays}</td>
                                {def.columns.map((c) => (
                                    <td class="text-center text-muted" colspan="1">{formatCoachValue(numericValue(row, c.key), c.format)}</td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            )}
        </div>
    </div>
</div>
