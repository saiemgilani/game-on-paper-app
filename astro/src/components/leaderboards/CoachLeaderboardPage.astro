---
import GenericPage, { type PageBreadcrumb } from "../../layouts/GenericPage.astro";
import { retrieveCoachCareers, retrieveCoachTendencies } from "../../resources/sdv";
import { LAST_YEAR } from "../../utils/constants";
import { COACH_BOARDS, COACH_BOARD_SLUGS, COACH_MIN_PLAYS, numericValue, type CoachRow } from "../../utils/coaches";
import { LEAGUES, leaguePath } from "../../utils/league";
import { COACH_BOARD_COPY, datasetJsonLd } from "../../utils/seo";
import CoachLeaderboardTable from "./CoachLeaderboardTable.astro";

interface Props {
    /** absent on the careers board, which pools every season */
    season?: number
    board: string
    metric: string
}

const { season, board, metric } = Astro.props;
const league = Astro.locals.league ?? 'cfb';
const cfg = LEAGUES[league];
const careers = season === undefined;
const seasonOrNull = season ?? null;
const def = COACH_BOARDS[board];
const copy = COACH_BOARD_COPY[board];

// the season boards live under the year; careers under a bare /coaches
const boardBase = careers ? leaguePath(league, '/coaches') : leaguePath(league, `/year/${season}/coaches`);
const pageUrl = `${boardBase}/${board}`;
const pageTitle = copy.title(seasonOrNull, league);
const heading = copy.h1(seasonOrNull, league);
const description = copy.description(seasonOrNull, league);
// the seasons the tables can hold; the current season redirects, so it is not offered
const seasons = cfg.seasons.filter((y) => y <= LAST_YEAR).toSorted((a, b) => b - a);

// the page fetches so the Dataset's coverage can come from the rows themselves
const columnKeys = def.columns.map((c) => c.key);
const rows: CoachRow[] = careers
    ? await retrieveCoachCareers({ league, columns: columnKeys })
    : await retrieveCoachTendencies({ season, league, columns: columnKeys });

// The careers table pools whatever seasons the builder has run, which the
// league's season range does not know; say the interval the rows actually
// span, and nothing when there are no rows.
function careerInterval(): string | undefined {
    const firsts = rows.map((r) => numericValue(r, 'first_season')).filter((v): v is number => v !== null);
    const lasts = rows.map((r) => numericValue(r, 'last_season')).filter((v): v is number => v !== null);
    if (firsts.length === 0 || lasts.length === 0) return undefined;
    return `${Math.min(...firsts)}/${Math.max(...lasts)}`;
}
const dataset = datasetJsonLd({
    name: heading,
    description,
    url: pageUrl,
    season: careers ? careerInterval() : season,
    league,
    variables: copy.variables,
});

const breadcrumbs: PageBreadcrumb[] = careers
    ? [
        { title: "Head Coaches", active: false },
        { title: "Careers", url: boardBase, active: false },
        { title: def.title, url: pageUrl, active: true },
    ]
    : [
        { title: "Seasons", active: false },
        { title: `${season}`, url: leaguePath(league, `/year/${season}`), active: false },
        { title: "Head Coaches", url: boardBase, active: false },
        { title: def.title, url: pageUrl, active: true },
    ];
const subtitle = careers ? `Head coach ${def.title.toLowerCase()} across every season` : `Head coach ${def.title.toLowerCase()} during the ${season} season`;
---

<GenericPage title={pageTitle} subtitle={subtitle} description={description} slug={pageUrl} breadcrumbs={breadcrumbs} jsonLd={[dataset]} heading={heading}>
    <div class="container">
        <div class="row mb-3">
            <div class="col-lg-7 col-xs-12 mb-xs-3">
                <h3>{careers ? `${cfg.shortName} Head Coach Careers: ${def.title}` : `${season} ${cfg.shortName} Head Coaches: ${def.title}`}</h3>
                <p class="m-0 mb-2 text-muted">{copy.intro}</p>
                <p class="m-0 text-muted text-small">
                    {careers
                        ? <Fragment>Every season a coach was the head coach, pooled. Coaches with fewer than {COACH_MIN_PLAYS.careers} plays are listed below the divider without a rank. Per-season boards: <a href={leaguePath(league, `/year/${LAST_YEAR}/coaches/${board}`)}>{LAST_YEAR} {def.title.toLowerCase()}</a>.</Fragment>
                        : <Fragment>One row per head coach and team; an in-season change gives each coach his own games. Coaches with fewer than {COACH_MIN_PLAYS.season} plays are listed below the divider without a rank. Career totals: <a href={leaguePath(league, `/coaches/${board}`)}>all seasons, {def.title.toLowerCase()}</a>.</Fragment>}
                    {league === 'cfb' && " FBS vs FBS games only."}{league === 'nfl' && " Regular season and playoffs."}
                </p>
                <p class="m-0 mb-2 text-muted text-small">Data from <a href="https://www.sportsdataverse.org">Sportsdataverse</a>; head coaches per ESPN's game rosters. Click a column heading to sort by it; rows with no clock data show "—".</p>
            </div>
            <div class="ms-auto col-lg-5 col-xs-12">
                <form class="mb-3 d-flex justify-content-xs-start justify-content-lg-end coach-board-form" id="coach-board-form">
                    <div class="row">
                        {!careers && (
                            <div class="col-auto mb-3">
                                <label class="visually-hidden" for="coach-season">Season</label>
                                {/* no island: a plain select whose values are the destination URLs */}
                                <select id="coach-season" class="form-select form-select-md" onchange="window.location.href = this.value">
                                    {seasons.map((y) => (
                                        <option value={leaguePath(league, `/year/${y}/coaches/${board}`)} selected={y === season}>{y}</option>
                                    ))}
                                </select>
                            </div>
                        )}
                        <div class="col-auto mb-3">
                            <label class="visually-hidden" for="coach-board">Board</label>
                            <select id="coach-board" class="form-select form-select-md" onchange="window.location.href = this.value">
                                {COACH_BOARD_SLUGS.map((b) => (
                                    <option value={`${boardBase}/${b}`} selected={b === board}>{COACH_BOARDS[b].title}</option>
                                ))}
                            </select>
                        </div>
                    </div>
                </form>
                <ul class="nav nav-pills justify-content-lg-end coach-board-nav" aria-label="Head coach boards">
                    {COACH_BOARD_SLUGS.map((b) => (
                        <li class="nav-item"><a class={`nav-link py-1 ${b === board ? 'active' : ''}`} aria-current={b === board ? 'page' : undefined} href={`${boardBase}/${b}`}>{COACH_BOARDS[b].title}</a></li>
                    ))}
                    <li class="nav-item"><a class="nav-link py-1" href={careers ? leaguePath(league, `/year/${LAST_YEAR}/coaches/${board}`) : leaguePath(league, `/coaches/${board}`)}>{careers ? `${LAST_YEAR} season` : 'Careers'}</a></li>
                </ul>
            </div>
        </div>
    </div>
    <CoachLeaderboardTable season={season} board={board} metric={metric} rows={rows} />
</GenericPage>
