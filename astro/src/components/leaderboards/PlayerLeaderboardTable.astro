---
import { roundNumber, cleanField, retrieveValue, generateColorRampValue, isTeamFavorite, STANDARD_THEME_COLOR, formatRank } from '../../utils/misc';
import { espnLogoLeague, leaguePath } from '../../utils/league';
import { retrievePlayerSummaries, type SDVPlayerSummary, SummaryType }  from '../../resources/sdv';
import { playerBoardSort } from '../../utils/players';
import { SDV_PLAYER_METRIC_CATEGORIES, SDV_PLAYER_METRIC_FORMATTING_VALUES, SDV_PLAYER_PERCENT_COLUMNS, SESSION_FAVORITES_DEFAULT } from '../../utils/constants';
import DarkModeLogos from '../DarkModeLogos.astro';
import PlayerLink from '../player/PlayerLink.astro';
import { percentileOf } from '../../utils/players';
import "bootstrap-icons/font/bootstrap-icons.css";

type Props = { category: string; metric: string } & (
    /** a season board; a stamped page reads its rows itself (pinned to its stamp) and passes them */
    | { allTime?: false; season: number; rows?: SDVPlayerSummary[] }
    /** the all-time board (S17): always passes its rows, which span seasons, so Rk is the position,
     *  a Season column joins, and links open each row's own season */
    | { allTime: true; season?: undefined; rows: SDVPlayerSummary[] }
);

const props = Astro.props;
const { category, metric } = props;
const allTime = props.allTime === true;
const season = props.season;
const { sortBy, ranked: isMetricRanked } = playerBoardSort(category, metric);

let content: SDVPlayerSummary[] = props.allTime ? props.rows
    : props.rows ?? await retrievePlayerSummaries(props.season, category as SummaryType, null, sortBy, isMetricRanked, 150, props.season, Astro.locals.league);
content = content.filter((p: any) => {
    const nonNullValue = retrieveValue(p, metric) != null && retrieveValue(p, metric) != "NA"
    const nonNullRank = retrieveValue(p, `${metric}_rank`) != null && retrieveValue(p, `${metric}_rank`) != "NA"
    if (isMetricRanked) { 
        return nonNullRank && nonNullValue
    } else {
        return nonNullValue
    }
})

content = content.toSorted((a, b) => {
    const compVal = parseFloat(retrieveValue(a, metric)) - parseFloat(retrieveValue(b, metric))
    return (-1 * compVal)
})

const columns = SDV_PLAYER_METRIC_CATEGORIES[category];

function generateMetricCell(player: any, c: string, m: string): string {
    const [multiplier, power10, fixed] = SDV_PLAYER_METRIC_FORMATTING_VALUES[c][m] || [1, 2, 2];
    const value = parseFloat(retrieveValue(player, m)) * multiplier;
    const valString = roundNumber(value, power10, fixed) + ((SDV_PLAYER_PERCENT_COLUMNS.includes(m)) ? "%" : "")
    // shaded by the producer's percentile among EVERY qualifier, not by rank over
    // the <= 150 rows shown: with 744 receiving qualifiers, rank 145 is the 80th
    // percentile but read as the bottom of the page (audit D5)
    const pct = percentileOf(player, m);
    // a row with a rank but no published percentile keeps the old rank-over-rows-shown ramp
    const rank = retrieveValue(player, m + '_rank');
    const shade = pct !== null ? generateColorRampValue(pct, 100)
        : generateColorRampValue(rank == "NA" ? null : parseFloat(rank), content.length, true);
    return `
    <td class="text-center ${shade ?? ""}" colspan="1">${valString}</td>
    `
}

function generateMetricRow(player: any): string {
    return Object.entries(columns).map(([k, _]) => generateMetricCell(player, category, k)).join("")
}

const allTeamIds = content.map(p => p.team_id);

let nameField = "name";
if (category == "passing") {
    nameField = "passer_player_name"
} else if (category == "rushing") {
    nameField = "rusher_player_name"
} else if (category == "receiving") {
    nameField = "receiver_player_name"
} else {
    nameField = "name"
}

---
<DarkModeLogos teamIds={allTeamIds} />
<div class="container">
    <div class="row mb-3">
        <div class="col-12">
            <div class="table-responsive">
                <table class="table table-sm table-responsive">
                    <thead>
                        <th class="text-right" colspan="1">Rk</th>
                        <th class="text-left" colspan="1">Player</th>
                        {allTime && (<th class="text-center" colspan="1">Season</th>)}
                        <th class="text-left" colspan="1">Team</th>
                        <th class="text-center" colspan="1">Games</th>
                        {
                            Object.entries(columns).map(([k, v]) => (
                                <th class="text-center" colspan="1">{v.title} <i class="bi bi-arrow-down" hidden={metric != k}></i></th>
                            ))
                        }
                    </thead>
                    <tbody>
                        {
                            content.map((p, i) => (
                                <tr>
                                    <td class="text-right numeral" colspan="1">{isMetricRanked && !allTime ? formatRank(parseFloat(retrieveValue(p, metric + `_rank`))) : (i + 1)}</td>
                                    <td class="text-left" colspan="1"><PlayerLink id={p.player_id} season={allTime ? p.season : season}><strong>{cleanField(p, nameField)}</strong></PlayerLink></td>
                                    {allTime && (<td class="text-center numeral" colspan="1">{p.season}</td>)}
                                    <td class="text-left" colspan="1"><a href={leaguePath(Astro.locals.league, `/year/${allTime ? p.season : season}/team/${p.team_id}`)}><img class={`img-fluid team-logo-${p.team_id} me-2`} width="20px" src={`https://a.espncdn.com/i/teamlogos/${espnLogoLeague(Astro.locals.league)}/500/${p.team_id}.png`} alt={`ESPN team id ${p.team_id} ${cleanField(p, nameField)}`} title={p.pos_team}/><span>{cleanField(p, "pos_team")}</span></a></td>
                                    <Fragment set:html={generateMetricCell(p, category, "games")} />
                                    <Fragment set:html={generateMetricRow(p)} />
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>