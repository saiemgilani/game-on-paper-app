---
import { SPECIAL_IMAGES } from '../utils/constants';

interface Props {
    teamIds: (string | number)[]
}
const { teamIds } = Astro.props;

let teamIdCSS = teamIds.map(p => {
    return `
    img.team-logo-${p} {
        content: url('https://a.espncdn.com/i/teamlogos/ncaa/500-dark/${p}.png')
    }
    `
})

let specialTeamIdCSS = Object.entries(SPECIAL_IMAGES).map(([k, v]) => {
    return `
    img.team-logo-${k} {
        content: url('${v}') !important
    }

    @media (prefers-color-scheme: dark) { img.team-logo-${k} { content: url('${v.replace(".png", "-dark.png")}') !important } }
    `
})


---

<style set:html={`@media (prefers-color-scheme: dark) { ${teamIdCSS.join("")} }`}></style>
<style set:html={specialTeamIdCSS.join("")}></style>