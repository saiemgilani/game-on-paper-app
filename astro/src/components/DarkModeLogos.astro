---
import { SPECIAL_IMAGES, SPECIAL_IMAGES_DARK } from '../utils/constants';
import { teamLogoUrl } from '../utils/league';

interface Props {
    teamIds: (string | number)[]
}
const { teamIds } = Astro.props;

// Dark logos through ESPN's resizing combiner. teamLogoUrl picks the path that exists:
// NFL dark logos live under the team abbreviation, not the numeric id (this used to
// fall back to the light NFL logo in dark mode for that reason).
// A site-hosted logo (WNBA defunct franchises) is root-relative: it is served as-is, since
// ESPN's combiner can't resize a file it doesn't host (and `new URL` needs an absolute URL).
let teamIdCSS = teamIds.map(p => {
    const url = teamLogoUrl(Astro.locals.league, p, true);
    const src = url.startsWith('/') ? url : `https://a.espncdn.com/combiner/i?img=${new URL(url).pathname}&h=120&w=120`;
    return `
    img.team-logo-${p} {
        content: url('${src}')
    }
    `
})

let specialTeamIdCSS = Object.entries(SPECIAL_IMAGES).map(([k, v]) => {
    const darkModeUrl = SPECIAL_IMAGES_DARK[k]

    let base = `img.team-logo-${k} { content: url('${v}') !important }`;
    if (darkModeUrl) {
        base += `\n@media (prefers-color-scheme: dark) { img.team-logo-${k} { content: url('${darkModeUrl}') !important } }`
    }
    
    return base
})


---

<style set:html={`@media (prefers-color-scheme: dark) { ${teamIdCSS.join("")} }`}></style>
<style set:html={specialTeamIdCSS.join("")}></style>