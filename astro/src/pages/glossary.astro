---
export const prerender = true;

import { generateGlossaryItems } from '../resources/glossary';
import GlossaryHeader from '../components/glossary/GlossaryHeader.astro';
import GlossarySection from '../components/glossary/GlossarySection.astro';
import { definedTermSetJsonLd, termSlugs } from '../utils/seo';
import GenericPage from '../layouts/GenericPage.astro';

const glossary = generateGlossaryItems();
const title = `College Football Advanced Stats Glossary: EPA, Success Rate, Win Probability | Game on Paper`;
const subtitle = 'Definitions of EPA (expected points added), EPA per play, adjusted EPA, success rate, explosiveness, havoc rate and win probability as used on Game on Paper.';

// This page prerenders to /glossary/ (see the sitemap test). The canonical
// previously pointed at /cfb/glossary -- the pre-Astro URL that robots.txt
// Disallows -- so Google was told the authoritative copy of the site's ONLY
// ranking page was one it may not crawl. Measured 2026-08-29.
const canonical = 'https://gameonpaper.com/glossary/';
const allTerms = [...glossary.values()].flat();
const slugs = termSlugs(allTerms);

---

<GenericPage title={title} subtitle={subtitle} slug="/glossary" breadcrumbs={[]} heading={title} description={subtitle} canonicalPath={canonical} jsonLd={[definedTermSetJsonLd(allTerms, canonical)]}>
    <GlossaryHeader keys={glossary.keys().toArray()} />
    <div class="container">
        <h1 class="visually-hidden">College Football Advanced Stats Glossary</h1>
        {
            glossary.keys().map((k) => (
                <GlossarySection letter={k} entries={glossary.get(k)} slugs={slugs} />
            )) 
        }
    </div>
</GenericPage>