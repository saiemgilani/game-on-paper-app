---
import GenericPage from "../layouts/GenericPage.astro";

---

<GenericPage title="Not Found" subtitle="Page not found" slug="/404" breadcrumbs={[]}>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 text-center">
                <h3>This page could not be found.</h3>
                <p class="mb-0">If you're seeing this from a game page, this may be due to a lack of data from ESPN. If you're trying to access a specific game, double-check that the game has a gamecast page with play-by-play data on ESPN.com.</p>
                <p class="mb-3">If you need further technical support, please reach out to <a href="https://bsky.app/profile/akeaswaran.me">@akeaswaran.me</a> or <a href="https://bsky.app/profile/saiemgilani.bsky.social">@saiemgilani</a> on Bluesky with the URL you're trying to access.</p>
            </div>
        </div>
    </div>
</GenericPage>