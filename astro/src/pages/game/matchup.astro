---
import MatchupView from "../../components/game/MatchupView.astro";
import MatchupBuilder from "../../components/game/MatchupBuilder.svelte";
import GenericPage from "../../layouts/GenericPage.astro";
import { retrieveTeamSeasonInformation } from "../../resources/espn";
import { retrieveTeamSummaries } from "../../resources/sdv";
import { retrieveAllTeams } from "../../utils/common";
import DarkModeLogos from "../../components/DarkModeLogos.astro";

const query = Astro.url.searchParams;
const awaySeason = query.get("awaySeason") || "2025";
const awayTeamId = query.get("awayTeamId") || "52";
const homeSeason = query.get("homeSeason") || "2025";
const homeTeamId = query.get("homeTeamId") || "59";

const allTeamSeasons = retrieveAllTeams();

let awayTeam = (!awaySeason || !awayTeamId) ? null : await retrieveTeamSeasonInformation(awaySeason, awayTeamId)
let awayTeamData = (!awaySeason || !awayTeamId) ? [] : await retrieveTeamSummaries(Number(awaySeason), undefined, awayTeamId, [], Number(awaySeason));
let homeTeam = (!homeSeason || !homeTeamId) ? null : await retrieveTeamSeasonInformation(homeSeason, homeTeamId)
let homeTeamData = (!homeSeason || !homeTeamId) ? [] : await retrieveTeamSummaries(Number(homeSeason), undefined, homeTeamId, [], Number(homeSeason));

const canDisplayMatchupView = (awaySeason && homeSeason && awayTeamId && homeTeamId)
if (canDisplayMatchupView) {
    Astro.cache.set({
        maxAge: 60 * 60 * 24, // one day
        tags: ['matchup'],
    })
} else {
    Astro.cache.set(false);
}
---

<GenericPage title={"Matchup Builder | Game on Paper"} subtitle={`Pick two team-seasons to compare`} slug="/game/matchup" breadcrumbs={[]}>
    <DarkModeLogos teamIds={[homeTeamId, awayTeamId]} />
    <div class="container">
        <div class="row mb-3">
            <div class="col-12 mb-xs-3">
                <h1>Matchup Builder</h1>
                <p class="m-0 text-muted">Data shown is from FBS vs FBS games only.</p>
                <p class="m-0 mb-2 text-muted text-small">Data from <a href="https://github.com/sportsdataverse/cfbfastR">cfbfastR</a>, may differ from ESPN due to data availability/quality. Note: other than for Adj EPA/Play, metrics are <strong>not</strong> adjusted for quality of opponent or garbage time.</p>
            </div>
        </div>
    </div>
    <MatchupBuilder client:idle teamSeasons={allTeamSeasons} awaySeason={awaySeason} homeSeason={homeSeason} awayTeamId={awayTeamId} homeTeamId={homeTeamId} />
    {
        !canDisplayMatchupView && (
            <div class="container">
                <div class="row mb-3">
                    <div class="col-12 text-center">
                        <p class="text-muted">Please select two team-seasons to compare.</p>
                    </div>
                </div>
            </div>
        )
    }
    {
        canDisplayMatchupView && (
            <MatchupView awayTeam={awayTeam} homeTeam={homeTeam} awayTeamSummary={(awayTeamData.length > 0) ? awayTeamData[0] : null} homeTeamSummary={(homeTeamData.length > 0) ? homeTeamData[0] : null} />
        )
    }
</GenericPage>