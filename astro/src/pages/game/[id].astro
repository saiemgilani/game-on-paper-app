---
import GamePage from '../../components/game/GamePage.astro';
import PreGamePage from '../../components/game/PreGamePage.astro';
import { ESPN_IN_PROGRESS_STATUS_NAMES, retrieveGamePage, type ESPNPlayByPlayResponse } from '../../resources/espn';
import { retrieveProcessedGame, type ProcessedGame } from '../../resources/python';
import ErrorPage from "../../components/ErrorPage.astro";
import { getGameCacheConfig } from '../../utils/config';

const { id } = Astro.params;
if (!id) {
    Astro.cache.set(false);
    return Astro.redirect("/"); 
}
let espnGame: ESPNPlayByPlayResponse | null = null;
let game: ProcessedGame | null = null;
try {
    espnGame = await retrieveGamePage(id);
    if (!espnGame) {
        throw new Error(`Game ID ${id} had no data`);
    }
    
    const config = getGameCacheConfig(espnGame.gamepackageJSON.header.competitions[0].date, espnGame.gamepackageJSON.header.competitions[0].status)
    if (espnGame && (espnGame.gamepackageJSON.header.competitions[0].status.type.state == "in" || ESPN_IN_PROGRESS_STATUS_NAMES.includes(espnGame.gamepackageJSON.header.competitions[0].status.type.name))) {
        game = await retrieveProcessedGame(id, config.maxAge || 30);
    }

    Astro.cache.set(config)
} catch (e: any) {
    console.error(`ERROR while retrieving game data: ${e}, ${e.stack}`);
    Astro.cache.set(false);
}
---
{
    (!espnGame && !game) && (
        <ErrorPage 
            htmlTitle="Game Not Found" 
            htmlSubtitle="Unable to find game" 
            slug={Astro.url.pathname}
            humanTitle="This game could not be found."
            message={`This may be due to a lack of data from ESPN. Double check that play-by-play is available at ESPN <a href='https://www.espn.com/college-football/game/_/gameId/${id}' target='__blank'>here</a>.`}
        />
    )
}
{
    (espnGame && espnGame.gamepackageJSON.header.competitions[0].status.type.name == "STATUS_SCHEDULED") && <PreGamePage id={id} espnGame={espnGame} />
}
{
    (espnGame && espnGame.gamepackageJSON.header.competitions[0].status.type.name != "STATUS_SCHEDULED" && !game) && (
        <ErrorPage 
            htmlTitle="Game Unprocessable" 
            htmlSubtitle="Unable to process game" 
            slug={Astro.url.pathname}
            humanTitle="This game could not be processed."
            message={`This may be due to a lack of data from ESPN. Double check that play-by-play is available at ESPN <a href='https://www.espn.com/college-football/game/_/gameId/${id}' target='__blank'>here</a>.`}
        />
    )
}
{
    (espnGame && espnGame.gamepackageJSON.header.competitions[0].status.type.name != "STATUS_SCHEDULED" && game) && <GamePage id={id} game={game} />
}