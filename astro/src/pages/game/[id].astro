---
import GamePage from '../../components/game/GamePage.astro';
import PreGamePage from '../../components/game/PreGamePage.astro';
import { retrieveGamePage, type ESPNPlayByPlayResponse } from '../../resources/espn';
import { DateTime } from 'luxon';
import { retrieveProcessedGame, type ProcessedGame } from '../../resources/python';
import ErrorPage from "../../components/ErrorPage.astro";
import { CACHE_TTL_MULTIPLIER, CURRENT_SEASON_CONFIG } from '../../utils/config';

const { id } = Astro.params;
if (!id) {
    Astro.cache.set(false);
    return Astro.redirect("/"); 
}
let espnGame: ESPNPlayByPlayResponse | null = null;
let game: ProcessedGame | null = null;
try {
    espnGame = await retrieveGamePage(id);
    if (!espnGame) {
        throw new Error(`Game ID ${id} had no data`);
    }

    if (espnGame && espnGame.gamepackageJSON.header.competitions[0].status.type.name != "STATUS_SCHEDULED") {
        game = await retrieveProcessedGame(id);
    }

    const gameDate = DateTime.fromISO(espnGame.gamepackageJSON.header.competitions[0].date);
    const todayPlusOneDay = DateTime.now().plus({ days: 1 })
    const isGameWithinOneDay = gameDate.diff(todayPlusOneDay).days < 1;

    if (espnGame.gamepackageJSON.header.competitions[0].status.type.completed) {
        // cache one week for completed games
        Astro.cache.set({
            maxAge: 60 * 60 * 24 * 7,
            tags: ['game-completed', "favorites-enabled"],
        });
    } else if (espnGame.gamepackageJSON.header.competitions[0].status.type.name == "STATUS_SCHEDULED" && isGameWithinOneDay) {
        // cache one hour for scheduled games within 24 hours
        Astro.cache.set({
            maxAge: 60 * 60,
            tags: ['game-scheduled-today'],
        });
    } else if (espnGame.gamepackageJSON.header.competitions[0].status.type.name == "STATUS_SCHEDULED") {
        // cache one day for scheduled games outside 24 hours
        Astro.cache.set({
            maxAge: 60 * 60 * 24,
            tags: ['game-scheduled-future', "favorites-enabled"],
        });
    } else {
        // cache N minutes for live games
        Astro.cache.set({
            maxAge: CURRENT_SEASON_CONFIG.liveGameRefreshRate,
            // use SWR here for performance 
            swr: CURRENT_SEASON_CONFIG.liveGameRefreshRate * CACHE_TTL_MULTIPLIER,
            tags: ['game-in-progress', "favorites-enabled"],
        });
    }
} catch (e: any) {
    console.error(`ERROR while retrieving game data: ${e}, ${e.stack}`);
    Astro.cache.set(false);
}
---
{
    (!espnGame && !game) && (
        <ErrorPage 
            htmlTitle="Game Not Found" 
            htmlSubtitle="Unable to find game" 
            slug={Astro.url.pathname}
            humanTitle="This game could not be found."
            message={`This may be due to a lack of data from ESPN. Double check that play-by-play is available at ESPN <a href='https://www.espn.com/college-football/game/_/gameId/${id}' target='__blank'>here</a>.`}
        />
    )
}
{
    (espnGame && espnGame.gamepackageJSON.header.competitions[0].status.type.name == "STATUS_SCHEDULED") && <PreGamePage id={id} espnGame={espnGame} />
}
{
    (espnGame && espnGame.gamepackageJSON.header.competitions[0].status.type.name != "STATUS_SCHEDULED" && !game) && (
        <ErrorPage 
            htmlTitle="Game Unprocessable" 
            htmlSubtitle="Unable to process game" 
            slug={Astro.url.pathname}
            humanTitle="This game could not be processed."
            message={`This may be due to a lack of data from ESPN. Double check that play-by-play is available at ESPN <a href='https://www.espn.com/college-football/game/_/gameId/${id}' target='__blank'>here</a>.`}
        />
    )
}
{
    (espnGame && espnGame.gamepackageJSON.header.competitions[0].status.type.name != "STATUS_SCHEDULED" && game) && <GamePage id={id} game={game} />
}