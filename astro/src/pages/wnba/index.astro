---
// /wnba: BASKETBALL.wnba.landing is 'teams-index' (spec §3.4): the season's teams with their shooting lines, plus links to
// the scoreboard and the other shooting pages. /wnba/teams is the same list under the Header's Teams entry.
import NbaTeamsRoute from '../../components/routes/NbaTeamsRoute.astro';
import { prepareBasketballTeams } from '../../routes/basketball/teams';
import { unavailable } from '../../routes/basketball/cache';

const r = await prepareBasketballTeams(Astro, 'wnba', { landing: true });
if ('unavailable' in r) {
    return unavailable('wnba');
}
---

<NbaTeamsRoute data={r} landing />
