---
import { CURRENT_YEAR } from '../../../utils/constants';
import { leaguePath } from '../../../utils/league';

// /nfl/players: the twin of pages/players/index.astro, onto the passing board.
// The season leaderboard then sends the current season on to the last completed
// one, as every leaderboard hub does (review on #267).
return Astro.redirect(leaguePath('nfl', `/year/${CURRENT_YEAR}/players/passing`));
