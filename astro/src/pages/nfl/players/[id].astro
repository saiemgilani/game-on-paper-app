---
import PlayerPage from "../../../components/player/PlayerPage.astro";
import { preparePlayer, PLAYER_UNAVAILABLE } from "../../../routes/player";

const r = await preparePlayer(Astro, 'nfl');
if ('unavailable' in r) {
    return PLAYER_UNAVAILABLE();
}
if ('notFound' in r) {
    return Astro.rewrite("/404");
}
if ('redirect' in r) {
    return Astro.redirect(r.redirect);
}
---

<PlayerPage player={r.player} season={r.season} />
