---
import { prepareCoachIndex } from "../../routes/leaderboards";

// /nfl/coaches: the careers hub redirects to the default careers board
const r = prepareCoachIndex(Astro, 'nfl');
if ('notFound' in r) {
    return Astro.rewrite("/404");
}
if ('redirect' in r) {
    return Astro.redirect(r.redirect);
}
