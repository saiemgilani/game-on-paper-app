---
import CoachLeaderboardPage from "../../../components/leaderboards/CoachLeaderboardPage.astro";
import { prepareCoachCareers } from "../../../routes/leaderboards";

const r = prepareCoachCareers(Astro, 'nfl');
if ('notFound' in r) {
    return Astro.rewrite("/404");
}
if ('redirect' in r) {
    return Astro.redirect(r.redirect);
}
---

<CoachLeaderboardPage board={r.board} metric={r.metric} />
