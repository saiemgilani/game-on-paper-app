---
import AllTimePage from "../../../../components/leaderboards/AllTimePage.astro";
import { loadAllTime } from "../../../../routes/allTime";

// the read and the cache policy run here, while the response headers are open
const r = await loadAllTime(Astro, 'nfl');
if ('notFound' in r) {
    return Astro.rewrite("/404");
}
---

<AllTimePage category={r.category} metric={r.metric} rows={r.rows} stamp={r.stamp} />
