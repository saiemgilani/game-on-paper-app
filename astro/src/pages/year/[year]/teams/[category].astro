---
import TeamLeaderboardPage from "../../../../components/leaderboards/TeamLeaderboardPage.astro";
import { CURRENT_YEAR, LAST_YEAR } from "../../../../utils/constants";
import { modifyMetricForCategory } from "../../../../utils/misc";
import { LEADERBOARD_CATEGORIES } from "../../../../utils/seo";

const { year, category } = Astro.params;
// An unknown category (/teams/offense, /teams/bogus) rendered as HTTP 200 with a
// 0-byte body -- indexable as a thin page and a crawl-budget sink. Measured
// 2026-08-29. A route that has nothing is a 404.
if (!category || !LEADERBOARD_CATEGORIES.includes(category)) {
    return new Response(null, { status: 404 });
}
const query = Astro.url.searchParams;
const metric = query.get("sort") || modifyMetricForCategory(category || "differential", "net_adj_epa");
if (year == `${CURRENT_YEAR}`) {
    return Astro.redirect(`/year/${LAST_YEAR}/teams/${category}`)
}
---

<TeamLeaderboardPage season={parseInt(year || `${CURRENT_YEAR}`)} category={category} metric={metric} />