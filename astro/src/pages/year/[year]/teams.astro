---
import TeamLeaderboardPage from "../../../components/leaderboards/TeamLeaderboardPage.astro";
import { CURRENT_YEAR, LAST_YEAR } from "../../../utils/constants";
import { leaguePath } from "../../../utils/league";

const { year } = Astro.params;
if (year == `${CURRENT_YEAR}`) {
    return Astro.redirect(leaguePath(Astro.locals.league, `/year/${LAST_YEAR}/teams`))
}
---

<TeamLeaderboardPage season={parseInt(year || `${CURRENT_YEAR}`)} category={"differential"} metric={"net_adj_epa"} />