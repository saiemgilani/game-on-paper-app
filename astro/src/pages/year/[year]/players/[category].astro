---
import PlayerLeaderboardPage from "../../../../components/leaderboards/PlayerLeaderboardPage.astro";
import { CURRENT_YEAR, LAST_YEAR } from "../../../../utils/constants";
import { PLAYER_LEADERBOARD_CATEGORIES } from "../../../../utils/seo";
import { leaguePath } from "../../../../utils/league";

const { year, category } = Astro.params;
if (!category || !PLAYER_LEADERBOARD_CATEGORIES.includes(category)) {
    return Astro.rewrite("/404")
}
const query = Astro.url.searchParams;
const metric = query.get("sort") || "TEPA";
if (year == `${CURRENT_YEAR}`) {
    return Astro.redirect(leaguePath(Astro.locals.league, `/year/${LAST_YEAR}/players/${category}`))
}
// Astro.response.headers.set('Cache-Control', `public, max-age=${24 * 60 * 60}`);
---

<PlayerLeaderboardPage season={parseInt(year || `${CURRENT_YEAR}`)} category={category} metric={metric} />