---
import GenericPage from '../layouts/GenericPage.astro';
import DarkModeLogos from '../components/DarkModeLogos.astro';
import { retrieveConferenceStandings } from '../resources/espn';
import { STANDINGS_CONFERENCES, parseStandingsEntry, sortStandings } from '../utils/standings';
import { cleanField } from '../utils/misc';

// all conferences in parallel; a failed one simply doesn't render
const results = await Promise.all(STANDINGS_CONFERENCES.map((g) => retrieveConferenceStandings(g)));
const allConferences = results
    .map((c, i) => ({ groupId: STANDINGS_CONFERENCES[i], data: c }))
    .filter((c) => !!c.data && (c.data!.standings?.entries?.length ?? 0) > 0)
    .map((c) => ({
        groupId: c.groupId,
        name: c.data!.name ?? "Conference",
        // the dropdown uses ESPN's abbreviation, the standard the chart builder set
        shortName: c.data!.shortName ?? c.data!.name ?? "Conference",
        rows: sortStandings((c.data!.standings!.entries ?? []).map(parseStandingsEntry)),
    }));

// one conference at a time or all, switched by dropdown (leaderboard pattern)
const requested = Astro.url.searchParams.get("conference");
const conferences = requested
    ? allConferences.filter((c) => c.groupId === requested)
    : allConferences;

// same failure contract as /rankings: never cache the unavailable page
if (allConferences.length > 0) {
    Astro.cache.set({ maxAge: 3600, swr: 7200, tags: ["standings"] });
} else {
    Astro.cache.set(false);
    Astro.response.headers.set("Cache-Control", "no-store");
}

const title = "College Football Standings";
const subtitle = "Conference standings for every FBS league — records, points, and streaks.";
const teamIds = conferences.flatMap((c) => c.rows.map((r) => r.teamId));
---
<GenericPage
    title={title}
    subtitle={subtitle}
    slug="/standings"
    heading={title}
    description={subtitle}
    breadcrumbs={[{ title: 'Home', url: '/', active: false }, { title: 'Standings', active: true }]}
>
    <div class="container my-4">
        <div class="row mb-2">
            <div class="col-12 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h1 class="fs-3 m-0">{title}</h1>
                {allConferences.length > 1 && (
                    <select class="form-select w-auto" aria-label="Switch conference" data-conference-select>
                        <option value="" selected={!requested}>All conferences</option>
                        {allConferences.map((c) => (
                            <option value={c.groupId} selected={c.groupId === requested}>{c.shortName}</option>
                        ))}
                    </select>
                )}
            </div>
        </div>
        {conferences.length === 0 && (
            <p class="text-muted">Standings are unavailable right now. Try again in a few minutes.</p>
        )}
        <div class="row">
            {conferences.map((conf) => (
                <div class={conferences.length > 1 ? "col-lg-6 col-12 mb-4" : "col-lg-8 col-12 mb-4"}>
                    {conferences.length > 1 && (<h2 class="fs-5 mb-2">{conf.name}</h2>)}
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Team</th>
                                    <th class="text-center">Conf</th>
                                    <th class="text-center">Overall</th>
                                    <th class="text-center">PF</th>
                                    <th class="text-center">PA</th>
                                    <th class="text-center">+/-</th>
                                    <th class="text-center">Strk</th>
                                </tr>
                            </thead>
                            <tbody>
                                {conf.rows.map((r) => (
                                    <tr>
                                        <td>
                                            <a href={`/team/${r.teamId}`}><img class={`img-fluid team-logo-${r.teamId} me-2`} width="20px" src={r.logo ?? `https://a.espncdn.com/i/teamlogos/ncaa/500/${r.teamId}.png`} alt={`ESPN team id ${r.teamId} ${cleanField(r, "name")}`} title={r.name} /><span class="visually-hidden">{cleanField(r, "name")}</span><strong><span class="d-none d-sm-inline">{cleanField(r, "name")}</span><span class="d-sm-none">{r.abbreviation ?? cleanField(r, "name")}</span></strong></a>
                                        </td>
                                        <td class="text-center">{r.conference || "—"}</td>
                                        <td class="text-center">{r.overall}</td>
                                        <td class="text-center text-muted">{r.pointsFor}</td>
                                        <td class="text-center text-muted">{r.pointsAgainst}</td>
                                        <td class="text-center text-muted">{r.pointDifferential}</td>
                                        <td class="text-center text-muted">{r.streak}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            ))}
        </div>
        <div class="row">
            <div class="col-12">
                <p class="small text-muted">
                    See also the <a href="/rankings">Top 25 rankings</a>. Standings data from ESPN.
                </p>
            </div>
        </div>
    </div>
    <DarkModeLogos teamIds={teamIds} />
    <script>
        const sel = document.querySelector<HTMLSelectElement>("[data-conference-select]");
        sel?.addEventListener("change", () => {
            window.location.href = sel.value ? `/standings?conference=${sel.value}` : "/standings";
        });
    </script>
</GenericPage>
