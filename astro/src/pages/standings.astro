---
import GenericPage from '../layouts/GenericPage.astro';
import { retrieveConferenceStandings } from '../resources/espn';
import { STANDINGS_CONFERENCES, parseStandingsEntry, sortStandings } from '../utils/standings';

// all conferences in parallel; a failed one simply doesn't render
const results = await Promise.all(STANDINGS_CONFERENCES.map((g) => retrieveConferenceStandings(g)));
const conferences = results
    .filter((c): c is NonNullable<typeof c> => !!c && (c.standings?.entries?.length ?? 0) > 0)
    .map((c) => ({
        name: c.name ?? "Conference",
        rows: sortStandings((c.standings!.entries ?? []).map(parseStandingsEntry)),
    }));

Astro.cache.set({ maxAge: 3600, swr: 7200, tags: ["standings"] });

const title = "College Football Standings";
const subtitle = "Conference standings for every FBS league — records, points, streaks — with links to each team's advanced stats.";
---
<GenericPage
    title={title}
    subtitle={subtitle}
    slug="/standings"
    heading={title}
    description={subtitle}
    breadcrumbs={[{ title: 'Home', url: '/', active: false }, { title: 'Standings', active: true }]}
>
    <div class="container my-4">
        <div class="row">
            <div class="col-12">
                <h1 class="fs-3">College Football Standings</h1>
                {conferences.length === 0 && (
                    <p class="text-muted">Standings are unavailable right now. Try again in a few minutes.</p>
                )}
            </div>
        </div>
        <div class="row">
            {conferences.map((conf) => (
                <div class="col-lg-6 col-12 mb-4">
                    <div class="card border rounded">
                        <div class="card-body py-3">
                            <h2 class="fs-5 mb-2">{conf.name}</h2>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Team</th>
                                            <th class="text-end">Conf</th>
                                            <th class="text-end">Overall</th>
                                            <th class="text-end">PF</th>
                                            <th class="text-end">PA</th>
                                            <th class="text-end">+/-</th>
                                            <th class="text-end">Strk</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {conf.rows.map((r) => (
                                            <tr>
                                                <td>
                                                    <a class="text-decoration-none" href={`/team/${r.teamId}`}>
                                                        <img class={`team-logo-${r.teamId} me-1 align-middle`} width="18" height="18" src={r.logo ?? `https://a.espncdn.com/i/teamlogos/ncaa/500/${r.teamId}.png`} alt="" loading="lazy" />
                                                        {r.name}
                                                    </a>
                                                </td>
                                                <td class="text-end">{r.conference || "—"}</td>
                                                <td class="text-end">{r.overall}</td>
                                                <td class="text-end text-muted">{r.pointsFor}</td>
                                                <td class="text-end text-muted">{r.pointsAgainst}</td>
                                                <td class="text-end text-muted">{r.pointDifferential}</td>
                                                <td class="text-end text-muted">{r.streak}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
        <div class="row">
            <div class="col-12">
                <p class="small text-muted">
                    Every team links to its advanced-stats page. See also the
                    <a href="/rankings">Top 25 rankings</a>. Standings data from ESPN.
                </p>
            </div>
        </div>
    </div>
</GenericPage>
