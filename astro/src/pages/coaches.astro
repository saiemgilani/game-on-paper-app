---
import { prepareCoachIndex } from "../routes/leaderboards";

// /coaches: the careers hub redirects to the default careers board
const r = prepareCoachIndex(Astro, 'cfb');
if ('notFound' in r) {
    return Astro.rewrite("/404");
}
if ('redirect' in r) {
    return Astro.redirect(r.redirect);
}
