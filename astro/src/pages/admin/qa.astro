---
export const prerender = false;

import GenericPage from '../../layouts/GenericPage.astro';
import Panel from '../../layouts/panel/GenericPanel.astro';
import FilterGroup from '../../layouts/FilterGroup.astro';
import { retrieveQaAdmin, type QaRuleRow } from '../../resources/qa';
import { retrieveQaSeason } from '../../resources/sdv';
import { generateColorRampValue, roundNumber } from '../../utils/misc';
import { CURRENT_YEAR } from '../../utils/constants';
import type { League } from '../../utils/league';

// Admin only. The middleware already redirects an unauthenticated /admin/*
// request, so this is the second lock on the same door: a render path that
// reaches here without a session must produce nothing, not a page.
if (Astro.locals.adminAuthed !== true) {
    return Astro.redirect('/admin/login', 302);
}

const WINDOWS = [1, 7, 14, 30];
const requested = Number(Astro.url.searchParams.get('days'));
const days = WINDOWS.includes(requested) ? requested : 7;
const season = Number(Astro.url.searchParams.get('season')) || CURRENT_YEAR;
const league: League = Astro.locals.league ?? 'cfb';

const [qa, seasonRows] = await Promise.all([
    retrieveQaAdmin(days),
    retrieveQaSeason(season, league),
]);

// The rule histogram is a matrix: one row per rule, one column per day.
const ruleDays = [...new Set(qa.rules.map((r) => String(r.day).slice(0, 10)))].sort();
const byRule = new Map<string, Map<string, QaRuleRow>>();
for (const row of qa.rules) {
    const day = String(row.day).slice(0, 10);
    if (!byRule.has(row.rule)) byRule.set(row.rule, new Map());
    byRule.get(row.rule)!.set(day, row);
}
const ruleTotals = [...byRule.entries()]
    .map(([rule, cells]) => ({
        rule,
        cells,
        total: [...cells.values()].reduce((a, c) => a + c.n, 0),
        games: [...cells.values()].reduce((a, c) => a + c.games, 0),
    }))
    .sort((a, b) => b.total - a.total);
// The rule matrix shades relative to its own worst cell, which is what a
// histogram is for. The error counts do NOT: a scale that moved with the worst
// row would make the same colour mean a different thing on every load, so they
// shade against a fixed five.
const worstCell = Math.max(1, ...qa.rules.map((r) => r.n));
const ERROR_SCALE = 5;

const clean = qa.totals.checks ? 100 * (qa.totals.clean ?? 0) / qa.totals.checks : null;
const statusText = (s: string | null) =>
    (s ?? '').replace('STATUS_', '').replaceAll('_', ' ').toLowerCase() || 'unknown';
const ago = (seconds: number) =>
    seconds < 90 ? `${Math.round(seconds)}s` : seconds < 5400 ? `${Math.round(seconds / 60)}m` : `${Math.round(seconds / 3600)}h`;
const windowHref = (d: number) => `/admin/qa?days=${d}&season=${season}`;

const title = 'Validation | Game on Paper';
const subtitle = 'Validation findings by game and by rule';
---
<GenericPage title={title} subtitle={subtitle} slug="admin/qa" breadcrumbs={[
    { title: "Home", url: "/", active: false },
    { title: "Admin", url: "/admin", active: false },
    { title: "Validation", active: true },
]}>
<div class="container pb-5">
    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
        <h2 class="mb-0">Validation</h2>
        <span class="badge text-bg-danger text-uppercase">ops</span>
        <a class="btn btn-sm btn-outline-secondary ms-2" href="/admin">Back to admin</a>
    </div>
    <FilterGroup label="Choose the window these counts cover">
        <Fragment slot="filter-body">
            {WINDOWS.map((d) => (
                <a class={`btn btn-sm btn-outline-secondary ${d === days ? 'active' : ''}`}
                   aria-pressed={d === days} href={windowHref(d)}>{d}d</a>
            ))}
        </Fragment>
    </FilterGroup>

    <p class="text-small text-muted mt-2 mb-3">
        {qa.ok
            ? `${qa.totals.checks ?? 0} checks on ${qa.totals.games ?? 0} games, ${clean === null ? '—' : roundNumber(clean, 1, 1)}% clean, ${qa.totals.fallbacks ?? 0} served by a fallback source.`
            : 'The telemetry store did not answer. These tables are empty because the query failed, not because nothing was found.'}
    </p>

    <Panel id="qa-games" title="Games" show={true} class="mb-md-3">
        <p slot="panel-subtitle" class="text-small text-muted mb-0">
            Last verdict per game seen in the past 24 hours: one row per game, from its most recent render.
        </p>
        <div slot="panel-body" class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th class="box-heading">Game</th>
                        <th style="text-align: center;">Status</th>
                        <th style="text-align: center;">Source</th>
                        <th style="text-align: center;">Errors</th>
                        <th style="text-align: center;">Warnings</th>
                        <th style="text-align: center;">Rules</th>
                        <th style="text-align: center;">Last poll</th>
                    </tr>
                </thead>
                <tbody>
                    {qa.games.map((row) => (
                        <tr>
                            <td style="text-align: left;" class="text-nowrap">
                                <a href={`/game/${row.game_id}`}>{row.matchup ?? row.game_id}</a>
                            </td>
                            <td style="text-align: center;">{statusText(row.status)}</td>
                            <td style="text-align: center;">
                                {row.qa_source ?? '—'}{row.qa_fallback ? ' (fallback)' : ''}
                            </td>
                            <td class={`numeral ${(row.qa_errors === null ? null : generateColorRampValue(Math.min(row.qa_errors, ERROR_SCALE), ERROR_SCALE, true)) ?? ''}`}
                                style="text-align: center;">
                                {row.qa_errors === null ? '—' : row.qa_errors}
                            </td>
                            <td class="numeral" style="text-align: center;">
                                {row.qa_warnings === null ? '—' : row.qa_warnings}
                            </td>
                            <td class="text-small text-muted" style="text-align: center;">
                                {(row.qa_rules ?? []).join(', ') || '—'}
                            </td>
                            <td class="numeral" style="text-align: center;">{ago(row.age_s)}</td>
                        </tr>
                    ))}
                    {qa.games.length === 0 && (
                        <tr><td colspan="7" class="text-muted" style="text-align: left;">
                            {qa.ok ? 'No game has been checked in the past 24 hours.' : 'No data.'}
                        </td></tr>
                    )}
                </tbody>
            </table>
        </div>
    </Panel>

    <Panel id="qa-rules" title="Findings by rule" show={true} class="mb-md-3">
        <p slot="panel-subtitle" class="text-small text-muted mb-0">
            Every rule that fired in the window, by day. A gate rule is named for the invariant it
            checks; a live rule starts with "live".
        </p>
        <div slot="panel-body" class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th class="box-heading">Rule</th>
                        {ruleDays.map((day) => <th style="text-align: center;">{day.slice(5)}</th>)}
                        <th style="text-align: center;">Total</th>
                        <th style="text-align: center;">Games</th>
                    </tr>
                </thead>
                <tbody>
                    {ruleTotals.map((row) => (
                        <tr>
                            <td style="text-align: left;" class="text-nowrap">{row.rule}</td>
                            {ruleDays.map((day) => (
                                <td class={`numeral ${(row.cells.has(day) ? generateColorRampValue(row.cells.get(day)!.n, worstCell, true) : null) ?? ''}`}
                                    style="text-align: center;">
                                    {row.cells.get(day)?.n ?? ''}
                                </td>
                            ))}
                            <td class="numeral" style="text-align: center;">{row.total}</td>
                            <td class="numeral" style="text-align: center;">{row.games}</td>
                        </tr>
                    ))}
                    {ruleTotals.length === 0 && (
                        <tr><td colspan={ruleDays.length + 3} class="text-muted" style="text-align: left;">
                            {qa.ok ? 'No rule fired in this window.' : 'No data.'}
                        </td></tr>
                    )}
                </tbody>
            </table>
        </div>
    </Panel>

    <Panel id="qa-season" title={`Season ${season}`} show={true} class="mb-md-3">
        <p slot="panel-subtitle" class="text-small text-muted mb-0">
            Published per-game verdicts for the whole season, from the release builds.
        </p>
        <div slot="panel-body">
            {seasonRows.length === 0 ? (
                <p class="text-muted mb-0">
                    Not published yet: the season view fills in when the release builds publish their
                    QA asset. Until then the tables above are the only record, and they only cover
                    games the site rendered.
                </p>
            ) : (
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th class="box-heading">Game</th>
                                <th style="text-align: center;">Source</th>
                                <th style="text-align: center;">Version</th>
                                <th style="text-align: center;">Errors</th>
                                <th style="text-align: center;">Warnings</th>
                                <th style="text-align: center;">Rules</th>
                            </tr>
                        </thead>
                        <tbody>
                            {seasonRows.map((row) => (
                                <tr>
                                    <td style="text-align: left;" class="text-nowrap">
                                        <a href={`/game/${row.game_id}`}>{row.game_id}</a>
                                    </td>
                                    <td style="text-align: center;">{row.source}</td>
                                    <td style="text-align: center;">{row.processing_version}</td>
                                    <td class={`numeral ${generateColorRampValue(row.n_errors, 5, true) ?? ''}`}
                                        style="text-align: center;">{row.n_errors}</td>
                                    <td class="numeral" style="text-align: center;">{row.n_warnings}</td>
                                    <td class="text-small text-muted" style="text-align: center;">
                                        {(row.failed_rule_ids ?? []).join(', ') || '—'}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )}
        </div>
    </Panel>
</div>
</GenericPage>
