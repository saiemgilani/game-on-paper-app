---
import GenericPage from '../layouts/GenericPage.astro';
import { faqPageJsonLd, type FaqEntry } from '../utils/seo';

export const prerender = true;

const canonicalUrl = new URL('/data-sources', 'https://gameonpaper.com').href;
---
<GenericPage
    title="Data & Sources"
    subtitle="Data souces, freshness, and limitations"
    slug="/data-sources"
    heading="Game on Paper data and sources"
    description="Data souces, freshness, and limitations"
    breadcrumbs={[{ title: 'Home', url: '/', active: false }, { title: 'Data & Sources', active: true }]}
>
    <div class="container my-4">
        <div class="row">
            <div class="col-lg-8 col-12">
                <h1 class="fs-3">Data &amp; Sources</h1>
                <p class="text-muted">
                    Everything on Game on Paper is computed from public data. If you see a data issue/inaccuracy, please open an issue on <a href="https://github.com/saiemgilani/game-on-paper-app/issues/new">GitHub</a> or reach out via <a href="https://bsky.app/profile/gameonpaper.com">Bluesky</a>. Feed-quality reports with a game link are the fastest to act on.
                </p>

                <h2 class="fs-4 mt-4">Sources</h2>
                <ul>
                    <li>
                        <strong>Play-by-play, box scores, schedules, game context</strong>:
                        <a href="https://espn.com/college-football">ESPN</a>'s public college football feeds (plays, drives, linescores, venue, broadcasts, betting lines).
                    </li>
                    <li>
                        <strong>Season-level team metrics and history</strong>:
                        <a href="https://www.sportsdataverse.org">SportsDataverse</a> open data, which also powers season-level percentiles and team/player leaderboards.
                    </li>
                    <li>
                        <strong>Community data</strong>:
                        <a href="https://collegefootballdata.com">collegefootballdata.com</a> completes some of our historic datasets.
                    </li>
                </ul>

                <h2 class="fs-4 mt-4">Freshness</h2>
                <ul>
                    <li><strong>Live games and the scoreboard</strong>: refresh every minute while you have the page open and visible.</li>
                    <li><strong>Completed games</strong>: cached after the game goes final. We will occasionally update these pages if ESPN cleans the play-by-play data upstream or if we have new metrics to display.</li>
                    <li><strong>Season metrics and percentiles</strong>: updated as the underlying SportsDataverse datasets refresh, typically within a day of games completing.</li>
                </ul>

                <h2 class="fs-4 mt-4">Known limitations</h2>
                <ul>
                    <li>Upstream play feeds occasionally drop, mislabel, or retroactively correct plays. Pages pick up corrections on their next refresh.</li>
                    <li>Some box score values are estimated from play text when the feed doesn't carry them directly.</li>
                    <li>Other than Adjusted EPA/Play, metrics are not adjusted for opponent quality or garbage time.</li>
                    <li>Early-season sample sizes are small and so metrics at those stages are not quite reliable as performance evaluation tools. As more games are played, these metrics will stabilize.</li>
                </ul>
            </div>
        </div>
    </div>
</GenericPage>
