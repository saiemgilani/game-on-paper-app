---
// src/pages/wbb/leaderboards.astro
import BasketballLeaderboardsRoute from '../../components/routes/BasketballLeaderboardsRoute.astro';
import { prepareLeaderboards } from '../../routes/basketball/leaderboards';
import { isFeatureEnabled } from '../../utils/features';

if (!isFeatureEnabled('bball-leaderboards-v2', Astro.locals)) {
    return Astro.rewrite('/404');
}
const r = await prepareLeaderboards(Astro, 'wbb');
---

<BasketballLeaderboardsRoute data={r} />
