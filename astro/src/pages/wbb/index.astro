---
// /wbb: BASKETBALL.wbb.landing is 'teams-index' (spec §3.4, D30): every program of the season by conference (D38) with its
// shooting line, plus links to the scoreboard and the other shooting pages. /wbb/teams is the same list under the Header's Teams.
import NbaTeamsRoute from '../../components/routes/NbaTeamsRoute.astro';
import { prepareBasketballTeams } from '../../routes/basketball/teams';
import { unavailable } from '../../routes/basketball/cache';

const r = await prepareBasketballTeams(Astro, 'wbb', { landing: true });
if ('unavailable' in r) {
    return unavailable('wbb');
}
---

<NbaTeamsRoute data={r} landing />
