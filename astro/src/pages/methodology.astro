---
import GenericPage from '../layouts/GenericPage.astro';
import { faqPageJsonLd, type FaqEntry } from '../utils/seo';

export const prerender = true;

const faqs: FaqEntry[] = [
    {
        question: "Are the stats adjusted for opponent or garbage time?",
        answer: "Only Adjusted EPA/Play is opponent-adjusted; it accounts for home-field advantage, quality of opponent, and garbage time, and only considers FBS vs FBS games. Every other metric on the site is unadjusted.",
    },
    {
        question: "Why do numbers here differ from ESPN's box score?",
        answer: "Play-by-play feeds are imperfect: plays are occasionally missing, mislabeled, or corrected after the fact. Some box score values are estimated from the play text when the feed doesn't carry them. Large disagreements usually trace to feed quality, and we surface known issues rather than silently patching them.",
    },
];

const canonicalUrl = new URL('/methodology', 'https://gameonpaper.com').href;
---
<GenericPage
    title="Methodology"
    subtitle="How Game on Paper computes EPA, win probability, success rate, and its other advanced stats."
    slug="/methodology"
    heading="Game on Paper methodology"
    description="How Game on Paper computes EPA, win probability, success rate, adjusted EPA, and 4th-down recommendations for college football."
    breadcrumbs={[{ title: 'Home', url: '/', active: false }, { title: 'Methodology', active: true }]}
    jsonLd={[faqPageJsonLd(faqs, canonicalUrl)]}
>
    <div class="container my-4">
        <div class="row">
            <div class="col-lg-8 col-12">
                <h1 class="fs-3">Methodology</h1>
                <p class="text-muted">
                    Game on Paper grades every college football play with expected points and win
                    probability models, then aggregates those grades into the team and player views
                    on each game page. This page explains what each number means and how it's built.
                    Definitions for individual stats live in the <a href="/glossary">glossary</a>.
                </p>

                <h2 class="fs-4 mt-4">Expected points and EPA</h2>
                <p>
                    Every situation — down, distance, and field position — carries an expected point
                    value: the average of the next scoring outcomes from that spot. <strong>EPA
                    (Expected Points Added)</strong> is how much a play moved that value. Gains that
                    keep drives alive grade well; a 3-yard gain on 3rd-and-2 beats a 6-yard gain on
                    3rd-and-10.
                </p>

                <h2 class="fs-4 mt-4">Win probability</h2>
                <p>
                    The win probability model estimates each team's chance of winning before every
                    snap from the score, clock, field position, down and distance, timeouts, and the
                    pregame point spread. <strong>WPA (Win Probability Added)</strong> is the change
                    a single play caused — the currency behind the "Most Important Plays" panel and
                    the win probability chart on every game page.
                </p>

                <h2 class="fs-4 mt-4">Success rate and explosiveness</h2>
                <p>
                    A play is a <strong>success</strong> when its EPA is positive. Success rate
                    measures consistency; <strong>explosiveness</strong> (EPA on explosive plays)
                    measures the big-play dimension. Teams can win either fight independently, which
                    is why both appear side by side in the team stats.
                </p>

                <h2 class="fs-4 mt-4">Adjusted EPA/Play</h2>
                <p>
                    Season-level <strong>Adj EPA/Play</strong> adjusts for home-field advantage,
                    quality of opponent, and garbage time, considering only FBS vs FBS games. The
                    approach is adapted from
                    <a href="https://makennnahack.github.io/makenna-hack.github.io/publications/opp_adj_rank_project/">Makenna Hack's opponent-adjustment work</a>
                    and <a href="https://blog.collegefootballdata.com/opponent-adjusted-stats-ridge-regression/">Bud Davis's ridge-regression article</a>.
                    Early in a season, adjusted and raw numbers can differ significantly until teams
                    have played multiple FBS opponents. <strong>No other metric on the site is
                    opponent-adjusted.</strong>
                </p>

                <h2 class="fs-4 mt-4">4th-down and 2-point decisions</h2>
                <p>
                    Decision cards on eligible plays compare the win probability of each choice —
                    go, field goal, punt (or 2-point vs kick) — using conversion and make
                    probabilities for the situation. The recommendation is simply the
                    highest-win-probability choice, shown against what the coach actually did.
                </p>

                <h2 class="fs-4 mt-4">Windows and splits</h2>
                <p>
                    Quarter and half views recompute the play-derived tables over just that window's
                    plays — the same models, filtered — so a second-half collapse or a first-half
                    blitz reads directly from the numbers.
                </p>

                <h2 class="fs-4 mt-4">Frequently asked questions</h2>
                {faqs.map((f) => (
                    <details class="mb-2">
                        <summary class="fw-bold">{f.question}</summary>
                        <p class="mt-2 text-muted" set:html={f.answer} />
                    </details>
                ))}

                <p class="text-muted small mt-4">
                    Where the data comes from, and how fresh it is, lives on <a href="/data-sources">Data &amp; Sources</a>.
                </p>
            </div>
        </div>
    </div>
</GenericPage>
