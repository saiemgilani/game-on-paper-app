SDV_AUTH_TOKEN=
PYTHON_HTTP_TOKEN=test-token
PYTHON_HTTP_URL=http://localhost:8080

# GOP telemetry + admin (copy to astro/.env for local dev; NEVER commit real values)
GOP_INGEST_KEY=devkey
ADMIN_USER=admin
ADMIN_PASS=CHANGEME
TELEMETRY_ENABLED=1

# 'feedback-inbox': the #gop-inbox forum's Discord webhook (Server Settings > Integrations >
# Webhooks, channel #gop-inbox). Unset = the admin Feedback button says it isn't configured
# and POST /admin/api/feedback answers 503. Production: `npx wrangler secret put
# DISCORD_INBOX_WEBHOOK_URL`. A wrangler dev/preview run reads astro/.dev.vars, same KEY=value line.
DISCORD_INBOX_WEBHOOK_URL=
